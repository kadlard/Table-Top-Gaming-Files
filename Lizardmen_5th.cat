                <infoLink id="7f9a-ec23-7cc0-43dd" name="Wizards and armour" targetId="2464-78f1-754b-15cb" type="rule" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="7–8, 36" />
              </infoLinks>
              <rules>
                <rule id="156d-f378-603f-3b42" name="Included equipment" hidden="false">
                  <description>Hand weapon.</description>
                </rule>
                <rule id="68b9-b8a3-6090-30b2" name="Wizard level and spells" hidden="false">
                  <description>Magic level 2; 2 spell cards before bloodline/item changes. Those changes, including Forbidden Lore and Nehekhara’s Noble Blood, are applied manually. Normal armour casting restrictions apply unless a specific power overrides them.</description>
                </rule>
              </rules>
              <categoryLinks>
                <categoryLink id="be45-823c-8dc6-ae03" name="Characters" targetId="0114-02b1-a20d-82f1" primary="true" hidden="false" />
              </categoryLinks>
              <selectionEntryGroups>
                <selectionEntryGroup id="dfdb-5742-4c28-3e46" name="Magic lore" hidden="false" collective="false" import="true" defaultSelectionEntryId="7982-258d-d72f-0fb8">
                  <constraints>
                    <constraint id="331a-e75a-54fb-f655" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                    <constraint id="00c7-9aaa-1440-d160" type="min" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                  </constraints>
                  <selectionEntries>
                    <selectionEntry id="7982-258d-d72f-0fb8" name="Battle Magic" type="upgrade" hidden="false" collective="false" import="true">
                      <costs>
                        <cost name="pts" typeId="0044-15f1-782b-00ea" value="0" />
                      </costs>
                      <constraints>
                        <constraint id="ab18-8c3b-11ac-ae45" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                      </constraints>
                      <profiles>
                        <profile id="2259-49fb-4b95-334e" name="Fireball" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="26">
                          <characteristics>
                            <characteristic name="Lore" typeId="d783-9c87-2677-5247">Battle Magic</characteristic>
                            <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">1</characteristic>
                            <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">24 inches</characteristic>
                            <characteristic name="Effect" typeId="d107-f119-4175-3647">Launch one fireball per magic level. Each strikes the first model in its path for one S4 hit, without armour saves. Line of sight required.</characteristic>
                            <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                            <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 26</characteristic>
                            <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                          </characteristics>
                        </profile>
                        <profile id="d335-b50b-9294-a91d" name="Destruction" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="26">
                          <characteristics>
                            <characteristic name="Lore" typeId="d783-9c87-2677-5247">Battle Magic</characteristic>
                            <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">2+</characteristic>
                            <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">18 inches</characteristic>
                            <characteristic name="Effect" typeId="d107-f119-4175-3647">An enemy unit suffers 2D6 S4 hits, without armour saves. The summary prints Power 2+ but does not explain the additional-power procedure; use the spell card for that detail.</characteristic>
                            <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                            <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 26</characteristic>
                            <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary only card detail required</characteristic>
                          </characteristics>
                        </profile>
                        <profile id="ebf5-8a59-3266-1953" name="Fear" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="26">
                          <characteristics>
                            <characteristic name="Lore" typeId="d783-9c87-2677-5247">Battle Magic</characteristic>
                            <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">2</characteristic>
                            <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">24 inches</characteristic>
                            <characteristic name="Effect" typeId="d107-f119-4175-3647">The targeted enemy unit immediately takes a Fear test and flees if it fails.</characteristic>
                            <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                            <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 26</characteristic>
                            <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                          </characteristics>
                        </profile>
                        <profile id="0290-7c52-4a22-588a" name="Blast" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="26">
                          <characteristics>
                            <characteristic name="Lore" typeId="d783-9c87-2677-5247">Battle Magic</characteristic>
                            <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">2</characteristic>
                            <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">24 inches</characteristic>
                            <characteristic name="Effect" typeId="d107-f119-4175-3647">The first enemy model in the path suffers either D6 S5 hits or D3 S10 hits, with no armour saves. The summary does not reproduce a Line of Sight label; check the original card for its targeting instructions.</characteristic>
                            <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                            <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 26</characteristic>
                            <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary only card detail required</characteristic>
                          </characteristics>
                        </profile>
                        <profile id="a48c-408f-d3d2-f1f0" name="Shield" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="27">
                          <characteristics>
                            <characteristic name="Lore" typeId="d783-9c87-2677-5247">Battle Magic</characteristic>
                            <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">2</characteristic>
                            <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">18 inches</characteristic>
                            <characteristic name="Effect" typeId="d107-f119-4175-3647">A friendly unit gains a magical shield: before enemy shots roll to hit, roll for each shot; on 4+ it is stopped.</characteristic>
                            <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Remains in play</characteristic>
                            <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 27</characteristic>
                            <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                          </characteristics>
                        </profile>
                        <profile id="9412-7876-e412-e609" name="Heal" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="27">
                          <characteristics>
                            <characteristic name="Lore" typeId="d783-9c87-2677-5247">Battle Magic</characteristic>
                            <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">1</characteristic>
                            <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">12 inches</characteristic>
                            <characteristic name="Effect" typeId="d107-f119-4175-3647">The wizard or one friendly model within range recovers one lost wound.</characteristic>
                            <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                            <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 27</characteristic>
                            <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                          </characteristics>
                        </profile>
                        <profile id="2d76-c868-4507-a4a5" name="Hold Fast" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="27">
                          <characteristics>
                            <characteristic name="Lore" typeId="d783-9c87-2677-5247">Battle Magic</characteristic>
                            <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">3</characteristic>
                            <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">24 inches</characteristic>
                            <characteristic name="Effect" typeId="d107-f119-4175-3647">An enemy unit can do nothing while the spell lasts.</characteristic>
                            <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Remains in play</characteristic>
                            <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 27</characteristic>
                            <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                          </characteristics>
                        </profile>
                        <profile id="6059-32cb-c4bf-ad7b" name="Teleport Self" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="27">
                          <characteristics>
                            <characteristic name="Lore" typeId="d783-9c87-2677-5247">Battle Magic</characteristic>
                            <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">1</characteristic>
                            <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">Self</characteristic>
                            <characteristic name="Effect" typeId="d107-f119-4175-3647">Transport the wizard anywhere on the battlefield. Arrival in combat counts as charging.</characteristic>
                            <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                            <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 27</characteristic>
                            <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                          </characteristics>
                        </profile>
                        <profile id="433b-2f23-b1ae-0bcc" name="Curse" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="27">
                          <characteristics>
                            <characteristic name="Lore" typeId="d783-9c87-2677-5247">Battle Magic</characteristic>
                            <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">2</characteristic>
                            <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">24 inches</characteristic>
                            <characteristic name="Effect" typeId="d107-f119-4175-3647">An enemy unit suffers -1 to shooting and close-combat hit rolls.</characteristic>
                            <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Remains in play</characteristic>
                            <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 27</characteristic>
                            <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                          </characteristics>
                        </profile>
                        <profile id="6eb9-8797-d127-052b" name="Net" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="27">
                          <characteristics>
                            <characteristic name="Lore" typeId="d783-9c87-2677-5247">Battle Magic</characteristic>
                            <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">2</characteristic>
                            <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">12 inches</characteristic>
                            <characteristic name="Effect" typeId="d107-f119-4175-3647">An enemy unit can do nothing while entangled.</characteristic>
                            <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Remains in play</characteristic>
                            <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 27</characteristic>
                            <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                          </characteristics>
                        </profile>
                        <profile id="95cc-27c9-0c84-45e5" name="Move Unit" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="27">
                          <characteristics>
                            <characteristic name="Lore" typeId="d783-9c87-2677-5247">Battle Magic</characteristic>
                            <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">2</characteristic>
                            <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">18 inches</characteristic>
                            <characteristic name="Effect" typeId="d107-f119-4175-3647">Transport the wizard and a friendly unit up to 18 inches across the battlefield. Moving into combat counts as charging in its first round.</characteristic>
                            <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                            <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 27</characteristic>
                            <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                          </characteristics>
                        </profile>
                        <profile id="5329-74f6-39d6-a88b" name="Bless" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="27">
                          <characteristics>
                            <characteristic name="Lore" typeId="d783-9c87-2677-5247">Battle Magic</characteristic>
                            <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">2</characteristic>
                            <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">24 inches</characteristic>
                            <characteristic name="Effect" typeId="d107-f119-4175-3647">A friendly unit gains +1 to shooting and close-combat hit rolls.</characteristic>
                            <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Remains in play</characteristic>
                            <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 27</characteristic>
                            <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                          </characteristics>
                        </profile>
                        <profile id="925f-a271-70bf-6e17" name="Protect" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="27">
                          <characteristics>
                            <characteristic name="Lore" typeId="d783-9c87-2677-5247">Battle Magic</characteristic>
                            <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">3</characteristic>
                            <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">24 inches</characteristic>
                            <characteristic name="Effect" typeId="d107-f119-4175-3647">A friendly unit gains a 4+ special save against each wound.</characteristic>
                            <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Remains in play</characteristic>
                            <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 27</characteristic>
                            <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                          </characteristics>
                        </profile>
                      </profiles>
                      <rules>
                        <rule id="1669-6ae2-cead-4b6b" name="Spell deck reference" hidden="false">
                          <description>Entire reference deck, not spells known. Draw/choose the permitted number before battle; record them in roster notes. Necromancy uses chosen spells and High Magic its special dealing rules.</description>
                        </rule>
                      </rules>
                    </selectionEntry>
                    <selectionEntry id="c1f3-a908-40f3-c3a2" name="High Magic" type="upgrade" hidden="false" collective="false" import="true">
                      <costs>
                        <cost name="pts" typeId="0044-15f1-782b-00ea" value="0" />
                      </costs>
                      <constraints>
                        <constraint id="9f8a-06cb-7ef5-e857" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                      </constraints>
                      <infoLinks>
                        <infoLink id="d1db-34c5-bff6-c8ee" name="High Magic: spell draw and superiority" targetId="2ff6-b313-7160-82e9" type="rule" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="18" />
                      </infoLinks>
                      <profiles>
                        <profile id="004f-5ca3-2e3e-3a97" name="Coruscation of Finreir" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="23">
                          <characteristics>
                            <characteristic name="Lore" typeId="d783-9c87-2677-5247">High Magic</characteristic>
                            <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">1</characteristic>
                            <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">Self</characteristic>
                            <characteristic name="Effect" typeId="d107-f119-4175-3647">The Mage rises on a pillar, sees across the battlefield and casts spells without range reduction. Only flying models can shoot him or attack him in close combat. He gains a 2+ armour save and may fly 24 inches. If dispelled, he descends safely.</characteristic>
                            <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Remains in play</characteristic>
                            <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 23</characteristic>
                            <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                          </characteristics>
                        </profile>
                        <profile id="6de1-cc9c-255b-de68" name="Deadlock" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="23">
                          <characteristics>
                            <characteristic name="Lore" typeId="d783-9c87-2677-5247">High Magic</characteristic>
                            <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">1</characteristic>
                            <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">12 inches</characteristic>
                            <characteristic name="Effect" typeId="d107-f119-4175-3647">Nullify one enemy-held magic item within range. The Mage may release it and deadlock another as described by the spell.</characteristic>
                            <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Remains in play</characteristic>
                            <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 23</characteristic>
                            <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                          </characteristics>
                        </profile>
                        <profile id="cd7a-c33b-45f9-6a34" name="Banishment" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="23">
                          <characteristics>
                            <characteristic name="Lore" typeId="d783-9c87-2677-5247">High Magic</characteristic>
                            <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">2</characteristic>
                            <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">12 inches</characteristic>
                            <characteristic name="Effect" typeId="d107-f119-4175-3647">Each Undead or Daemon model within range suffers D6 wounds on 4+. Dark, Necromantic and Chaos spells in play within range are dispelled on 4+. Characters test individually and cannot use Look Out, Sir!</characteristic>
                            <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                            <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 23</characteristic>
                            <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                          </characteristics>
                        </profile>
                        <profile id="e64a-b0ee-8571-7746" name="Glamour of Teclis" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="23">
                          <characteristics>
                            <characteristic name="Lore" typeId="d783-9c87-2677-5247">High Magic</characteristic>
                            <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">1</characteristic>
                            <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">36 inches</characteristic>
                            <characteristic name="Effect" typeId="d107-f119-4175-3647">Each time the targeted unit wishes to move it must pass Leadership. On failure the Mage may move it instead.</characteristic>
                            <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Remains in play</characteristic>
                            <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 23</characteristic>
                            <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                          </characteristics>
                        </profile>
                        <profile id="a99a-a5ea-d088-01ce" name="Assault of Stone" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="24">
                          <characteristics>
                            <characteristic name="Lore" typeId="d783-9c87-2677-5247">High Magic</characteristic>
                            <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">3</characteristic>
                            <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">24 inches</characteristic>
                            <characteristic name="Effect" typeId="d107-f119-4175-3647">Move a hill within range up to D6 inches. Individual models touched must roll below Initiative on D6 or suffer D3 wounds; units suffer 2D6 wounds automatically. No armour saves.</characteristic>
                            <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                            <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 24</characteristic>
                            <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                          </characteristics>
                        </profile>
                        <profile id="abc3-d721-e725-e9a5" name="Drain Magic" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="24">
                          <characteristics>
                            <characteristic name="Lore" typeId="d783-9c87-2677-5247">High Magic</characteristic>
                            <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">3</characteristic>
                            <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">Battlefield</characteristic>
                            <characteristic name="Effect" typeId="d107-f119-4175-3647">Dispel all current spells, discard both hands of magic cards and end the phase. Each wizard rolls 2D6: on 4+ it loses one magic level; a High Magic Mage loses a level only on 6+. This spell cannot be dispelled.</characteristic>
                            <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                            <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 24</characteristic>
                            <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                          </characteristics>
                        </profile>
                        <profile id="ec5b-376a-9cb2-2341" name="Apotheosis" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="24">
                          <characteristics>
                            <characteristic name="Lore" typeId="d783-9c87-2677-5247">High Magic</characteristic>
                            <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">1</characteristic>
                            <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">6 inches</characteristic>
                            <characteristic name="Effect" typeId="d107-f119-4175-3647">Return a slain friendly model to life within 6 inches of the Mage, with its items, armour, equipment and ordinary steed, but not a monster mount. The returned model causes Fear.</characteristic>
                            <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Remains in play</characteristic>
                            <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 24</characteristic>
                            <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                          </characteristics>
                        </profile>
                        <profile id="1f23-c142-51c0-ab4f" name="Fiery Convocation" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="24">
                          <characteristics>
                            <characteristic name="Lore" typeId="d783-9c87-2677-5247">High Magic</characteristic>
                            <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">2</characteristic>
                            <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">24 inches</characteristic>
                            <characteristic name="Effect" typeId="d107-f119-4175-3647">An enemy unit immediately takes 2D6 S4 hits. In every subsequent magic phase it takes 2D6 hits at a Strength one higher than before.</characteristic>
                            <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Remains in play</characteristic>
                            <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 24</characteristic>
                            <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                          </characteristics>
                        </profile>
                        <profile id="1278-617d-c0a6-ed42" name="The Tempest" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="24">
                          <characteristics>
                            <characteristic name="Lore" typeId="d783-9c87-2677-5247">High Magic</characteristic>
                            <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">3</characteristic>
                            <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">48-inch radius</characteristic>
                            <characteristic name="Effect" typeId="d107-f119-4175-3647">Enemy units in range must pass Leadership before moving. Flying is prevented and flyers are grounded. All missile fire suffers -2 to hit. War engines and buildings suffer D6 S7 hits each magic phase it lasts.</characteristic>
                            <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Remains in play</characteristic>
                            <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 24</characteristic>
                            <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                          </characteristics>
                        </profile>
                        <profile id="41da-6a73-0afd-dbac" name="Hand of Glory" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="24">
                          <characteristics>
                            <characteristic name="Lore" typeId="d783-9c87-2677-5247">High Magic</characteristic>
                            <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">2</characteristic>
                            <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">12-inch radius</characteristic>
                            <characteristic name="Effect" typeId="d107-f119-4175-3647">Friendly units in range automatically pass Leadership tests; fleeing friendly units there rally immediately.</characteristic>
                            <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                            <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 24</characteristic>
                            <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                          </characteristics>
                        </profile>
                      </profiles>
