        <rule id="7a83-77a3-a824-ae1d" name="Included equipment" hidden="false">
          <description>Four Skinks with hand weapons, spears, short bows, javelins, poisoned missiles and shields.</description>
        </rule>
        <rule id="66cf-289e-04b7-a282" name="Army-list note" hidden="false">
          <description>The printed entry has no upper limit for extra crew; agree a modelled howdah capacity. Skink character riders are bought separately. A crew champion can be selected below; it replaces one included crewman.</description>
        </rule>
        <rule id="3a22-c92e-1c36-29c3" name="Selection allowance" hidden="false">
          <description>1 per Saurus Temple Guards, Saurus Warriors, Skink Warriors, Cold One Riders unit/character. Count combined qualifying choices.</description>
        </rule>
      </rules>
