        <profile id="7362-c6fd-beed-0d0b" name="Xltzhpctli, Horned One" typeId="e25d-f63f-8d67-4bda" typeName="Unit" hidden="false" publicationId="7839-e5ae-5fb9-1604" page="84–85">
          <characteristics>
            <characteristic name="M" typeId="df0b-cf43-1955-6845">8</characteristic>
            <characteristic name="WS" typeId="c83c-b081-d246-d5ef">4</characteristic>
            <characteristic name="BS" typeId="960a-0c90-a448-96b4">0</characteristic>
            <characteristic name="S" typeId="639b-d234-7e46-084b">4</characteristic>
            <characteristic name="T" typeId="6a8e-5ca4-9d4e-d596">4</characteristic>
            <characteristic name="W" typeId="8a8d-ce29-476c-e0fa">1</characteristic>
            <characteristic name="I" typeId="946e-86c4-ffce-c3ed">1</characteristic>
            <characteristic name="A" typeId="4cc5-d3f5-26a7-37c2">3</characteristic>
            <characteristic name="Ld" typeId="cedc-6339-9f57-49bd">3</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <constraints>
        <constraint id="bce9-5524-a42d-b102" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
        <constraint id="088f-5393-1110-c7a3" type="max" value="1" scope="roster" field="selections" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" />
      </constraints>
      <rules>
        <rule id="b764-c9d2-ca47-0dc5" name="Special character" hidden="false">
          <description>Unique named selection. 85 points includes the complete listed fixed equipment, companions, powers and mounts; only separately offered options add points. Printed profiles are before magic-item bonuses unless a rule says they are already included. Special-character use requires the players’ agreement under the books’ convention.</description>
        </rule>
        <rule id="feb4-4b2a-61c5-7367" name="Included equipment" hidden="false">
          <description>Hand weapon; spear; poisoned darts; light armour; shield; Horned One.</description>
        </rule>
        <rule id="1f5c-3eed-0440-78cb" name="Scaly skin" hidden="false" publicationId="7839-e5ae-5fb9-1604" page="84–85">
          <description>2+ armour save; Strength modifiers cannot worsen it beyond 6+. Reference: Lizardmen, printed p. 84–85.</description>
        </rule>
        <rule id="96fb-45c4-99ca-1021" name="Hail of Darts" hidden="false" publicationId="7839-e5ae-5fb9-1604" page="84–85">
          <description>Only when charging or charged: one dart per complete 4 inches of charge distance (16 inches for flyers descending from high). Range 16 inches, no long-range penalty; use BS, poison wounds on 4+. These wounds count toward combat result. No dart shots in the shooting phase or later combat rounds. Reference: Lizardmen, printed p. 84–85.</description>
        </rule>
        <rule id="10d1-056e-735f-3297" name="Horned One" hidden="false" publicationId="7839-e5ae-5fb9-1604" page="84–85">
          <description>Causes fear and is never stupid. A Cold One unit accompanied by Inxi-Huinzi is immune to stupidity. Reference: Lizardmen, printed p. 84–85.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="70cc-c772-8f00-3d2c" name="Cold-blooded" targetId="bd8e-b04d-8ac4-5a7c" type="rule" hidden="false" publicationId="7839-e5ae-5fb9-1604" page="59, 73" />
        <infoLink id="f499-a433-a0f0-a226" name="Fear" targetId="7c4f-53c7-b87a-c8ff" type="rule" hidden="false" publicationId="d7c9-7773-4408-58f6" page="48–49" />
        <infoLink id="5e75-fb1b-d024-a5c7" name="Hand weapon" targetId="f660-63e8-377a-579c" type="rule" hidden="false" publicationId="d7c9-7773-4408-58f6" page="54" />
        <infoLink id="5e65-b248-56c2-da3d" name="Spear" targetId="a4ca-84b6-8eb8-6311" type="rule" hidden="false" publicationId="d7c9-7773-4408-58f6" page="55" />
