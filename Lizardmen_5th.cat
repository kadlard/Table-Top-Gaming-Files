                <infoLink id="d29f-af17-3ad5-0814" name="Wizards and armour" targetId="2464-78f1-754b-15cb" type="rule" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="7–8, 36" />
              </infoLinks>
              <rules>
                <rule id="a963-b029-df73-a081" name="Included equipment" hidden="false">
                  <description>Hand weapon.</description>
                </rule>
                <rule id="164f-a6b2-cf63-f793" name="Wizard level and spells" hidden="false">
                  <description>Magic level 4; 4 spell cards before bloodline/item changes. Those changes, including Forbidden Lore and Nehekhara’s Noble Blood, are applied manually. Normal armour casting restrictions apply unless a specific power overrides them.</description>
                </rule>
              </rules>
