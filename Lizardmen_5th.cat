        <rule id="74af-fc64-f1d8-03f1" name="Army-list note" hidden="false">
          <description>Standard and musician use the general permission for all regiments in Lizardmen p. 70, at twice the trooper price. No Kroxigor champion profile is provided.</description>
        </rule>
        <rule id="4297-a67a-fa7c-d65f" name="Models and command" hidden="false">
          <description>Select troopers plus any command; command replaces a trooper. A standard and musician cost twice an equipped trooper; champions use their own profile and price. Whole-unit options charge each affected model automatically. Independent Wight/Wraith champions buy their own equipment and mount.</description>
        </rule>
      </rules>
