                    <characteristic name="A" typeId="4cc5-d3f5-26a7-37c2">8</characteristic>
                    <characteristic name="Ld" typeId="cedc-6339-9f57-49bd">10</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <infoLinks>
                <infoLink id="b6c3-2f8a-a0e4-3d7f" name="Cold-blooded" targetId="bd8e-b04d-8ac4-5a7c" type="rule" hidden="false" publicationId="7839-e5ae-5fb9-1604" page="59, 73" />
                <infoLink id="0830-1d79-a651-a233" name="Slann Mage-Priest" targetId="2f71-7b20-9e47-3092" type="rule" hidden="false" publicationId="7839-e5ae-5fb9-1604" page="59, 73" />
                <infoLink id="d562-7962-b196-190f" name="Hand weapon" targetId="f660-63e8-377a-579c" type="rule" hidden="false" publicationId="d7c9-7773-4408-58f6" page="54" />
                <infoLink id="7550-49bc-a862-5f11" name="Champions, characters and challenges" targetId="c172-7f3e-b5a2-05ea" type="rule" hidden="false" publicationId="d7c9-7773-4408-58f6" page="59–67" />
                <infoLink id="1087-1f40-fc80-c5e1" name="Look Out, Sir!" targetId="bc97-ff52-c773-e2c9" type="rule" hidden="false" publicationId="d7c9-7773-4408-58f6" page="66" />
                <infoLink id="8cd9-2b27-3ee8-4a93" name="General" targetId="d1ba-1b25-c83e-0e46" type="rule" hidden="false" publicationId="d7c9-7773-4408-58f6" page="88" />
                <infoLink id="9eab-9787-ab54-f2a1" name="Magic phase and Winds of Magic" targetId="51af-8134-e1d0-5c8f" type="rule" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="9–12" />
                <infoLink id="646c-a7b2-1eb0-44f3" name="Counter magic and natural dispels" targetId="a2e7-268a-edde-1495" type="rule" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="10–14" />
                <infoLink id="bdd1-6973-5937-7628" name="Spells remaining in play" targetId="b403-7328-b3ca-4dd7" type="rule" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="11–14" />
                <infoLink id="89b7-34f5-617b-9544" name="Spell targets, sight and templates" targetId="34de-d976-f1cf-5402" type="rule" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="12, 22" />
                <infoLink id="ee1a-31b7-9970-4ba8" name="Wizards and armour" targetId="2464-78f1-754b-15cb" type="rule" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="7–8, 36" />
              </infoLinks>
              <rules>
                <rule id="a6dd-4391-0326-b0f4" name="Included equipment" hidden="false">
                  <description>Hand weapon.</description>
                </rule>
                <rule id="a2e8-21a8-1c06-2339" name="Wizard level and spells" hidden="false">
                  <description>Magic level 4; 4 spell cards before bloodline/item changes. Those changes, including Forbidden Lore and Nehekhara’s Noble Blood, are applied manually. Normal armour casting restrictions apply unless a specific power overrides them.</description>
                </rule>
              </rules>
