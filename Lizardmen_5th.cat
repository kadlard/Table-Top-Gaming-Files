              </infoLinks>
              <rules>
                <rule id="ab84-903e-f513-83e7" name="Included equipment" hidden="false">
                  <description>Hand weapon.</description>
                </rule>
                <rule id="2771-5d10-5232-8061" name="Wizard level and spells" hidden="false">
                  <description>Magic level 3; 3 spell cards before bloodline/item changes. Those changes, including Forbidden Lore and Nehekhara’s Noble Blood, are applied manually. Normal armour casting restrictions apply unless a specific power overrides them.</description>
                </rule>
              </rules>
