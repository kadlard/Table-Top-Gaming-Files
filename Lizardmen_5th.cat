        <infoLink id="5775-6021-b3ea-acf6" name="Cold-blooded" targetId="bd8e-b04d-8ac4-5a7c" type="rule" hidden="false" publicationId="7839-e5ae-5fb9-1604" page="59, 73" />
        <infoLink id="c72c-12d0-09eb-4262" name="Fear" targetId="7c4f-53c7-b87a-c8ff" type="rule" hidden="false" publicationId="d7c9-7773-4408-58f6" page="48–49" />
