                        <entryLink id="5fa3-26dc-12ac-8cb1" name="Hellfire Sword" targetId="712d-c722-072f-2ce4" type="selectionEntry" hidden="false" collective="false" import="true" />
                        <entryLink id="2a7b-8b06-216e-d6ea" name="Death Sword" targetId="b510-0b4c-0540-c8b9" type="selectionEntry" hidden="false" collective="false" import="true" />
                        <entryLink id="d1d0-f83e-cd68-50fe" name="Frost Blade" targetId="3a2e-cfa4-138d-4285" type="selectionEntry" hidden="false" collective="false" import="true" />
                        <entryLink id="5fdd-7313-5e52-c26d" name="Sword of Destruction" targetId="523d-5344-7992-dc03" type="selectionEntry" hidden="false" collective="false" import="true" />
                        <entryLink id="1f85-cd36-bec9-84c2" name="Sword of Teclis" targetId="82ed-ed5e-404c-242e" type="selectionEntry" hidden="false" collective="false" import="true" />
                        <entryLink id="5378-c899-1343-73ac" name="Sword of Unyielding" targetId="7e5b-dc29-ec3b-45b3" type="selectionEntry" hidden="false" collective="false" import="true" />
                        <entryLink id="d24d-6bf6-2300-dfef" name="Giant Blade" targetId="ba5a-9a74-df4a-0de7" type="selectionEntry" hidden="false" collective="false" import="true" />
