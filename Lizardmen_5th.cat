      </infoLinks>
    </selectionEntry>
    <selectionEntry id="1fe1-a2fe-05ae-41ad" name="Itzi-Bitzi" type="model" hidden="false" collective="false" import="true" publicationId="7839-e5ae-5fb9-1604" page="85">
      <costs>
        <cost name="pts" typeId="0044-15f1-782b-00ea" value="105" />
      </costs>
      <categoryLinks>
        <categoryLink id="f2bd-6b1e-f301-6bbc" name="Characters" targetId="0114-02b1-a20d-82f1" primary="true" hidden="false" />
      </categoryLinks>
      <profiles>
        <profile id="8508-1ce1-2cb6-8334" name="Itzi-Bitzi" typeId="e25d-f63f-8d67-4bda" typeName="Unit" hidden="false" publicationId="7839-e5ae-5fb9-1604" page="85">
          <characteristics>
            <characteristic name="M" typeId="df0b-cf43-1955-6845">6</characteristic>
            <characteristic name="WS" typeId="c83c-b081-d246-d5ef">4</characteristic>
            <characteristic name="BS" typeId="960a-0c90-a448-96b4">5</characteristic>
            <characteristic name="S" typeId="639b-d234-7e46-084b">4</characteristic>
            <characteristic name="T" typeId="6a8e-5ca4-9d4e-d596">3</characteristic>
            <characteristic name="W" typeId="8a8d-ce29-476c-e0fa">2</characteristic>
            <characteristic name="I" typeId="946e-86c4-ffce-c3ed">6</characteristic>
            <characteristic name="A" typeId="4cc5-d3f5-26a7-37c2">3</characteristic>
            <characteristic name="Ld" typeId="cedc-6339-9f57-49bd">7</characteristic>
          </characteristics>
        </profile>
        <profile id="92ef-edd4-e5fe-a9a7" name="Piranha Blade" typeId="b93a-4f1c-9871-3028" typeName="Magic item" hidden="false" publicationId="7839-e5ae-5fb9-1604" page="85">
          <characteristics>
            <characteristic name="Type" typeId="7ef9-9797-693d-d937">Magic weapon</characteristic>
            <characteristic name="Effect" typeId="d277-fc43-48d0-6dce">Each wound becomes D3 wounds.</characteristic>
            <characteristic name="Reference" typeId="2fa3-15cf-fc7d-e42b">Lizardmen, printed p. 85. Card value 35 points, included in the character total.</characteristic>
            <characteristic name="Coverage" typeId="23f7-abf1-238e-1daa">Book-checked summary; fixed loadout</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <constraints>
        <constraint id="9710-ec8f-dd74-8dec" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
        <constraint id="e234-1e4b-a1b6-8967" type="max" value="1" scope="roster" field="selections" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" />
      </constraints>
      <rules>
        <rule id="69fa-4c6e-e350-9c34" name="Special character" hidden="false">
          <description>Unique named selection. 105 points includes the complete listed fixed equipment, companions, powers and mounts; only separately offered options add points. Printed profiles are before magic-item bonuses unless a rule says they are already included. Special-character use requires the players’ agreement under the books’ convention.</description>
        </rule>
        <rule id="3579-d2b3-2e89-18e3" name="Included equipment" hidden="false">
          <description>Piranha Blade; light armour; shield.</description>
        </rule>
        <rule id="55c9-4c3a-268a-7661" name="Scaly skin" hidden="false" publicationId="7839-e5ae-5fb9-1604" page="85">
          <description>4+ armour save; Strength modifiers cannot worsen it beyond 6+. Reference: Lizardmen, printed p. 85.</description>
        </rule>
        <rule id="4052-8205-532c-5d98" name="Incantation of Xetlipocutzl" hidden="false" publicationId="7839-e5ae-5fb9-1604" page="85">
          <description>Once per battle at any time in an own turn, all enemies within 8 inches take an immediate Panic test on 3D6, using the highest two dice. Not a spell or magical effect; cannot be countered. Reference: Lizardmen, printed p. 85.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="b133-1c50-13f3-b09f" name="Cold-blooded" targetId="bd8e-b04d-8ac4-5a7c" type="rule" hidden="false" publicationId="7839-e5ae-5fb9-1604" page="59, 73" />
        <infoLink id="3127-a428-10e1-38b1" name="Aquatic" targetId="f575-77e7-1aea-c3ab" type="rule" hidden="false" publicationId="7839-e5ae-5fb9-1604" page="61–63" />
        <infoLink id="658d-a8a9-8749-530d" name="Armour, shield and barding" targetId="1d9b-1051-0031-be6d" type="rule" hidden="false" publicationId="d7c9-7773-4408-58f6" page="15, 30, 37" />
      </infoLinks>
    </selectionEntry>
    <selectionEntry id="c82c-9b6f-5210-7669" name="Tenehuini, Prophet of Sotek" type="model" hidden="false" collective="false" import="true" publicationId="7839-e5ae-5fb9-1604" page="86">
      <costs>
        <cost name="pts" typeId="0044-15f1-782b-00ea" value="120" />
      </costs>
      <categoryLinks>
        <categoryLink id="92b1-bfe8-0ac7-2bbd" name="Characters" targetId="0114-02b1-a20d-82f1" primary="true" hidden="false" />
      </categoryLinks>
      <profiles>
        <profile id="dfdf-a323-b402-6064" name="Tenehuini, Prophet of Sotek" typeId="e25d-f63f-8d67-4bda" typeName="Unit" hidden="false" publicationId="7839-e5ae-5fb9-1604" page="86">
          <characteristics>
            <characteristic name="M" typeId="df0b-cf43-1955-6845">6</characteristic>
            <characteristic name="WS" typeId="c83c-b081-d246-d5ef">2</characteristic>
            <characteristic name="BS" typeId="960a-0c90-a448-96b4">3</characteristic>
            <characteristic name="S" typeId="639b-d234-7e46-084b">3</characteristic>
            <characteristic name="T" typeId="6a8e-5ca4-9d4e-d596">3</characteristic>
            <characteristic name="W" typeId="8a8d-ce29-476c-e0fa">1</characteristic>
            <characteristic name="I" typeId="946e-86c4-ffce-c3ed">5</characteristic>
            <characteristic name="A" typeId="4cc5-d3f5-26a7-37c2">1</characteristic>
            <characteristic name="Ld" typeId="cedc-6339-9f57-49bd">6</characteristic>
          </characteristics>
        </profile>
        <profile id="2cb7-8bf4-8ec8-da80" name="Dagger of Sotek" typeId="b93a-4f1c-9871-3028" typeName="Magic item" hidden="false" publicationId="7839-e5ae-5fb9-1604" page="86">
          <characteristics>
            <characteristic name="Type" typeId="7ef9-9797-693d-d937">Magic weapon</characteristic>
            <characteristic name="Effect" typeId="d277-fc43-48d0-6dce">Adds +1 Strength. A Skaven unit wounded by the dagger loses its rear-rank combat bonus and rank-derived Leadership bonus for the resulting Break test.</characteristic>
            <characteristic name="Reference" typeId="2fa3-15cf-fc7d-e42b">Lizardmen, printed p. 86. Card value 50 points, included in the character total.</characteristic>
            <characteristic name="Coverage" typeId="23f7-abf1-238e-1daa">Book-checked summary; fixed loadout</characteristic>
          </characteristics>
        </profile>
        <profile id="0143-6cf3-8702-4481" name="Totem of Sotek" typeId="b93a-4f1c-9871-3028" typeName="Magic item" hidden="false" publicationId="7839-e5ae-5fb9-1604" page="86">
          <characteristics>
            <characteristic name="Type" typeId="7ef9-9797-693d-d937">Magic standard</characteristic>
            <characteristic name="Effect" typeId="d277-fc43-48d0-6dce">Not an army battle standard. A purchased Serpent Swarm may deploy within 12 inches of the totem and at least 8 inches from enemies, or arrive at the start of a later own turn within 12 inches, including directly in combat. All Serpent Swarms within 12 inches gain +1 Attack.</characteristic>
            <characteristic name="Reference" typeId="2fa3-15cf-fc7d-e42b">Lizardmen, printed p. 86. Card value 10 points, included in the character total.</characteristic>
            <characteristic name="Coverage" typeId="23f7-abf1-238e-1daa">Book-checked summary; fixed loadout</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <constraints>
        <constraint id="3097-aa50-bb56-a2f5" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
        <constraint id="d3c4-d182-5179-ef39" type="max" value="1" scope="roster" field="selections" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" />
      </constraints>
      <rules>
        <rule id="e295-b1db-ae50-2e4e" name="Special character" hidden="false">
          <description>Unique named selection. 120 points includes the complete listed fixed equipment, companions, powers and mounts; only separately offered options add points. Printed profiles are before magic-item bonuses unless a rule says they are already included. Special-character use requires the players’ agreement under the books’ convention.</description>
        </rule>
        <rule id="41b6-552b-0f56-5eda" name="Included equipment" hidden="false">
          <description>Dagger of Sotek; Totem of Sotek.</description>
        </rule>
        <rule id="0b87-1320-64da-bf0d" name="Shield of Sotek" hidden="false" publicationId="7839-e5ae-5fb9-1604" page="86">
          <description>Special save 4+ after ordinary armour, unaffected by Strength or weapons negating armour. The entry also describes scaly skin with a 6+ floor against Strength modifiers; use the separate 4+ special save as printed. Reference: Lizardmen, printed p. 86.</description>
        </rule>
        <rule id="e26c-dd62-7866-720f" name="Magic and spell allocation" hidden="false">
          <description>Magic level 1; 1 spells. Printed spell count already includes fixed bloodline effects; do not add those bonuses again. The lore profiles are reference decks, not a grant of all spells. Choose/draw the permitted spells before play and record them in roster notes.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="a694-9943-fdc6-94db" name="Cold-blooded" targetId="bd8e-b04d-8ac4-5a7c" type="rule" hidden="false" publicationId="7839-e5ae-5fb9-1604" page="59, 73" />
        <infoLink id="446d-3ea6-f127-7389" name="Aquatic" targetId="f575-77e7-1aea-c3ab" type="rule" hidden="false" publicationId="7839-e5ae-5fb9-1604" page="61–63" />
        <infoLink id="7865-b866-eb61-303a" name="Magic phase and Winds of Magic" targetId="51af-8134-e1d0-5c8f" type="rule" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="9–12" />
        <infoLink id="ca11-ca17-a7f9-a9b1" name="Counter magic and natural dispels" targetId="a2e7-268a-edde-1495" type="rule" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="10–14" />
        <infoLink id="d03e-9a0e-d12c-82a9" name="Winds of Magic special cards" targetId="0d22-3d38-e047-8557" type="rule" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="9–10" />
        <infoLink id="c772-29da-f5d9-22b9" name="Spells remaining in play" targetId="b403-7328-b3ca-4dd7" type="rule" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="11–14" />
        <infoLink id="7c64-7fab-e79e-0b1d" name="Spell targets, sight and templates" targetId="34de-d976-f1cf-5402" type="rule" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="12, 22" />
      </infoLinks>
      <selectionEntryGroups>
        <selectionEntryGroup id="d813-dd58-db2e-2e07" name="Magic lore" hidden="false" collective="false" import="true" defaultSelectionEntryId="c15d-d098-55bd-f583">
          <constraints>
            <constraint id="f353-d07e-609e-64dd" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
            <constraint id="17a0-3f06-efab-375b" type="min" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <selectionEntries>
            <selectionEntry id="c15d-d098-55bd-f583" name="Battle Magic" type="upgrade" hidden="false" collective="false" import="true">
              <costs>
                <cost name="pts" typeId="0044-15f1-782b-00ea" value="0" />
              </costs>
              <constraints>
                <constraint id="cf3b-6aee-9cb3-bccc" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
              </constraints>
              <profiles>
                <profile id="11d0-68d3-598e-20c3" name="Fireball" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="26">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Battle Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">1</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">24 inches</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">Launch one fireball per magic level. Each strikes the first model in its path for one S4 hit, without armour saves. Line of sight required.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 26</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">Reference deck; not automatically known</characteristic>
                  </characteristics>
                </profile>
                <profile id="e515-683d-cf81-d73e" name="Destruction" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="26">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Battle Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">2+</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">18 inches</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">An enemy unit suffers 2D6 S4 hits, without armour saves. The summary prints Power 2+ but does not explain the additional-power procedure; use the spell card for that detail.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 26</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">Reference deck; not automatically known</characteristic>
                  </characteristics>
                </profile>
                <profile id="3cbb-4661-0a02-7326" name="Fear" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="26">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Battle Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">2</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">24 inches</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">The targeted enemy unit immediately takes a Fear test and flees if it fails.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 26</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">Reference deck; not automatically known</characteristic>
                  </characteristics>
                </profile>
                <profile id="6841-17d4-6dd0-654b" name="Blast" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="26">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Battle Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">2</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">24 inches</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">The first enemy model in the path suffers either D6 S5 hits or D3 S10 hits, with no armour saves. The summary does not reproduce a Line of Sight label; check the original card for its targeting instructions.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 26</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">Reference deck; not automatically known</characteristic>
                  </characteristics>
                </profile>
                <profile id="2335-a3ff-834f-11df" name="Shield" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="27">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Battle Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">2</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">18 inches</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">A friendly unit gains a magical shield: before enemy shots roll to hit, roll for each shot; on 4+ it is stopped.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Remains in play</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 27</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">Reference deck; not automatically known</characteristic>
                  </characteristics>
                </profile>
                <profile id="228c-fc82-43a4-0f0d" name="Heal" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="27">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Battle Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">1</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">12 inches</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">The wizard or one friendly model within range recovers one lost wound.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 27</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">Reference deck; not automatically known</characteristic>
                  </characteristics>
                </profile>
                <profile id="b735-7ee0-9a04-49e3" name="Hold Fast" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="27">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Battle Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">3</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">24 inches</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">An enemy unit can do nothing while the spell lasts.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Remains in play</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 27</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">Reference deck; not automatically known</characteristic>
                  </characteristics>
                </profile>
                <profile id="210c-0513-c754-1a74" name="Teleport Self" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="27">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Battle Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">1</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">Self</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">Transport the wizard anywhere on the battlefield. Arrival in combat counts as charging.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 27</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">Reference deck; not automatically known</characteristic>
                  </characteristics>
                </profile>
                <profile id="5db0-4df5-0928-6858" name="Curse" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="27">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Battle Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">2</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">24 inches</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">An enemy unit suffers -1 to shooting and close-combat hit rolls.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Remains in play</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 27</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">Reference deck; not automatically known</characteristic>
                  </characteristics>
                </profile>
                <profile id="9584-495b-4ec4-eaf3" name="Net" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="27">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Battle Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">2</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">12 inches</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">An enemy unit can do nothing while entangled.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Remains in play</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 27</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">Reference deck; not automatically known</characteristic>
                  </characteristics>
                </profile>
                <profile id="0299-9bcc-a6ca-720d" name="Move Unit" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="27">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Battle Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">2</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">18 inches</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">Transport the wizard and a friendly unit up to 18 inches across the battlefield. Moving into combat counts as charging in its first round.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 27</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">Reference deck; not automatically known</characteristic>
                  </characteristics>
                </profile>
                <profile id="8916-fa30-4863-3eb2" name="Bless" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="27">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Battle Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">2</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">24 inches</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">A friendly unit gains +1 to shooting and close-combat hit rolls.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Remains in play</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 27</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">Reference deck; not automatically known</characteristic>
                  </characteristics>
                </profile>
                <profile id="df18-6767-f27f-a4f8" name="Protect" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="27">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Battle Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">3</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">24 inches</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">A friendly unit gains a 4+ special save against each wound.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Remains in play</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 27</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">Reference deck; not automatically known</characteristic>
                  </characteristics>
