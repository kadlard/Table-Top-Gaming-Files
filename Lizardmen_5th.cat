  <sharedSelectionEntries>
    <selectionEntry id="5b7c-1b30-9c35-a21e" name="Venerable Lord Kroak" type="model" hidden="false" collective="false" import="true" publicationId="7839-e5ae-5fb9-1604" page="79–80">
      <costs>
        <cost name="pts" typeId="0044-15f1-782b-00ea" value="620" />
      </costs>
      <categoryLinks>
        <categoryLink id="c868-8653-b29b-35ef" name="Characters" targetId="0114-02b1-a20d-82f1" primary="true" hidden="false" />
      </categoryLinks>
      <profiles>
        <profile id="3820-c1bf-21a0-5455" name="Venerable Lord Kroak" typeId="e25d-f63f-8d67-4bda" typeName="Unit" hidden="false" publicationId="7839-e5ae-5fb9-1604" page="79–80">
          <characteristics>
            <characteristic name="M" typeId="df0b-cf43-1955-6845">4</characteristic>
            <characteristic name="WS" typeId="c83c-b081-d246-d5ef">6</characteristic>
            <characteristic name="BS" typeId="960a-0c90-a448-96b4">5</characteristic>
            <characteristic name="S" typeId="639b-d234-7e46-084b">6</characteristic>
            <characteristic name="T" typeId="6a8e-5ca4-9d4e-d596">5</characteristic>
            <characteristic name="W" typeId="8a8d-ce29-476c-e0fa">8</characteristic>
            <characteristic name="I" typeId="946e-86c4-ffce-c3ed">6</characteristic>
            <characteristic name="A" typeId="4cc5-d3f5-26a7-37c2">8</characteristic>
            <characteristic name="Ld" typeId="cedc-6339-9f57-49bd">10</characteristic>
          </characteristics>
        </profile>
        <profile id="33db-842f-01cb-3f5a" name="Standard of the Sacred Serpent" typeId="b93a-4f1c-9871-3028" typeName="Magic item" hidden="false" publicationId="7839-e5ae-5fb9-1604" page="79–80">
          <characteristics>
            <characteristic name="Type" typeId="7ef9-9797-693d-d937">Magic standard</characteristic>
            <characteristic name="Effect" typeId="d277-fc43-48d0-6dce">Not the army battle standard. Range 8 inches; D6 shots in the shooting phase using Kroak’s BS, each hit Strength 4.</characteristic>
            <characteristic name="Reference" typeId="2fa3-15cf-fc7d-e42b">Lizardmen, printed p. 79–80. Card value 25 points, included in the character total.</characteristic>
            <characteristic name="Coverage" typeId="23f7-abf1-238e-1daa">Book-checked summary; fixed loadout</characteristic>
          </characteristics>
        </profile>
        <profile id="6345-14fe-3b2b-0a4a" name="Gold Death Mask" typeId="b93a-4f1c-9871-3028" typeName="Magic item" hidden="false" publicationId="7839-e5ae-5fb9-1604" page="79–80">
          <characteristics>
            <characteristic name="Type" typeId="7ef9-9797-693d-d937">Enchanted item</characteristic>
            <characteristic name="Effect" typeId="d277-fc43-48d0-6dce">Enemy melee attacks hit Kroak only on a 6.</characteristic>
            <characteristic name="Reference" typeId="2fa3-15cf-fc7d-e42b">Lizardmen, printed p. 79–80. Card value 50 points, included in the character total.</characteristic>
            <characteristic name="Coverage" typeId="23f7-abf1-238e-1daa">Book-checked summary; fixed loadout</characteristic>
          </characteristics>
        </profile>
        <profile id="4064-37a1-3b1f-c981" name="Ceremonial Mace of Malachite" typeId="b93a-4f1c-9871-3028" typeName="Magic item" hidden="false" publicationId="7839-e5ae-5fb9-1604" page="79–80">
          <characteristics>
            <characteristic name="Type" typeId="7ef9-9797-693d-d937">Magic weapon</characteristic>
            <characteristic name="Effect" typeId="d277-fc43-48d0-6dce">Negates magic weapons used against Kroak in melee. Enemies may instead use ordinary weapons.</characteristic>
            <characteristic name="Reference" typeId="2fa3-15cf-fc7d-e42b">Lizardmen, printed p. 79–80. Card value 50 points, included in the character total.</characteristic>
            <characteristic name="Coverage" typeId="23f7-abf1-238e-1daa">Book-checked summary; fixed loadout</characteristic>
          </characteristics>
        </profile>
        <profile id="d193-96b0-b71e-24fe" name="Amulet of Itza" typeId="b93a-4f1c-9871-3028" typeName="Magic item" hidden="false" publicationId="7839-e5ae-5fb9-1604" page="79–80">
          <characteristics>
            <characteristic name="Type" typeId="7ef9-9797-693d-d937">Wizard arcana</characteristic>
            <characteristic name="Effect" typeId="d277-fc43-48d0-6dce">Spells against Kroak or his unit are dispelled on 4+. A successful dispel also gives the caster one Strength 4 hit.</characteristic>
            <characteristic name="Reference" typeId="2fa3-15cf-fc7d-e42b">Lizardmen, printed p. 79–80. Card value 25 points, included in the character total.</characteristic>
            <characteristic name="Coverage" typeId="23f7-abf1-238e-1daa">Book-checked summary; fixed loadout</characteristic>
          </characteristics>
        </profile>
        <profile id="5e59-1c30-23a1-283f" name="Glyph of Potec" typeId="b93a-4f1c-9871-3028" typeName="Magic item" hidden="false" publicationId="7839-e5ae-5fb9-1604" page="79–80">
          <characteristics>
            <characteristic name="Type" typeId="7ef9-9797-693d-d937">Enchanted item</characteristic>
            <characteristic name="Effect" typeId="d277-fc43-48d0-6dce">Undead in base contact suffer double damage.</characteristic>
            <characteristic name="Reference" typeId="2fa3-15cf-fc7d-e42b">Lizardmen, printed p. 79–80. Card value 20 points, included in the character total.</characteristic>
            <characteristic name="Coverage" typeId="23f7-abf1-238e-1daa">Book-checked summary; fixed loadout</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <constraints>
        <constraint id="2081-99ee-7bc3-a153" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
        <constraint id="4447-810a-a33e-33b3" type="max" value="1" scope="roster" field="selections" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" />
      </constraints>
      <rules>
        <rule id="1ece-563e-f902-3b04" name="Special character" hidden="false">
          <description>Unique named selection. 620 points includes the complete listed fixed equipment, companions, powers and mounts; only separately offered options add points. Printed profiles are before magic-item bonuses unless a rule says they are already included. Special-character use requires the players’ agreement under the books’ convention.</description>
        </rule>
        <rule id="52ac-46db-4d7d-f86e" name="Included equipment" hidden="false">
          <description>Ceremonial Mace of Malachite; palanquin with four bodyguards.</description>
        </rule>
        <rule id="555c-3298-a713-5425" name="Relic Priest" hidden="false" publicationId="7839-e5ae-5fb9-1604" page="79–80">
          <description>May accompany any army in addition to its living Slann General, regardless of points limit. Cannot be General or cast spells himself. Holds four Battle or High Magic spells. At the start of a Lizardman magic phase each living Slann may swap one spell with Kroak. Reference: Lizardmen, printed p. 79–80.</description>
        </rule>
        <rule id="60a1-f00e-88c9-1535" name="Mighty Shield and palanquin" hidden="false" publicationId="7839-e5ae-5fb9-1604" page="79–80">
          <description>The entire model has a 3+ special save against each wound, unaffected by Strength or armour-negating weapons. Kroak and the four bearers share one combined profile; attacks and items affect the whole model. Reference: Lizardmen, printed p. 79–80.</description>
        </rule>
        <rule id="7a10-637d-f0eb-8d39" name="Magic and spell allocation" hidden="false">
          <description>Four reference spells held for telepathic exchange; Kroak cannot cast and is not a living wizard.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="9dfa-8e23-17d4-6244" name="Cold-blooded" targetId="bd8e-b04d-8ac4-5a7c" type="rule" hidden="false" publicationId="7839-e5ae-5fb9-1604" page="59, 73" />
        <infoLink id="12ab-631a-51ce-cab1" name="Magic phase and Winds of Magic" targetId="51af-8134-e1d0-5c8f" type="rule" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="9–12" />
        <infoLink id="f298-f683-dea9-e689" name="Counter magic and natural dispels" targetId="a2e7-268a-edde-1495" type="rule" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="10–14" />
        <infoLink id="4275-8c2d-84f3-5a99" name="Winds of Magic special cards" targetId="0d22-3d38-e047-8557" type="rule" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="9–10" />
        <infoLink id="337c-c00c-2428-6f5a" name="Spells remaining in play" targetId="b403-7328-b3ca-4dd7" type="rule" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="11–14" />
        <infoLink id="abeb-64d2-51d6-3b07" name="Spell targets, sight and templates" targetId="34de-d976-f1cf-5402" type="rule" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="12, 22" />
      </infoLinks>
      <selectionEntryGroups>
        <selectionEntryGroup id="91f6-62d0-3fc4-70e5" name="Magic lore" hidden="false" collective="false" import="true" defaultSelectionEntryId="fbdc-c542-4819-9711">
          <constraints>
            <constraint id="9f79-0744-4283-374c" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
            <constraint id="989e-efc6-e022-ece7" type="min" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <selectionEntries>
            <selectionEntry id="fbdc-c542-4819-9711" name="Battle Magic" type="upgrade" hidden="false" collective="false" import="true">
              <costs>
                <cost name="pts" typeId="0044-15f1-782b-00ea" value="0" />
              </costs>
              <constraints>
                <constraint id="2ced-aa79-ff61-b431" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
              </constraints>
              <profiles>
                <profile id="9aac-8dd5-cd72-cb72" name="Fireball" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="26">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Battle Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">1</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">24 inches</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">Launch one fireball per magic level. Each strikes the first model in its path for one S4 hit, without armour saves. Line of sight required.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 26</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">Reference deck; not automatically known</characteristic>
                  </characteristics>
                </profile>
                <profile id="2caf-607c-486d-992d" name="Destruction" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="26">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Battle Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">2+</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">18 inches</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">An enemy unit suffers 2D6 S4 hits, without armour saves. The summary prints Power 2+ but does not explain the additional-power procedure; use the spell card for that detail.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 26</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">Reference deck; not automatically known</characteristic>
                  </characteristics>
                </profile>
                <profile id="ff83-58d6-b3b3-eca9" name="Fear" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="26">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Battle Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">2</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">24 inches</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">The targeted enemy unit immediately takes a Fear test and flees if it fails.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 26</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">Reference deck; not automatically known</characteristic>
                  </characteristics>
                </profile>
                <profile id="8946-a867-3853-8c7e" name="Blast" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="26">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Battle Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">2</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">24 inches</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">The first enemy model in the path suffers either D6 S5 hits or D3 S10 hits, with no armour saves. The summary does not reproduce a Line of Sight label; check the original card for its targeting instructions.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 26</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">Reference deck; not automatically known</characteristic>
                  </characteristics>
                </profile>
                <profile id="f1ed-27e9-c652-1385" name="Shield" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="27">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Battle Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">2</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">18 inches</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">A friendly unit gains a magical shield: before enemy shots roll to hit, roll for each shot; on 4+ it is stopped.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Remains in play</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 27</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">Reference deck; not automatically known</characteristic>
                  </characteristics>
                </profile>
                <profile id="b06f-5a9f-923b-4173" name="Heal" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="27">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Battle Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">1</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">12 inches</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">The wizard or one friendly model within range recovers one lost wound.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 27</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">Reference deck; not automatically known</characteristic>
                  </characteristics>
                </profile>
                <profile id="0f02-432c-2fe0-db26" name="Hold Fast" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="27">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Battle Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">3</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">24 inches</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">An enemy unit can do nothing while the spell lasts.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Remains in play</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 27</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">Reference deck; not automatically known</characteristic>
                  </characteristics>
                </profile>
                <profile id="8135-df81-789b-d844" name="Teleport Self" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="27">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Battle Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">1</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">Self</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">Transport the wizard anywhere on the battlefield. Arrival in combat counts as charging.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 27</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">Reference deck; not automatically known</characteristic>
                  </characteristics>
                </profile>
                <profile id="5a3c-e0b0-32ce-c58b" name="Curse" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="27">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Battle Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">2</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">24 inches</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">An enemy unit suffers -1 to shooting and close-combat hit rolls.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Remains in play</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 27</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">Reference deck; not automatically known</characteristic>
                  </characteristics>
                </profile>
                <profile id="b5f8-e9a5-6a2e-66a0" name="Net" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="27">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Battle Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">2</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">12 inches</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">An enemy unit can do nothing while entangled.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Remains in play</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 27</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">Reference deck; not automatically known</characteristic>
                  </characteristics>
                </profile>
                <profile id="3530-e75f-ed6e-a917" name="Move Unit" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="27">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Battle Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">2</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">18 inches</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">Transport the wizard and a friendly unit up to 18 inches across the battlefield. Moving into combat counts as charging in its first round.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 27</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">Reference deck; not automatically known</characteristic>
                  </characteristics>
                </profile>
                <profile id="a0dc-af5c-736a-f80f" name="Bless" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="27">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Battle Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">2</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">24 inches</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">A friendly unit gains +1 to shooting and close-combat hit rolls.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Remains in play</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 27</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">Reference deck; not automatically known</characteristic>
                  </characteristics>
                </profile>
                <profile id="9a67-316e-2b5f-c9c4" name="Protect" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="27">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Battle Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">3</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">24 inches</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">A friendly unit gains a 4+ special save against each wound.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Remains in play</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 27</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">Reference deck; not automatically known</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="b65c-4c40-6304-9f67" name="High Magic" type="upgrade" hidden="false" collective="false" import="true">
              <costs>
                <cost name="pts" typeId="0044-15f1-782b-00ea" value="0" />
              </costs>
              <constraints>
                <constraint id="05ec-84be-e514-b12f" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
              </constraints>
              <infoLinks>
                <infoLink id="c2e5-b4f9-3fe6-ff92" name="High Magic: spell draw and superiority" targetId="2ff6-b313-7160-82e9" type="rule" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="18" />
              </infoLinks>
              <profiles>
                <profile id="3ef8-6912-3994-0adf" name="Coruscation of Finreir" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="23">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">High Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">1</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">Self</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">The Mage rises on a pillar, sees across the battlefield and casts spells without range reduction. Only flying models can shoot him or attack him in close combat. He gains a 2+ armour save and may fly 24 inches. If dispelled, he descends safely.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Remains in play</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 23</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">Reference deck; not automatically known</characteristic>
                  </characteristics>
                </profile>
                <profile id="fd14-223c-f09e-7deb" name="Deadlock" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="23">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">High Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">1</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">12 inches</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">Nullify one enemy-held magic item within range. The Mage may release it and deadlock another as described by the spell.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Remains in play</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 23</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">Reference deck; not automatically known</characteristic>
                  </characteristics>
                </profile>
                <profile id="8028-03a8-b5ad-bae8" name="Banishment" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="23">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">High Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">2</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">12 inches</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">Each Undead or Daemon model within range suffers D6 wounds on 4+. Dark, Necromantic and Chaos spells in play within range are dispelled on 4+. Characters test individually and cannot use Look Out, Sir!</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 23</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">Reference deck; not automatically known</characteristic>
                  </characteristics>
                </profile>
                <profile id="ccf4-19e8-5441-3d15" name="Glamour of Teclis" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="23">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">High Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">1</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">36 inches</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">Each time the targeted unit wishes to move it must pass Leadership. On failure the Mage may move it instead.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Remains in play</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 23</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">Reference deck; not automatically known</characteristic>
                  </characteristics>
                </profile>
                <profile id="dd9c-9b59-2ebc-332d" name="Assault of Stone" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="24">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">High Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">3</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">24 inches</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">Move a hill within range up to D6 inches. Individual models touched must roll below Initiative on D6 or suffer D3 wounds; units suffer 2D6 wounds automatically. No armour saves.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 24</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">Reference deck; not automatically known</characteristic>
                  </characteristics>
                </profile>
                <profile id="cceb-638c-fcff-d43c" name="Drain Magic" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="24">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">High Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">3</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">Battlefield</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">Dispel all current spells, discard both hands of magic cards and end the phase. Each wizard rolls 2D6: on 4+ it loses one magic level; a High Magic Mage loses a level only on 6+. This spell cannot be dispelled.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 24</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">Reference deck; not automatically known</characteristic>
                  </characteristics>
                </profile>
                <profile id="c3cc-bce1-557b-35aa" name="Apotheosis" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="24">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">High Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">1</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">6 inches</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">Return a slain friendly model to life within 6 inches of the Mage, with its items, armour, equipment and ordinary steed, but not a monster mount. The returned model causes Fear.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Remains in play</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 24</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">Reference deck; not automatically known</characteristic>
                  </characteristics>
                </profile>
                <profile id="825a-ea91-57f0-59ac" name="Fiery Convocation" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="24">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">High Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">2</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">24 inches</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">An enemy unit immediately takes 2D6 S4 hits. In every subsequent magic phase it takes 2D6 hits at a Strength one higher than before.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Remains in play</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 24</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">Reference deck; not automatically known</characteristic>
                  </characteristics>
                </profile>
                <profile id="5b05-0170-feef-82ca" name="The Tempest" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="24">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">High Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">3</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">48-inch radius</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">Enemy units in range must pass Leadership before moving. Flying is prevented and flyers are grounded. All missile fire suffers -2 to hit. War engines and buildings suffer D6 S7 hits each magic phase it lasts.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Remains in play</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 24</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">Reference deck; not automatically known</characteristic>
                  </characteristics>
                </profile>
                <profile id="89a7-a268-2b57-5b7f" name="Hand of Glory" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="24">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">High Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">2</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">12-inch radius</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">Friendly units in range automatically pass Leadership tests; fleeing friendly units there rally immediately.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 24</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">Reference deck; not automatically known</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
      </selectionEntryGroups>
    </selectionEntry>
