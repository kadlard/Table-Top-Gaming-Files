              <selectionEntryGroups>
                <selectionEntryGroup id="39a9-4ac1-e9c3-c67d" name="Magic lore" hidden="false" collective="false" import="true" defaultSelectionEntryId="91ed-8a7c-d374-df02">
                  <constraints>
