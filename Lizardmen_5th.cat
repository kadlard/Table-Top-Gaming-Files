    <selectionEntry id="b9e8-a3ce-c9b0-cf58" name="Lord Mazdamundi" type="model" hidden="false" collective="false" import="true" publicationId="7839-e5ae-5fb9-1604" page="87–89">
      <costs>
        <cost name="pts" typeId="0044-15f1-782b-00ea" value="900" />
      </costs>
      <categoryLinks>
        <categoryLink id="24db-e049-ef29-5030" name="Characters" targetId="0114-02b1-a20d-82f1" primary="true" hidden="false" />
      </categoryLinks>
      <profiles>
        <profile id="7f5d-b050-2a65-2fc5" name="Lord Mazdamundi" typeId="e25d-f63f-8d67-4bda" typeName="Unit" hidden="false" publicationId="7839-e5ae-5fb9-1604" page="87–89">
          <characteristics>
            <characteristic name="M" typeId="df0b-cf43-1955-6845">6</characteristic>
            <characteristic name="WS" typeId="c83c-b081-d246-d5ef">6</characteristic>
            <characteristic name="BS" typeId="960a-0c90-a448-96b4">5</characteristic>
            <characteristic name="S" typeId="639b-d234-7e46-084b">7</characteristic>
            <characteristic name="T" typeId="6a8e-5ca4-9d4e-d596">6</characteristic>
            <characteristic name="W" typeId="8a8d-ce29-476c-e0fa">8</characteristic>
            <characteristic name="I" typeId="946e-86c4-ffce-c3ed">6</characteristic>
            <characteristic name="A" typeId="4cc5-d3f5-26a7-37c2">8</characteristic>
            <characteristic name="Ld" typeId="cedc-6339-9f57-49bd">10</characteristic>
          </characteristics>
        </profile>
        <profile id="7223-1111-c0df-fcea" name="Cobra Mace of Mazdamundi" typeId="b93a-4f1c-9871-3028" typeName="Magic item" hidden="false" publicationId="7839-e5ae-5fb9-1604" page="89">
          <characteristics>
            <characteristic name="Type" typeId="7ef9-9797-693d-d937">Magic weapon</characteristic>
            <characteristic name="Effect" typeId="d277-fc43-48d0-6dce">Before resolving attacks from an enemy magic weapon roll D6 once; on 6 the weapon is destroyed.</characteristic>
            <characteristic name="Reference" typeId="2fa3-15cf-fc7d-e42b">Lizardmen, printed p. 89. Card value 15 points, included in the character total.</characteristic>
            <characteristic name="Coverage" typeId="23f7-abf1-238e-1daa">Book-checked summary; fixed loadout</characteristic>
          </characteristics>
        </profile>
        <profile id="54db-765b-37a2-615e" name="Plaque of Tepec" typeId="b93a-4f1c-9871-3028" typeName="Magic item" hidden="false" publicationId="7839-e5ae-5fb9-1604" page="89">
          <characteristics>
            <characteristic name="Type" typeId="7ef9-9797-693d-d937">Wizard arcana</characteristic>
            <characteristic name="Effect" typeId="d277-fc43-48d0-6dce">One use: automatically dispel a spell aimed at Mazdamundi or his unit. Both players roll D6; if Mazdamundi wins, also destroy that spell.</characteristic>
            <characteristic name="Reference" typeId="2fa3-15cf-fc7d-e42b">Lizardmen, printed p. 89. Card value 50 points, included in the character total.</characteristic>
            <characteristic name="Coverage" typeId="23f7-abf1-238e-1daa">Book-checked summary; fixed loadout</characteristic>
          </characteristics>
        </profile>
        <profile id="7079-3498-3ac4-7149" name="Plaque of Xoloc" typeId="b93a-4f1c-9871-3028" typeName="Magic item" hidden="false" publicationId="7839-e5ae-5fb9-1604" page="89">
          <characteristics>
            <characteristic name="Type" typeId="7ef9-9797-693d-d937">Wizard arcana</characteristic>
            <characteristic name="Effect" typeId="d277-fc43-48d0-6dce">One use: power one spell from Mazdamundi or another Slann for free with Total Power. Then every wizard on the battlefield rolls D6, suffering one wound on 1.</characteristic>
            <characteristic name="Reference" typeId="2fa3-15cf-fc7d-e42b">Lizardmen, printed p. 89. Card value 50 points, included in the character total.</characteristic>
            <characteristic name="Coverage" typeId="23f7-abf1-238e-1daa">Book-checked summary; fixed loadout</characteristic>
          </characteristics>
        </profile>
        <profile id="8f62-9619-5ca3-31ba" name="Itxi Grubs" typeId="b93a-4f1c-9871-3028" typeName="Magic item" hidden="false" publicationId="7839-e5ae-5fb9-1604" page="89">
          <characteristics>
            <characteristic name="Type" typeId="7ef9-9797-693d-d937">Wizard arcana</characteristic>
            <characteristic name="Effect" typeId="d277-fc43-48d0-6dce">One use at the start of an own magic phase: gain D6 Winds of Magic cards.</characteristic>
            <characteristic name="Reference" typeId="2fa3-15cf-fc7d-e42b">Lizardmen, printed p. 89. Card value 50 points, included in the character total.</characteristic>
            <characteristic name="Coverage" typeId="23f7-abf1-238e-1daa">Book-checked summary; fixed loadout</characteristic>
          </characteristics>
        </profile>
        <profile id="5f0a-9ab7-d616-1b27" name="Egg of the Quango" typeId="b93a-4f1c-9871-3028" typeName="Magic item" hidden="false" publicationId="7839-e5ae-5fb9-1604" page="89">
          <characteristics>
            <characteristic name="Type" typeId="7ef9-9797-693d-d937">Enchanted item</characteristic>
            <characteristic name="Effect" typeId="d277-fc43-48d0-6dce">One use in melee: gain D3 extra attacks.</characteristic>
            <characteristic name="Reference" typeId="2fa3-15cf-fc7d-e42b">Lizardmen, printed p. 89. Card value 10 points, included in the character total.</characteristic>
            <characteristic name="Coverage" typeId="23f7-abf1-238e-1daa">Book-checked summary; fixed loadout</characteristic>
          </characteristics>
        </profile>
        <profile id="8f21-d624-6587-27e2" name="Sunburst Standard of Hexoatl" typeId="b93a-4f1c-9871-3028" typeName="Magic item" hidden="false" publicationId="7839-e5ae-5fb9-1604" page="89">
          <characteristics>
            <characteristic name="Type" typeId="7ef9-9797-693d-d937">Magic standard</characteristic>
            <characteristic name="Effect" typeId="d277-fc43-48d0-6dce">Army battle standard. Models flying high cannot charge Mazdamundi or his unit; they must first land.</characteristic>
            <characteristic name="Reference" typeId="2fa3-15cf-fc7d-e42b">Lizardmen, printed p. 89. Card value 50 points, included in the character total.</characteristic>
            <characteristic name="Coverage" typeId="23f7-abf1-238e-1daa">Book-checked summary; fixed loadout</characteristic>
          </characteristics>
        </profile>
        <profile id="58cd-0fb6-55fb-1ee1" name="Move the Mountains" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7839-e5ae-5fb9-1604" page="88">
          <characteristics>
            <characteristic name="Lore" typeId="d783-9c87-2677-5247">Lord Mazdamundi — unique spell</characteristic>
            <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">2</characteristic>
            <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">Any hill</characteristic>
            <characteristic name="Effect" typeId="d107-f119-4175-3647">A hill shakes until the next Lizardman magic phase. Troops on it cannot move, shoot, cast spells or fight.</characteristic>
            <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
            <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Lizardmen, printed p. 88</characteristic>
            <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">Included unique spell</characteristic>
          </characteristics>
        </profile>
        <profile id="1dac-f503-bcb7-17bc" name="Ruination of Cities" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7839-e5ae-5fb9-1604" page="88">
          <characteristics>
            <characteristic name="Lore" typeId="d783-9c87-2677-5247">Lord Mazdamundi — unique spell</characteristic>
            <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">3</characteristic>
            <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">Any one qualifying terrain feature</characteristic>
            <characteristic name="Effect" typeId="d107-f119-4175-3647">Collapse a building/group of buildings forming one terrain feature, wall or bridge into very difficult rubble. For each occupying model roll 2D6: above Toughness removes it. Units losing 25% test Panic.</characteristic>
            <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
            <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Lizardmen, printed p. 88</characteristic>
            <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">Included unique spell</characteristic>
          </characteristics>
        </profile>
        <profile id="8f25-c2b7-26b5-6846" name="Earth Line" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7839-e5ae-5fb9-1604" page="88">
          <characteristics>
            <characteristic name="Lore" typeId="d783-9c87-2677-5247">Lord Mazdamundi — unique spell</characteristic>
            <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">3</characteristic>
            <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">Line to one chosen table corner</characteristic>
            <characteristic name="Effect" typeId="d107-f119-4175-3647">Draw a line from Mazdamundi to a chosen corner. For each model crossed, 2D6 above Toughness causes one wound with no save. Units losing 25% test Panic.</characteristic>
            <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
            <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Lizardmen, printed p. 88</characteristic>
            <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">Included unique spell</characteristic>
          </characteristics>
        </profile>
        <profile id="da35-3438-3768-04b2" name="Part the Waters" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7839-e5ae-5fb9-1604" page="88">
          <characteristics>
            <characteristic name="Lore" typeId="d783-9c87-2677-5247">Lord Mazdamundi — unique spell</characteristic>
            <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">1</characteristic>
            <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">Any water feature</characteristic>
            <characteristic name="Effect" typeId="d107-f119-4175-3647">Create a dry causeway wide enough for four Saurus, a Stegadon or palanquin, with unlimited length. Lasts all battle and cannot be dispelled.</characteristic>
            <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
            <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Lizardmen, printed p. 88</characteristic>
            <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">Included unique spell</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <constraints>
        <constraint id="201e-eb2f-a8f3-8064" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
        <constraint id="ced2-62a1-045a-8b69" type="max" value="1" scope="roster" field="selections" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" />
        <constraint id="46ca-b687-6a41-f4ab" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
        <constraint id="fb4b-3abf-4414-2dd0" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
      </constraints>
      <rules>
        <rule id="9193-7070-088d-490a" name="Special character" hidden="false">
          <description>Unique named selection. 900 points includes the complete listed fixed equipment, companions, powers and mounts; only separately offered options add points. Printed profiles are before magic-item bonuses unless a rule says they are already included. Special-character use requires the players’ agreement under the books’ convention.</description>
        </rule>
        <rule id="8f2a-9347-9bb6-c735" name="Included equipment" hidden="false">
          <description>Cobra Mace; palanquin on Stegadon.</description>
        </rule>
        <rule id="ed9c-1a5a-4921-e580" name="Slann telepathy" hidden="false" publicationId="7839-e5ae-5fb9-1604" page="87–89">
          <description>At each Lizardman magic phase start, may borrow one spell from another Slann. Return it after its effect ends, it is dispelled, or if unused that turn. May hold only one borrowed spell at a time. Reference: Lizardmen, printed p. 87–89.</description>
        </rule>
        <rule id="9c4a-b3f2-970a-63cc" name="Stegadon and Shield of the Old Ones" hidden="false" publicationId="7839-e5ae-5fb9-1604" page="87–89">
          <description>One combined profile for Mazdamundi, palanquin and Stegadon. Special save 4+ against each wound. Charging causes D6 automatic Strength 5 impact hits, resolved first. For each incoming hit, roll D6: on 1 it strikes the bony shield and is ignored. Reference: Lizardmen, printed p. 87–89.</description>
        </rule>
        <rule id="4f2b-4722-ba99-948f" name="Magic and spell allocation" hidden="false">
          <description>Magic level 4; 4 spells. Printed spell count already includes fixed bloodline effects; do not add those bonuses again. Uses the four unique spells printed below.</description>
        </rule>
      </rules>
