        <infoLink id="0929-4878-7df9-7457" name="Counter magic and natural dispels" targetId="a2e7-268a-edde-1495" type="rule" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="10–14" />
        <infoLink id="6788-c19d-73bb-d94a" name="Winds of Magic special cards" targetId="0d22-3d38-e047-8557" type="rule" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="9–10" />
        <infoLink id="5d2e-885d-9787-146b" name="Spells remaining in play" targetId="b403-7328-b3ca-4dd7" type="rule" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="11–14" />
        <infoLink id="972b-e9ea-93c3-b927" name="Spell targets, sight and templates" targetId="34de-d976-f1cf-5402" type="rule" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="12, 22" />
      </infoLinks>
