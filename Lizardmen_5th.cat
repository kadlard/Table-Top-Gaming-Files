        <rule id="92a9-8174-4f58-d5b6" name="Army-list note" hidden="false">
          <description>Each ordinary model carries two Skinks. Champion model price is 20 + 35 for Terradon/second rider + 1 for the champion short bow. Crew standard/musician options await pricing clarification; see coverage notes.</description>
        </rule>
        <rule id="f0aa-d34e-d779-f172" name="Selection allowance" hidden="false">
          <description>1 per Slann General, Additional Slann Mage-Priest unit/character. Count combined qualifying choices.</description>
        </rule>
        <rule id="8e1b-fa0e-a03a-81f5" name="Models and command" hidden="false">
