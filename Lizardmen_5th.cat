            <selectionEntry id="6e96-a3fc-976a-5a59" name="Ride a Stegadon selected in Regiments" type="upgrade" hidden="false" collective="false" import="true" publicationId="7839-e5ae-5fb9-1604" page="74">
              <costs>
                <cost name="pts" typeId="0044-15f1-782b-00ea" value="0" />
              </costs>
              <constraints>
                <constraint id="5d8f-9ec3-5bad-7f39" type="max" value="0" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
              </constraints>
              <rules>
                <rule id="227d-0bf5-399c-3067" name="Army-list note" hidden="false">
                  <description>Select and pay for the Stegadon separately in Regiments (Lizardmen p. 74). This choice records the character riding in its howdah; it does not buy a Stegadon.</description>
                </rule>
              </rules>
              <modifiers>
                <modifier type="set" field="5d8f-9ec3-5bad-7f39" value="1">
                  <conditions>
                    <condition type="atLeast" field="selections" scope="roster" value="1" childId="0f86-c6ce-27ff-4ba2" shared="true" includeChildSelections="true" includeChildForces="false" percentValue="false" />
                  </conditions>
                </modifier>
              </modifiers>
            </selectionEntry>
