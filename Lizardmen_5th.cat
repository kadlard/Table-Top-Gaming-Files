        </rule>
        <rule id="6ab3-777f-36be-1ac8" name="Cold-Blooded Determination" hidden="false" publicationId="7839-e5ae-5fb9-1604" page="82">
          <description>A Saurus unit joined by Lotl-Botl gains +1 combat result. Reference: Lizardmen, printed p. 82.</description>
        </rule>
      </rules>
