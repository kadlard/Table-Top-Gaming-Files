      <rules>
        <rule id="4117-8d1c-946d-1b34" name="Included equipment" hidden="false">
          <description>Hand weapon.</description>
        </rule>
        <rule id="5444-6512-f036-4063" name="Required mobs" hidden="false">
          <description>Requires at least one of: Night Goblins, Squig Hunters, Netters.</description>
        </rule>
        <rule id="8774-b4b8-48eb-0f78" name="Wizard level and spells" hidden="false">
          <description>Magic level 1; 1 spell cards before bloodline/item changes. Those changes, including Forbidden Lore and Nehekhara’s Noble Blood, are applied manually. Normal armour casting restrictions apply unless a specific power overrides them.</description>
        </rule>
      </rules>
