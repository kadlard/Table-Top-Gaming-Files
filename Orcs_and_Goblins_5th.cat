                      </infoLinks>
                      <rules>
                        <rule id="a1d3-8380-64ff-ed65" name="Included equipment" hidden="false">
                          <description>Two crew with hand weapons and light armour; two team animals.</description>
                        </rule>
                        <rule id="4e9a-31d7-cee8-e36e" name="Required mobs" hidden="false">
                          <description>Requires at least one of: Orc Boyz, Orc Arrer Boyz, Orc Big’uns, Orc Boar Boyz, Savage Orcs, Savage Orc Boar Boyz, Black Orcs.</description>
                        </rule>
                        <rule id="1dc7-5167-7672-fe65" name="Character chariot" hidden="false">
                          <description>Chariot and crew are paid within Characters. Check combined chariot-band formation and standard allowances with any separately selected machines. The printed machine includes two crew; record the character on this chariot.</description>
                        </rule>
                      </rules>
                      <modifiers>
                        <modifier type="set" field="b413-362c-7dd2-4cfa" value="-1">
                          <conditions>
                            <condition type="atLeast" field="selections" scope="roster" value="1" childId="775d-1620-ac43-eb65" shared="true" includeChildSelections="true" includeChildForces="false" percentValue="false" />
                          </conditions>
                        </modifier>
                        <modifier type="set" field="b413-362c-7dd2-4cfa" value="-1">
