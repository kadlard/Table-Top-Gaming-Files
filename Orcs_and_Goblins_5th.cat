      <rules>
        <rule id="ff86-7254-3791-9e13" name="Special character" hidden="false">
          <description>Unique named selection. 90 points includes the complete listed fixed equipment, companions, powers and mounts; only separately offered options add points. Printed profiles are before magic-item bonuses unless a rule says they are already included. Special-character use requires the players’ agreement under the books’ convention.</description>
        </rule>
        <rule id="700a-2c2f-e53d-dd14" name="Included equipment" hidden="false">
          <description>Light armour; shield; hand weapon.</description>
        </rule>
        <rule id="06a1-5958-416f-d435" name="Required unit" hidden="false">
          <description>Requires at least one of: Orc Boyz, Orc Arrer Boyz, Orc Big’uns, Orc Boar Boyz.</description>
        </rule>
      </rules>
