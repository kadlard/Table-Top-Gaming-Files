      <rules>
        <rule id="b74c-9f2c-865e-a917" name="Special character" hidden="false">
          <description>Unique named selection. 150 points includes the complete listed fixed equipment, companions, powers and mounts; only separately offered options add points. Printed profiles are before magic-item bonuses unless a rule says they are already included. Special-character use requires the players’ agreement under the books’ convention.</description>
        </rule>
        <rule id="7b01-e40d-ad39-0b6d" name="Included equipment" hidden="false">
          <description>Light armour; two hand weapons.</description>
        </rule>
        <rule id="78c6-3267-6211-b901" name="Immune to Psychology" hidden="false" publicationId="b4e3-1e3f-4601-d0dd" page="98">
          <description>Ignores all psychology; still takes Break tests normally. Reference: Orcs &amp; Goblins, printed p. 98.</description>
        </rule>
        <rule id="e141-b028-29d5-9b0f" name="Required unit" hidden="false">
          <description>Requires at least one of: Black Orcs.</description>
        </rule>
      </rules>
