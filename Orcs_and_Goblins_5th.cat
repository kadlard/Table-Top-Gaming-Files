      <rules>
        <rule id="85b2-c999-9212-e808" name="Included equipment" hidden="false">
          <description>Hand weapon.</description>
        </rule>
        <rule id="e5cc-18e0-ab87-eae9" name="Required mobs" hidden="false">
          <description>Requires at least one of: Orc Boyz, Orc Arrer Boyz, Orc Big’uns, Orc Boar Boyz.</description>
        </rule>
        <rule id="f6de-ba19-2cbd-5b81" name="Wizard level and spells" hidden="false">
          <description>Magic level 2; 2 spell cards before bloodline/item changes. Those changes, including Forbidden Lore and Nehekhara’s Noble Blood, are applied manually. Normal armour casting restrictions apply unless a specific power overrides them.</description>
        </rule>
      </rules>
