        <rule id="dd67-57af-924b-0f54" name="Included equipment" hidden="false">
          <description>Hand weapon.</description>
        </rule>
        <rule id="cb6a-b29e-9fa2-bd67" name="Required mobs" hidden="false">
          <description>Requires at least one of: Night Goblins, Squig Hunters, Netters.</description>
        </rule>
        <rule id="cd4f-7aa7-e51f-9753" name="Wizard level and spells" hidden="false">
          <description>Magic level 2; 2 spell cards before bloodline/item changes. Those changes, including Forbidden Lore and Nehekhara’s Noble Blood, are applied manually. Normal armour casting restrictions apply unless a specific power overrides them.</description>
        </rule>
      </rules>
