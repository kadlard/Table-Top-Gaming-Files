        <infoLink id="6276-5841-0bb0-d8c8" name="Squig Hunters and Cave Squigs" targetId="e4fe-f88f-d71d-394d" type="rule" hidden="false" publicationId="b4e3-1e3f-4601-d0dd" page="74, 91" />
      </infoLinks>
      <rules>
        <rule id="9a49-e40f-7b2d-6571" name="Included equipment" hidden="false">
          <description>Squig prodders.</description>
        </rule>
        <rule id="bff2-e0a6-4366-28c2" name="Army-list note" hidden="false">
          <description>Standard and musician options are deferred until the cost and prodder-team replacement treatment are clarified. The Boss carries a hand weapon, not a prodder.</description>
        </rule>
        <rule id="fa54-02f7-0eec-d628" name="Required mobs" hidden="false">
          <description>Requires at least one of: Night Goblins.</description>
        </rule>
        <rule id="8f6c-bd29-6465-4956" name="Physical model count" hidden="false">
          <description>Each Hunter team is two Goblins. The minimum-five-model check discounts one selection per team, so two teams plus one Squig is five models. Champions count as one.</description>
        </rule>
        <rule id="1d0e-6f08-4342-3f96" name="Models and command" hidden="false">
          <description>Select troopers plus any command; command replaces a trooper. A standard and musician cost twice an equipped trooper; champions use their own profile and price. Whole-unit options charge each affected model automatically. Independent Wight/Wraith champions buy their own equipment and mount.</description>
        </rule>
      </rules>
