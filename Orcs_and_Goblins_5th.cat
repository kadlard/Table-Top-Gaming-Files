              </profiles>
              <infoLinks>
                <infoLink id="d922-64b4-198f-7c3e" name="Chariots" targetId="4aec-6ebc-71f0-fd54" type="rule" hidden="false" publicationId="d7c9-7773-4408-58f6" page="75–77" />
                <infoLink id="8d22-73dd-bd0a-e1e4" name="Ridden monsters and rider loss" targetId="70ef-ea27-1ae3-36d7" type="rule" hidden="false" publicationId="d7c9-7773-4408-58f6" page="68–70" />
              </infoLinks>
              <rules>
                <rule id="b9cd-717f-6115-93f4" name="Included equipment" hidden="false">
                  <description>Two crew with hand weapons and light armour; two team animals.</description>
                </rule>
                <rule id="8be9-e0be-99d4-7af1" name="Required mobs" hidden="false">
                  <description>Requires at least one of: Goblins, Goblin Wolf Riders, Forest Goblins, Forest Goblin Spider Riders, Night Goblins, Squig Hunters, Netters.</description>
                </rule>
                <rule id="d7f9-9f0c-b22b-23a7" name="Character chariot" hidden="false">
                  <description>Chariot and crew are paid within Characters. Check combined chariot-band formation and standard allowances with any separately selected machines. The printed machine includes two crew; record the character on this chariot.</description>
                </rule>
              </rules>
