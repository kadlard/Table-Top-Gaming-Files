      <constraints>
        <constraint id="8bd1-b4ba-8273-e11b" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
        <constraint id="5ae7-ded8-07d3-e455" type="max" value="1" scope="roster" field="selections" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" />
        <constraint id="ef73-1915-116e-4f8e" type="max" value="0" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
        <constraint id="ac25-7294-a5e4-4201" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
      </constraints>
      <rules>
        <rule id="2c61-4e86-dd60-7499" name="Special character" hidden="false">
          <description>Unique named selection. 310 points includes the complete listed fixed equipment, companions, powers and mounts; only separately offered options add points. Printed profiles are before magic-item bonuses unless a rule says they are already included. Special-character use requires the players’ agreement under the books’ convention.</description>
        </rule>
        <rule id="15ff-a34c-00d6-5558" name="Included equipment" hidden="false">
          <description>Hand weapon; light armour; shield; Wyvern.</description>
        </rule>
        <rule id="d01d-f4d8-c988-0923" name="Animosity command" hidden="false" publicationId="b4e3-1e3f-4601-d0dd" page="96">
          <description>Orc and Goblin units within 12 inches ignore animosity. A unit outside this radius at the start of the turn tests normally. Reference: Orcs &amp; Goblins, printed p. 96.</description>
        </rule>
        <rule id="d763-6e75-36b9-2f54" name="Crown of Sorcery" hidden="false" publicationId="b4e3-1e3f-4601-d0dd" page="96">
          <description>May have no magic items. If any are purchased the first must be the Crown of Sorcery; it uses one of his three slots. The 125-point Crown is optional and is not included in 310. Reference: Orcs &amp; Goblins, printed p. 96.</description>
        </rule>
        <rule id="7849-ba08-218b-fc36" name="Crown and spellcasting" hidden="false">
          <description>If the Crown is selected apply its wizard and spell-allocation effects during play; Azhag’s ordinary profile is printed without these changes.</description>
        </rule>
        <rule id="fc20-df0d-85f7-204b" name="Required unit" hidden="false">
          <description>Requires at least one of: Orc Boyz, Orc Arrer Boyz, Orc Big’uns, Orc Boar Boyz.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="20ac-3a90-7516-4694" name="Wyvern abilities" targetId="e529-0ce4-cf2d-383d" type="rule" hidden="false" publicationId="7bde-49a8-e4f5-1832" page="139" />
        <infoLink id="6f38-39ea-426c-be06" name="Flying and being driven off" targetId="f8d8-8222-78f2-a11c" type="rule" hidden="false" publicationId="d7c9-7773-4408-58f6" page="71–74" />
        <infoLink id="cac2-485e-33ac-193d" name="Flying high" targetId="99d7-0426-702a-003b" type="rule" hidden="false" publicationId="d7c9-7773-4408-58f6" page="73–74" />
        <infoLink id="1907-7d3c-7884-b861" name="Terror" targetId="baed-6e1f-98ad-7e00" type="rule" hidden="false" publicationId="d7c9-7773-4408-58f6" page="49" />
