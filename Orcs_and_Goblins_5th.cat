      <rules>
        <rule id="240e-137c-c83c-ba05" name="Included equipment" hidden="false">
          <description>Hand weapon.</description>
        </rule>
        <rule id="f53d-a7c6-7e70-9396" name="Required mobs" hidden="false">
          <description>Requires at least one of: Orc Boyz, Orc Arrer Boyz, Orc Big’uns, Orc Boar Boyz.</description>
        </rule>
        <rule id="50ae-0fa7-9c8d-5403" name="Wizard level and spells" hidden="false">
          <description>Magic level 3; 3 spell cards before bloodline/item changes. Those changes, including Forbidden Lore and Nehekhara’s Noble Blood, are applied manually. Normal armour casting restrictions apply unless a specific power overrides them.</description>
        </rule>
      </rules>
