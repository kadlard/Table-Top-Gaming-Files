        <profile id="4541-e24c-f62a-053d" name="Morgor the Mangler" typeId="b93a-4f1c-9871-3028" typeName="Magic item" hidden="false" publicationId="b4e3-1e3f-4601-d0dd" page="97">
          <characteristics>
            <characteristic name="Type" typeId="7ef9-9797-693d-d937">Magic weapon</characteristic>
            <characteristic name="Effect" typeId="d277-fc43-48d0-6dce">Bearer gains +1 WS, Toughness and Strength and strikes first. Ties for first strike use Initiative, then a roll-off. No mundane armour saves against its hits; magic armour can save.</characteristic>
            <characteristic name="Reference" typeId="2fa3-15cf-fc7d-e42b">Orcs &amp; Goblins, printed p. 97. Card value 125 points, included in the character total.</characteristic>
            <characteristic name="Coverage" typeId="23f7-abf1-238e-1daa">Book-checked summary; fixed loadout</characteristic>
          </characteristics>
        </profile>
      </profiles>
