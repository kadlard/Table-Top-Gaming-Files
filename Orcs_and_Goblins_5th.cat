      <rules>
        <rule id="1c57-478c-3ecb-faaf" name="Included equipment" hidden="false">
          <description>Hand weapon.</description>
        </rule>
        <rule id="4568-24bb-570b-062c" name="Required mobs" hidden="false">
          <description>Requires at least one of: Orc Boyz, Orc Arrer Boyz, Orc Big’uns, Orc Boar Boyz.</description>
        </rule>
        <rule id="a860-0327-4c30-fa23" name="Wizard level and spells" hidden="false">
          <description>Magic level 1; 1 spell cards before bloodline/item changes. Those changes, including Forbidden Lore and Nehekhara’s Noble Blood, are applied manually. Normal armour casting restrictions apply unless a specific power overrides them.</description>
        </rule>
      </rules>
