                <infoLink id="f14e-d866-3b13-994d" name="Chariots" targetId="4aec-6ebc-71f0-fd54" type="rule" hidden="false" publicationId="d7c9-7773-4408-58f6" page="75–77" />
                <infoLink id="e79f-f84e-2cd2-8f39" name="Ridden monsters and rider loss" targetId="70ef-ea27-1ae3-36d7" type="rule" hidden="false" publicationId="d7c9-7773-4408-58f6" page="68–70" />
              </infoLinks>
              <rules>
                <rule id="c7b7-eed7-a3f1-ff81" name="Included equipment" hidden="false">
                  <description>Two crew with hand weapons and light armour; two team animals.</description>
                </rule>
                <rule id="28a7-87bb-ab8d-c1b5" name="Required mobs" hidden="false">
                  <description>Requires at least one of: Goblins, Goblin Wolf Riders, Forest Goblins, Forest Goblin Spider Riders, Night Goblins, Squig Hunters, Netters.</description>
                </rule>
                <rule id="7e57-f8de-1fd0-dd90" name="Character chariot" hidden="false">
                  <description>Chariot and crew are paid within Characters. Check combined chariot-band formation and standard allowances with any separately selected machines. The printed machine includes two crew; record the character on this chariot.</description>
                </rule>
              </rules>
