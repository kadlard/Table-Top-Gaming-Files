                        <infoLink id="af8d-06af-bff4-9694" name="Chariots" targetId="4aec-6ebc-71f0-fd54" type="rule" hidden="false" publicationId="d7c9-7773-4408-58f6" page="75–77" />
                        <infoLink id="c7a4-1b11-d3d4-a5aa" name="Ridden monsters and rider loss" targetId="70ef-ea27-1ae3-36d7" type="rule" hidden="false" publicationId="d7c9-7773-4408-58f6" page="68–70" />
                      </infoLinks>
                      <rules>
                        <rule id="8f03-c367-d41d-1836" name="Included equipment" hidden="false">
                          <description>Two crew with hand weapons and light armour; two team animals.</description>
                        </rule>
                        <rule id="5fe3-6a14-c60d-2b59" name="Required mobs" hidden="false">
                          <description>Requires at least one of: Goblins, Goblin Wolf Riders, Forest Goblins, Forest Goblin Spider Riders, Night Goblins, Squig Hunters, Netters.</description>
                        </rule>
                        <rule id="6da9-acf6-c31d-7a6b" name="Character chariot" hidden="false">
                          <description>Chariot and crew are paid within Characters. Check combined chariot-band formation and standard allowances with any separately selected machines. The printed machine includes two crew; record the character on this chariot.</description>
                        </rule>
                      </rules>
