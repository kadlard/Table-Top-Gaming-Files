                <infoLink id="6c6d-c4e0-9ec1-da8c" name="Ridden monsters and rider loss" targetId="70ef-ea27-1ae3-36d7" type="rule" hidden="false" publicationId="d7c9-7773-4408-58f6" page="68–70" />
              </infoLinks>
              <rules>
                <rule id="be8a-f566-9fb5-e2d6" name="Included equipment" hidden="false">
                  <description>Two crew with hand weapons and light armour; two team animals.</description>
                </rule>
                <rule id="39ff-cb6e-f85f-51d1" name="Required mobs" hidden="false">
                  <description>Requires at least one of: Goblins, Goblin Wolf Riders, Forest Goblins, Forest Goblin Spider Riders, Night Goblins, Squig Hunters, Netters.</description>
                </rule>
                <rule id="b65a-9665-ebdb-2b53" name="Character chariot" hidden="false">
                  <description>Chariot and crew are paid within Characters. Check combined chariot-band formation and standard allowances with any separately selected machines. The printed machine includes two crew; record the character on this chariot.</description>
                </rule>
              </rules>
