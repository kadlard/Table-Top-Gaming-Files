                      <infoLinks>
                        <infoLink id="e1f9-8e10-5cca-49c4" name="Chariots" targetId="4aec-6ebc-71f0-fd54" type="rule" hidden="false" publicationId="d7c9-7773-4408-58f6" page="75–77" />
                        <infoLink id="527e-644e-259e-1bc4" name="Ridden monsters and rider loss" targetId="70ef-ea27-1ae3-36d7" type="rule" hidden="false" publicationId="d7c9-7773-4408-58f6" page="68–70" />
                      </infoLinks>
                      <rules>
                        <rule id="66f9-0a71-71ec-efbc" name="Included equipment" hidden="false">
                          <description>Two crew with hand weapons and light armour; two team animals.</description>
                        </rule>
                        <rule id="4f0f-1fd5-f8a5-bde2" name="Required mobs" hidden="false">
                          <description>Requires at least one of: Goblins, Goblin Wolf Riders, Forest Goblins, Forest Goblin Spider Riders, Night Goblins, Squig Hunters, Netters.</description>
                        </rule>
                        <rule id="eecc-bfdd-370a-78b9" name="Character chariot" hidden="false">
                          <description>Chariot and crew are paid within Characters. Check combined chariot-band formation and standard allowances with any separately selected machines. The printed machine includes two crew; record the character on this chariot.</description>
                        </rule>
                      </rules>
