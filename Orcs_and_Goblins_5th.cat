              <infoLinks>
                <infoLink id="8e6e-35fa-53ed-47f1" name="Chariots" targetId="4aec-6ebc-71f0-fd54" type="rule" hidden="false" publicationId="d7c9-7773-4408-58f6" page="75–77" />
                <infoLink id="2b81-c0a4-ac33-1343" name="Ridden monsters and rider loss" targetId="70ef-ea27-1ae3-36d7" type="rule" hidden="false" publicationId="d7c9-7773-4408-58f6" page="68–70" />
              </infoLinks>
              <rules>
                <rule id="1d74-198c-9c0d-1f86" name="Included equipment" hidden="false">
                  <description>Two crew with hand weapons and light armour; two team animals.</description>
                </rule>
                <rule id="7f19-f1b9-9269-cc56" name="Required mobs" hidden="false">
                  <description>Requires at least one of: Goblins, Goblin Wolf Riders, Forest Goblins, Forest Goblin Spider Riders, Night Goblins, Squig Hunters, Netters.</description>
                </rule>
                <rule id="5173-2e04-4878-81fb" name="Character chariot" hidden="false">
                  <description>Chariot and crew are paid within Characters. Check combined chariot-band formation and standard allowances with any separately selected machines. The printed machine includes two crew; record the character on this chariot.</description>
                </rule>
              </rules>
