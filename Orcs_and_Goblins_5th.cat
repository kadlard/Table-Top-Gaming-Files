      </categoryLinks>
      <profiles>
        <profile id="69bb-932f-123b-aca1" name="Skarsnik with Gobbla" typeId="e25d-f63f-8d67-4bda" typeName="Unit" hidden="false" publicationId="b4e3-1e3f-4601-d0dd" page="99">
          <characteristics>
            <characteristic name="M" typeId="df0b-cf43-1955-6845">4</characteristic>
