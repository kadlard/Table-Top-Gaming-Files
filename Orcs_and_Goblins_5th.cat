                    <characteristic name="Ld" typeId="cedc-6339-9f57-49bd">3</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <infoLinks>
                <infoLink id="39d2-5169-63f2-74af" name="Chariots" targetId="4aec-6ebc-71f0-fd54" type="rule" hidden="false" publicationId="d7c9-7773-4408-58f6" page="75–77" />
                <infoLink id="05f2-2ef5-7338-8640" name="Ridden monsters and rider loss" targetId="70ef-ea27-1ae3-36d7" type="rule" hidden="false" publicationId="d7c9-7773-4408-58f6" page="68–70" />
              </infoLinks>
              <rules>
                <rule id="99f3-d410-edaf-deb4" name="Included equipment" hidden="false">
                  <description>Two crew with hand weapons and light armour; two team animals.</description>
                </rule>
                <rule id="c749-b406-60d4-64e4" name="Required mobs" hidden="false">
                  <description>Requires at least one of: Goblins, Goblin Wolf Riders, Forest Goblins, Forest Goblin Spider Riders, Night Goblins, Squig Hunters, Netters.</description>
                </rule>
                <rule id="0804-5bb0-0b82-8a7c" name="Character chariot" hidden="false">
                  <description>Chariot and crew are paid within Characters. Check combined chariot-band formation and standard allowances with any separately selected machines. The printed machine includes two crew; record the character on this chariot.</description>
                </rule>
              </rules>
