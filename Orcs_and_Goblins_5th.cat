                      <infoLinks>
                        <infoLink id="edc4-58fe-fcd4-a9ee" name="Chariots" targetId="4aec-6ebc-71f0-fd54" type="rule" hidden="false" publicationId="d7c9-7773-4408-58f6" page="75–77" />
                        <infoLink id="e632-8e33-ac09-3a20" name="Ridden monsters and rider loss" targetId="70ef-ea27-1ae3-36d7" type="rule" hidden="false" publicationId="d7c9-7773-4408-58f6" page="68–70" />
                      </infoLinks>
                      <rules>
                        <rule id="aa1d-5757-2cc5-e540" name="Included equipment" hidden="false">
                          <description>Two crew with hand weapons and light armour; two team animals.</description>
                        </rule>
                        <rule id="caef-dfa3-bb91-bda2" name="Required mobs" hidden="false">
                          <description>Requires at least one of: Goblins, Goblin Wolf Riders, Forest Goblins, Forest Goblin Spider Riders, Night Goblins, Squig Hunters, Netters.</description>
                        </rule>
                        <rule id="b03a-25c9-0782-acdf" name="Character chariot" hidden="false">
                          <description>Chariot and crew are paid within Characters. Check combined chariot-band formation and standard allowances with any separately selected machines. The printed machine includes two crew; record the character on this chariot.</description>
                        </rule>
                      </rules>
