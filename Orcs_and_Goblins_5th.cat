            <characteristic name="I" typeId="946e-86c4-ffce-c3ed">6</characteristic>
            <characteristic name="A" typeId="4cc5-d3f5-26a7-37c2">4</characteristic>
            <characteristic name="Ld" typeId="cedc-6339-9f57-49bd">9</characteristic>
          </characteristics>
        </profile>
        <profile id="93e0-c59e-a867-ef41" name="Gobbla" typeId="e25d-f63f-8d67-4bda" typeName="Unit" hidden="false" publicationId="b4e3-1e3f-4601-d0dd" page="99">
          <characteristics>
            <characteristic name="M" typeId="df0b-cf43-1955-6845">-</characteristic>
            <characteristic name="WS" typeId="c83c-b081-d246-d5ef">6</characteristic>
            <characteristic name="BS" typeId="960a-0c90-a448-96b4">0</characteristic>
            <characteristic name="S" typeId="639b-d234-7e46-084b">6</characteristic>
            <characteristic name="T" typeId="6a8e-5ca4-9d4e-d596">4</characteristic>
            <characteristic name="W" typeId="8a8d-ce29-476c-e0fa">3</characteristic>
            <characteristic name="I" typeId="946e-86c4-ffce-c3ed">6</characteristic>
            <characteristic name="A" typeId="4cc5-d3f5-26a7-37c2">4</characteristic>
            <characteristic name="Ld" typeId="cedc-6339-9f57-49bd">2</characteristic>
          </characteristics>
        </profile>
        <profile id="727c-1190-52c3-d490" name="Skarsnik’s Prodder" typeId="b93a-4f1c-9871-3028" typeName="Magic item" hidden="false" publicationId="b4e3-1e3f-4601-d0dd" page="99">
          <characteristics>
            <characteristic name="Type" typeId="7ef9-9797-693d-d937">Bound spell</characteristic>
            <characteristic name="Effect" typeId="d277-fc43-48d0-6dce">Fires a 24-inch line-of-sight S4 blast, with no armour saves, at the first model in its path. One blast per qualifying mob within 12 inches (at least ten Orcs or twenty Goblins), with another blast for each such mob in combat. Also gives +1 Strength in melee (Orcs &amp; Goblins p. 101).</characteristic>
            <characteristic name="Reference" typeId="2fa3-15cf-fc7d-e42b">Orcs &amp; Goblins, printed p. 99. Card value 75 points, included in the character total.</characteristic>
            <characteristic name="Coverage" typeId="23f7-abf1-238e-1daa">Book-checked summary; fixed loadout</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <constraints>
        <constraint id="4a8a-4146-f50e-ebc0" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
        <constraint id="8706-6cf2-6be2-6828" type="max" value="1" scope="roster" field="selections" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" />
        <constraint id="1715-b31b-9435-3330" type="max" value="0" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
        <constraint id="6172-5567-0a7e-60bc" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
      </constraints>
      <rules>
        <rule id="eae4-5539-8a9f-e729" name="Special character" hidden="false">
          <description>Unique named selection. 205 points includes the complete listed fixed equipment, companions, powers and mounts; only separately offered options add points. Printed profiles are before magic-item bonuses unless a rule says they are already included. Special-character use requires the players’ agreement under the books’ convention.</description>
        </rule>
        <rule id="626d-5314-82d1-71c1" name="Included equipment" hidden="false">
          <description>Light armour; Skarsnik’s Prodder.</description>
        </rule>
        <rule id="e83b-cfb8-477f-6c9f" name="Warlord interpretation" hidden="false" publicationId="b4e3-1e3f-4601-d0dd" page="99">
          <description>The book identifies Skarsnik as a Night Goblin Warlord but omits the explicit replacement sentence used for other named Warlords. This catalogue treats him as the General, with the normal Night Goblin mob requirement. Reference: Orcs &amp; Goblins, printed p. 99.</description>
        </rule>
        <rule id="64e8-7720-174d-fb08" name="Gobbla" hidden="false" publicationId="b4e3-1e3f-4601-d0dd" page="99">
          <description>Included for 50 points. Moves with Skarsnik, shares his psychology, and attacks enemies in contact. If no enemy is touching but friends are, roll at combat start: on 6 attack those friends; they do not Break from it. Missile hits: 1–3 Skarsnik, 4–6 Gobbla. On Skarsnik’s death use Monster Reaction; Gobbla moves 2D6, ignores psychology/Leadership and cannot break. Do not use ordinary wild Squig rules. Reference: Orcs &amp; Goblins, printed p. 99.</description>
        </rule>
        <rule id="eb8a-0c3c-53b5-d287" name="Required unit" hidden="false">
          <description>Requires at least one of: Night Goblins, Squig Hunters, Netters.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="4b2a-796d-937f-030c" name="Night Goblin hatred" targetId="0e36-5197-08fa-a5ee" type="rule" hidden="false" publicationId="b4e3-1e3f-4601-d0dd" page="71" />
        <infoLink id="346b-df24-4aa7-bdad" name="Goblins fear Elves" targetId="2b29-36e2-2d63-3823" type="rule" hidden="false" publicationId="b4e3-1e3f-4601-d0dd" page="70–71, 77" />
        <infoLink id="59e2-2e43-458d-75b9" name="Armour, shield and barding" targetId="1d9b-1051-0031-be6d" type="rule" hidden="false" publicationId="d7c9-7773-4408-58f6" page="15, 30, 37" />
