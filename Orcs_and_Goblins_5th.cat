        <selectionEntryGroup id="8540-1ee8-3bce-f207" name="Magic lore" hidden="false" collective="false" import="true" defaultSelectionEntryId="d785-932b-a02f-556e">
          <constraints>
            <constraint id="31cf-4976-8e9e-78a4" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
            <constraint id="2109-378c-b447-306a" type="min" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <selectionEntries>
            <selectionEntry id="d785-932b-a02f-556e" name="Waaagh Magic" type="upgrade" hidden="false" collective="false" import="true">
              <costs>
                <cost name="pts" typeId="0044-15f1-782b-00ea" value="0" />
              </costs>
              <constraints>
                <constraint id="200d-6372-5d76-28ad" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
              </constraints>
              <profiles>
                <profile id="c06b-5b58-6a09-a426" name="Waaaaaagh!" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="23">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Waaagh Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">3</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">36 inches</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">Enemy wizards in range roll D6 no greater than their magic level or suffer one wound. Friendly Orc/Goblin units in range gain +1 WS and may re-roll Leadership tests until the next magic phase begins.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 23</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                  </characteristics>
                </profile>
                <profile id="586c-86af-5699-1404" name="Mork Wants Ya!" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="23">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Waaagh Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">1</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">24 inches</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">Lift one enemy model so it can do nothing except try to escape at the start of each turn. Escape on 2D6 no greater than Strength; on landing suffer one S4 hit. Grab an entire composite model and use its highest Strength for escape.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Remains in play</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 23</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                  </characteristics>
                </profile>
                <profile id="ab56-cb30-a474-df9e" name="Brain Bursta" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="23">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Waaagh Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">2</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">24 inches</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">A straight bolt hits the first model in its path. It must roll D6 no greater than Toughness or die outright. No armour or wound-based special save can prevent the outright kill. Line of sight required.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 23</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                  </characteristics>
                </profile>
                <profile id="f034-3615-c992-3a48" name="Fists of Gork" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="23">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Waaagh Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">2</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">Close combat</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">Inflict D6 S6 hits among the caster's melee opponents. Each roll of 6 adds another D6 hits; continue while sixes are rolled.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 23</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                  </characteristics>
                </profile>
                <profile id="b518-aecf-d11a-f9d0" name="Gaze of Mork" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="23">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Waaagh Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">2</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">24 inches</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">A straight beam causes one S4 hit on every model along its 24-inch path. Characters may use Look Out Sir as for a cannon shot.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 23</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                  </characteristics>
                </profile>
                <profile id="d0d9-8943-63db-045e" name="’Ere We Go!" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="23">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Waaagh Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">2</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">36 inches</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">One Orc/Goblin unit gains +1 Toughness and strikes first in melee, even if charged, until your next magic phase.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 23</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                  </characteristics>
                </profile>
                <profile id="1161-513e-24c9-1786" name="Da Krunch" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="23">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Waaagh Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">3</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">24 inches</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">Place the dedicated foot template. A scatter HIT keeps it in place; an arrow moves it D6 inches. Models more than half covered suffer S10 hits.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 23</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                  </characteristics>
                </profile>
                <profile id="136a-7195-565b-2cb3" name="The Hand of Gork" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="23">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Waaagh Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">2</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">18 inches</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">Transport an Orc/Goblin unit up to 18 inches. It may enter melee and counts as charging.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 23</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                  </characteristics>
                </profile>
                <profile id="1b29-4f20-0cdc-c214" name="Mork Save Uz!" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="23">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Waaagh Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">1</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">24 inches</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">One Orc/Goblin unit ignores friendly and enemy magic until your next magic phase. Dispel effects already on it. Later persistent spells are not themselves destroyed, so may take effect if this protection is dispelled.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 23</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                  </characteristics>
                </profile>
                <profile id="8aeb-2c4c-f795-95de" name="’Eadbutt" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="23">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Waaagh Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">1</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">36 inches</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">Target an enemy wizard; each side rolls D6 plus magic level. If the enemy loses it suffers one wound. If no wizard is in range, target another enemy model instead.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 23</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule id="9c2d-7058-06ee-3a67" name="Spell deck reference" hidden="false">
                  <description>Entire reference deck, not spells known. Draw/choose the permitted number before battle; record them in roster notes. Necromancy uses chosen spells and High Magic its special dealing rules.</description>
                </rule>
              </rules>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
