                      <infoLinks>
                        <infoLink id="d253-885f-fc32-24ff" name="Chariots" targetId="4aec-6ebc-71f0-fd54" type="rule" hidden="false" publicationId="d7c9-7773-4408-58f6" page="75–77" />
                        <infoLink id="9bb2-09df-8f3b-1811" name="Ridden monsters and rider loss" targetId="70ef-ea27-1ae3-36d7" type="rule" hidden="false" publicationId="d7c9-7773-4408-58f6" page="68–70" />
                      </infoLinks>
                      <rules>
                        <rule id="527f-f242-48d0-cba4" name="Included equipment" hidden="false">
                          <description>Two crew with hand weapons and light armour; two team animals.</description>
                        </rule>
                        <rule id="86ea-9371-a1e7-e78e" name="Required mobs" hidden="false">
                          <description>Requires at least one of: Goblins, Goblin Wolf Riders, Forest Goblins, Forest Goblin Spider Riders, Night Goblins, Squig Hunters, Netters.</description>
                        </rule>
                        <rule id="a0cb-90df-5356-faa0" name="Character chariot" hidden="false">
                          <description>Chariot and crew are paid within Characters. Check combined chariot-band formation and standard allowances with any separately selected machines. The printed machine includes two crew; record the character on this chariot.</description>
                        </rule>
                      </rules>
