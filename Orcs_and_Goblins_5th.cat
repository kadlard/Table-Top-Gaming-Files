      <rules>
        <rule id="1f31-3d85-4dea-38ab" name="Special character" hidden="false">
          <description>Unique named selection. 245 points includes the complete listed fixed equipment, companions, powers and mounts; only separately offered options add points. Printed profiles are before magic-item bonuses unless a rule says they are already included. Special-character use requires the players’ agreement under the books’ convention.</description>
        </rule>
        <rule id="5304-678a-8cb8-0f5a" name="Included equipment" hidden="false">
          <description>Light armour; Morgor the Mangler; War Boar.</description>
        </rule>
        <rule id="8173-8b65-8d3e-30d2" name="Required unit" hidden="false">
          <description>Requires at least one of: Orc Boyz, Orc Arrer Boyz, Orc Big’uns, Orc Boar Boyz.</description>
        </rule>
      </rules>
