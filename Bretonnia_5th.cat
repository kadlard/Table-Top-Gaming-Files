            <characteristic name="Ld" typeId="cedc-6339-9f57-49bd">5</characteristic>
          </characteristics>
        </profile>
        <profile id="8bf2-9a00-f240-e11f" name="Helm of the Dragon Slayer" typeId="b93a-4f1c-9871-3028" typeName="Magic item" hidden="false" publicationId="ef30-8d5f-80e5-af93" page="74">
          <characteristics>
            <characteristic name="Type" typeId="7ef9-9797-693d-d937">Magic armour</characteristic>
            <characteristic name="Effect" typeId="d277-fc43-48d0-6dce">Immune to Dragon breath; does not protect against other breath attacks such as a Hydra’s.</characteristic>
            <characteristic name="Reference" typeId="2fa3-15cf-fc7d-e42b">Bretonnia, printed p. 74. Card value 10 points, included in the character total.</characteristic>
            <characteristic name="Coverage" typeId="23f7-abf1-238e-1daa">Book-checked summary; fixed loadout</characteristic>
          </characteristics>
        </profile>
        <profile id="09e6-3188-9c63-3876" name="Claw of Malgrimace" typeId="b93a-4f1c-9871-3028" typeName="Magic item" hidden="false" publicationId="ef30-8d5f-80e5-af93" page="74">
          <characteristics>
            <characteristic name="Type" typeId="7ef9-9797-693d-d937">Enchanted item</characteristic>
            <characteristic name="Effect" typeId="d277-fc43-48d0-6dce">At the start of combat roll D6; reduce the attacks monsters can make against Jasperre by that total. Split the reduction if two or more monsters attack him.</characteristic>
            <characteristic name="Reference" typeId="2fa3-15cf-fc7d-e42b">Bretonnia, printed p. 74. Card value 50 points, included in the character total.</characteristic>
            <characteristic name="Coverage" typeId="23f7-abf1-238e-1daa">Book-checked summary; fixed loadout</characteristic>
          </characteristics>
        </profile>
        <profile id="cae8-4674-118a-d0c1" name="Virtuous Lance" typeId="b93a-4f1c-9871-3028" typeName="Magic item" hidden="false" publicationId="ef30-8d5f-80e5-af93" page="74">
          <characteristics>
            <characteristic name="Type" typeId="7ef9-9797-693d-d937">Magic weapon</characteristic>
            <characteristic name="Effect" typeId="d277-fc43-48d0-6dce">Normal lance except when charging a large monster: +4 Strength instead of +2 and each unsaved wound becomes D3. After saves and wound multiplication, roll D6 plus wounds caused; on 6+ the monster is slain.</characteristic>
            <characteristic name="Reference" typeId="2fa3-15cf-fc7d-e42b">Bretonnia, printed p. 74. Card value 15 points, included in the character total.</characteristic>
            <characteristic name="Coverage" typeId="23f7-abf1-238e-1daa">Book-checked summary; fixed loadout</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <constraints>
