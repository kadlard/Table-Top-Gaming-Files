  <rules>
    <rule id="73dd-a430-31cb-9cec" name="Army selection" hidden="false">
      <description>Bretonnia p. 59. Characters: max 75%; Knights: min 25%; Commoners: max 50%; Monsters: max 25%; Allies: max 25%. Allies are not yet selectable. Apply percentages to the agreed battle limit; verify the app’s percentage basis and nested champion categories before competitive use.</description>
    </rule>
  </rules>
  <sharedSelectionEntries>
    <selectionEntry id="4e52-454c-825c-7821" name="Louen Leoncoeur, the Lionhearted" type="model" hidden="false" collective="false" import="true" publicationId="ef30-8d5f-80e5-af93" page="67">
