        <profile id="a1bb-08fe-7d2f-eb1a" name="Dolorous Blade" typeId="b93a-4f1c-9871-3028" typeName="Magic item" hidden="false" publicationId="ef30-8d5f-80e5-af93" page="76">
          <characteristics>
            <characteristic name="Type" typeId="7ef9-9797-693d-d937">Magic weapon</characteristic>
            <characteristic name="Effect" typeId="d277-fc43-48d0-6dce">Choose each combat: one attack with no armour save causing D6 wounds, or D6 attacks with normal saves and one wound each.</characteristic>
            <characteristic name="Reference" typeId="2fa3-15cf-fc7d-e42b">Bretonnia, printed p. 76. Card value 70 points, included in the character total.</characteristic>
            <characteristic name="Coverage" typeId="23f7-abf1-238e-1daa">Book-checked summary; fixed loadout</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <constraints>
        <constraint id="3ecf-bd57-0944-77c1" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
        <constraint id="9ea6-7c16-14a6-62cc" type="max" value="1" scope="roster" field="selections" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" />
