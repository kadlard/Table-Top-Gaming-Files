        <profile id="203e-8098-8176-92e7" name="Fleur de Lys Banner" typeId="b93a-4f1c-9871-3028" typeName="Magic item" hidden="false" publicationId="ef30-8d5f-80e5-af93" page="68">
          <characteristics>
            <characteristic name="Type" typeId="7ef9-9797-693d-d937">Magic standard</characteristic>
            <characteristic name="Effect" typeId="d277-fc43-48d0-6dce">Army battle standard. Each magic phase, including the enemy phase, discard one random enemy magic card. If it is Power or Total Power, gain +1 combat result in every combat in the next combat phase. Drain Magic ends the phase immediately; any other card has no further effect.</characteristic>
            <characteristic name="Reference" typeId="2fa3-15cf-fc7d-e42b">Bretonnia, printed p. 68. Card value 100 points, included in the character total.</characteristic>
            <characteristic name="Coverage" typeId="23f7-abf1-238e-1daa">Book-checked summary; fixed loadout</characteristic>
          </characteristics>
        </profile>
        <profile id="ec5f-9840-bc2f-5550" name="Sword of Lyonesse" typeId="b93a-4f1c-9871-3028" typeName="Magic item" hidden="false" publicationId="ef30-8d5f-80e5-af93" page="68">
          <characteristics>
            <characteristic name="Type" typeId="7ef9-9797-693d-d937">Magic weapon</characteristic>
            <characteristic name="Effect" typeId="d277-fc43-48d0-6dce">Magic items of enemy models touching Repanse cease working, except magic weapons. This disables magical armour and wards.</characteristic>
            <characteristic name="Reference" typeId="2fa3-15cf-fc7d-e42b">Bretonnia, printed p. 68. Card value 50 points, included in the character total.</characteristic>
            <characteristic name="Coverage" typeId="23f7-abf1-238e-1daa">Book-checked summary; fixed loadout</characteristic>
          </characteristics>
        </profile>
      </profiles>
