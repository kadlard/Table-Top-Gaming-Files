            <characteristic name="I" typeId="946e-86c4-ffce-c3ed">6</characteristic>
            <characteristic name="A" typeId="4cc5-d3f5-26a7-37c2">4</characteristic>
            <characteristic name="Ld" typeId="cedc-6339-9f57-49bd">10</characteristic>
          </characteristics>
        </profile>
        <profile id="83e8-28ef-5546-1163" name="Hippogriff" typeId="e25d-f63f-8d67-4bda" typeName="Unit" hidden="false" publicationId="ef30-8d5f-80e5-af93" page="67">
          <characteristics>
            <characteristic name="M" typeId="df0b-cf43-1955-6845">8</characteristic>
            <characteristic name="WS" typeId="c83c-b081-d246-d5ef">5</characteristic>
            <characteristic name="BS" typeId="960a-0c90-a448-96b4">0</characteristic>
            <characteristic name="S" typeId="639b-d234-7e46-084b">6</characteristic>
            <characteristic name="T" typeId="6a8e-5ca4-9d4e-d596">5</characteristic>
            <characteristic name="W" typeId="8a8d-ce29-476c-e0fa">5</characteristic>
            <characteristic name="I" typeId="946e-86c4-ffce-c3ed">6</characteristic>
            <characteristic name="A" typeId="4cc5-d3f5-26a7-37c2">3</characteristic>
            <characteristic name="Ld" typeId="cedc-6339-9f57-49bd">8</characteristic>
          </characteristics>
        </profile>
        <profile id="dd67-18fb-0630-1b82" name="Crown of Bretonnia" typeId="b93a-4f1c-9871-3028" typeName="Magic item" hidden="false" publicationId="ef30-8d5f-80e5-af93" page="67">
          <characteristics>
            <characteristic name="Type" typeId="7ef9-9797-693d-d937">Enchanted item</characteristic>
            <characteristic name="Effect" typeId="d277-fc43-48d0-6dce">Before battle, choose a characteristic to increase by 1 and roll 5+. On failure choose another and try 4+, then 3+, then 2+; the fifth choice succeeds automatically. Respect characteristic maxima, normally 10. Record the result in roster notes.</characteristic>
            <characteristic name="Reference" typeId="2fa3-15cf-fc7d-e42b">Bretonnia, printed p. 67. Card value 15 points, included in the character total.</characteristic>
            <characteristic name="Coverage" typeId="23f7-abf1-238e-1daa">Book-checked summary; fixed loadout</characteristic>
          </characteristics>
        </profile>
        <profile id="7d8a-4922-f72b-7677" name="Armour of Brilliance" typeId="b93a-4f1c-9871-3028" typeName="Magic item" hidden="false" publicationId="ef30-8d5f-80e5-af93" page="67">
          <characteristics>
            <characteristic name="Type" typeId="7ef9-9797-693d-d937">Magic armour</characteristic>
            <characteristic name="Effect" typeId="d277-fc43-48d0-6dce">Armour and shield together provide a 3+ armour save. Enemies suffer -2 to hit the wearer.</characteristic>
            <characteristic name="Reference" typeId="2fa3-15cf-fc7d-e42b">Bretonnia, printed p. 67. Card value 75 points, included in the character total.</characteristic>
            <characteristic name="Coverage" typeId="23f7-abf1-238e-1daa">Book-checked summary; fixed loadout</characteristic>
          </characteristics>
        </profile>
        <profile id="6f4e-80da-910b-d302" name="Lion Lance" typeId="b93a-4f1c-9871-3028" typeName="Magic item" hidden="false" publicationId="ef30-8d5f-80e5-af93" page="67">
          <characteristics>
            <characteristic name="Type" typeId="7ef9-9797-693d-d937">Magic weapon</characteristic>
            <characteristic name="Effect" typeId="d277-fc43-48d0-6dce">Charging only: +2 Strength. A model hit but not killed takes one further Strength 6 hit.</characteristic>
            <characteristic name="Reference" typeId="2fa3-15cf-fc7d-e42b">Bretonnia, printed p. 67. Card value 30 points, included in the character total.</characteristic>
            <characteristic name="Coverage" typeId="23f7-abf1-238e-1daa">Book-checked summary; fixed loadout</characteristic>
          </characteristics>
        </profile>
        <profile id="e69d-ff8b-4a43-9c04" name="Tabard of Kings" typeId="b93a-4f1c-9871-3028" typeName="Magic item" hidden="false" publicationId="ef30-8d5f-80e5-af93" page="67">
          <characteristics>
            <characteristic name="Type" typeId="7ef9-9797-693d-d937">Enchanted item</characteristic>
            <characteristic name="Effect" typeId="d277-fc43-48d0-6dce">Before an undispelled harmful spell affects Louen, its caster (or the user of the casting item) suffers D3 wounds with no saves of any kind. If this kills the caster, the spell fails.</characteristic>
            <characteristic name="Reference" typeId="2fa3-15cf-fc7d-e42b">Bretonnia, printed p. 67. Card value 75 points, included in the character total.</characteristic>
            <characteristic name="Coverage" typeId="23f7-abf1-238e-1daa">Book-checked summary; fixed loadout</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <constraints>
        <constraint id="8a60-f2a7-0c87-35a5" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
        <constraint id="c815-c805-d45b-7192" type="max" value="1" scope="roster" field="selections" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" />
        <constraint id="efae-f7ff-cfdf-6412" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
      </constraints>
      <rules>
        <rule id="3240-3507-2743-0cdb" name="Special character" hidden="false">
          <description>Unique named selection. 505 points includes the complete listed fixed equipment, companions, powers and mounts; only separately offered options add points. Printed profiles are before magic-item bonuses unless a rule says they are already included. Special-character use requires the players’ agreement under the books’ convention.</description>
        </rule>
        <rule id="08dd-9fce-a30f-50f3" name="Included equipment" hidden="false">
          <description>Sword; Lion Lance; Armour of Brilliance.</description>
        </rule>
        <rule id="5e9e-b63f-8775-6cb7" name="Virtue of the Lionheart" hidden="false" publicationId="ef30-8d5f-80e5-af93" page="67">
          <description>At the beginning of each close-combat phase roll D3 and add it to Louen’s Strength for that phase. Reference: Bretonnia, printed p. 67.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="34f1-4469-1585-4d6d" name="Grail Virtue" targetId="1af2-7fa8-ecd7-8f00" type="rule" hidden="false" publicationId="ef30-8d5f-80e5-af93" page="48" />
