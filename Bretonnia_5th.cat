      <rules>
        <rule id="a281-0982-92e5-e674" name="Wizard" hidden="false">
          <description>Magic level 1; draw 1 spells before battle. Body armour and shields prevent spellcasting; steed barding does not. Book of Ashur/Crown of Sorcery effects and spell-deck changes require manual application. Warhammer Magic pp. 7–8; Bretonnia p. 61.</description>
        </rule>
      </rules>
