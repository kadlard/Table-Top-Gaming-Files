      </constraints>
      <rules>
        <rule id="4537-5210-35de-2b9b" name="Special character" hidden="false">
          <description>Unique named selection. 265 points includes the complete listed fixed equipment, companions, powers and mounts; only separately offered options add points. Printed profiles are before magic-item bonuses unless a rule says they are already included. Special-character use requires the players’ agreement under the books’ convention.</description>
        </rule>
        <rule id="0d75-cdd8-4217-dba0" name="Included equipment" hidden="false">
          <description>Lance; heavy armour; Blade of Couronne; Grail Shield.</description>
        </rule>
      </rules>
