        <profile id="e822-e75b-0c33-8851" name="Louen Leoncoeur, the Lionhearted" typeId="e25d-f63f-8d67-4bda" typeName="Unit" hidden="false" publicationId="ef30-8d5f-80e5-af93" page="67">
          <characteristics>
