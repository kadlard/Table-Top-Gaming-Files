            <constraint id="aeac-56f5-f95e-7a48" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
          </constraints>
        </selectionEntry>
      </selectionEntries>
      <rules>
        <rule id="5954-2470-1074-9f16" name="Wizard" hidden="false">
          <description>Magic level 4; draw 4 spells before battle. Body armour and shields prevent spellcasting; steed barding does not. Book of Ashur/Crown of Sorcery effects and spell-deck changes require manual application. Warhammer Magic pp. 7–8; Bretonnia p. 61.</description>
        </rule>
      </rules>
    </selectionEntry>
