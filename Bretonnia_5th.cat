      <rules>
        <rule id="921f-4824-b75c-0f46" name="Wizard" hidden="false">
          <description>Magic level 2; draw 2 spells before battle. Body armour and shields prevent spellcasting; steed barding does not. Book of Ashur/Crown of Sorcery effects and spell-deck changes require manual application. Warhammer Magic pp. 7–8; Bretonnia p. 61.</description>
        </rule>
      </rules>
