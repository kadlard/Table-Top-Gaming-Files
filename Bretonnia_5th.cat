      <rules>
        <rule id="5954-2470-1074-9f16" name="Wizard" hidden="false">
          <description>Magic level 4; normally receive 4 spells before battle. High Magic uses its own draw-and-discard procedure. Body armour and shields prevent spellcasting; steed barding does not. Book of Ashur/Crown of Sorcery effects and spell-deck changes require manual application. Warhammer Magic pp. 7–8, 18; Bretonnia p. 61.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry id="2c8f-813b-acc1-bf11" name="Grail Knights" type="unit" hidden="false" collective="false" import="true" publicationId="ef30-8d5f-80e5-af93" page="62">
      <categoryLinks>
        <categoryLink id="81e2-6e77-e11d-6dde" name="Knights" targetId="5e16-1480-9f35-be07" primary="true" hidden="false" />
