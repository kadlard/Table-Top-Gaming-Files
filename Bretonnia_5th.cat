      <rules>
        <rule id="5e32-4593-823e-1562" name="Model count" hidden="false">
          <description>Models includes troopers, standard bearer, musician and champion. Command models replace troopers; they do not upgrade a model already counted. Whole-unit options automatically charge every model; champions pay character equipment rates.</description>
        </rule>
      </rules>
    </selectionEntry>
