            <selectionEntry id="d320-d837-d2d4-60b8" name="Chariot" type="upgrade" hidden="false" collective="false" import="true">
              <costs>
                <cost name="pts" typeId="0044-15f1-782b-00ea" value="76" />
              </costs>
              <constraints>
                <constraint id="9fee-4f9b-d302-4fbe" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
              </constraints>
              <infoLinks>
                <infoLink id="b117-2be4-9c25-1385" name="Chariots" targetId="4aec-6ebc-71f0-fd54" type="rule" hidden="false" publicationId="d7c9-7773-4408-58f6" page="75–77" />
              </infoLinks>
              <rules>
                <rule id="c69d-d339-4b4a-7afd" name="Wood Elf chariot movement" hidden="false">
                  <description>Chariots do not benefit from the Wood Elf ability to ignore woodland movement penalties. Wood Elves p. 66.</description>
                </rule>
                <rule id="9987-4663-f492-ecec" name="Chariot impact Strength" hidden="false">
                  <description>The Wood Elf chariot profile prints a dash for Strength (Wood Elves p. 66). The core chariot rule gives Strength 7 in most cases (Rulebook p. 77). Use that core value for impact hits unless an agreed clarification says otherwise; the displayed army-book profile is preserved.</description>
                </rule>
                <rule id="b773-cb9a-da56-10a5" name="Chariot equipment" hidden="false">
                  <description>76 points includes two crew with hand weapons/light armour and two steeds. Crew upgrades are paid per crewman. A character replaces the optional third crewman. See Wood Elves p. 66. Chariot magic standards are pending, to avoid a duplicate army-wide allowance across mounts and units.</description>
                </rule>
              </rules>
              <profiles>
                <profile id="d9b2-755d-0eb3-4f68" name="Chariot" typeId="e25d-f63f-8d67-4bda" typeName="Unit" hidden="false" publicationId="2e06-8dc0-e774-819f" page="66">
