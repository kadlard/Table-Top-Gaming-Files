      </costs>
      <categoryLinks>
        <categoryLink id="7dd6-2c3a-a018-710a" name="Characters" targetId="0114-02b1-a20d-82f1" primary="true" hidden="false" />
      </categoryLinks>
      <profiles>
        <profile id="f896-1273-a402-699f" name="Skaw the Falconer" typeId="e25d-f63f-8d67-4bda" typeName="Unit" hidden="false" publicationId="2e06-8dc0-e774-819f" page="79">
          <characteristics>
            <characteristic name="M" typeId="df0b-cf43-1955-6845">5</characteristic>
            <characteristic name="WS" typeId="c83c-b081-d246-d5ef">5</characteristic>
            <characteristic name="BS" typeId="960a-0c90-a448-96b4">5</characteristic>
            <characteristic name="S" typeId="639b-d234-7e46-084b">4</characteristic>
            <characteristic name="T" typeId="6a8e-5ca4-9d4e-d596">3</characteristic>
            <characteristic name="W" typeId="8a8d-ce29-476c-e0fa">1</characteristic>
            <characteristic name="I" typeId="946e-86c4-ffce-c3ed">7</characteristic>
            <characteristic name="A" typeId="4cc5-d3f5-26a7-37c2">2</characteristic>
            <characteristic name="Ld" typeId="cedc-6339-9f57-49bd">8</characteristic>
          </characteristics>
        </profile>
        <profile id="66de-c29f-0f69-54b6" name="Flail of Claws" typeId="b93a-4f1c-9871-3028" typeName="Magic item" hidden="false" publicationId="2e06-8dc0-e774-819f" page="79">
          <characteristics>
            <characteristic name="Type" typeId="7ef9-9797-693d-d937">Magic weapon</characteristic>
            <characteristic name="Effect" typeId="d277-fc43-48d0-6dce">No normal flail Strength bonus. Always strikes first regardless of charge or Initiative. An opponent hit but not wounded loses one Attack when striking back.</characteristic>
            <characteristic name="Reference" typeId="2fa3-15cf-fc7d-e42b">Woodelves, printed p. 79. Card value 25 points, included in the character total.</characteristic>
            <characteristic name="Coverage" typeId="23f7-abf1-238e-1daa">Book-checked summary; fixed loadout</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <constraints>
        <constraint id="49ce-a1fb-06a5-0182" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
        <constraint id="53d2-ebf2-5d05-4e62" type="max" value="1" scope="roster" field="selections" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" />
      </constraints>
      <rules>
        <rule id="10cd-f2c8-b2db-5973" name="Special character" hidden="false">
          <description>Unique named selection. 91 points includes the complete listed fixed equipment, companions, powers and mounts; only separately offered options add points. Printed profiles are before magic-item bonuses unless a rule says they are already included. Special-character use requires the players’ agreement under the books’ convention.</description>
        </rule>
        <rule id="8682-e674-444f-1daf" name="Included equipment" hidden="false">
          <description>Hand weapon; three fighting falcons; feather cape (5+ armour).</description>
        </rule>
        <rule id="a9c4-2e6b-14cd-c3b9" name="Three fighting falcons" hidden="false" publicationId="2e06-8dc0-e774-819f" page="79">
          <description>The included falcons cost 15 points. Each attacks at Strength 3: range 24 inches using Skaw’s BS or melee using his WS. Can stand and shoot, pick out characters and ignore cover/skirmisher penalties. Normal armour saves apply. Falcons cannot be harmed; they leave if Skaw dies. Reference: Woodelves, printed p. 79.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="70ef-1956-7392-1c07" name="Woodland movement" targetId="68da-795a-8b40-d237" type="rule" hidden="false" publicationId="2e06-8dc0-e774-819f" page="42" />
        <infoLink id="78c8-9b90-8463-c090" name="Hand weapon" targetId="f660-63e8-377a-579c" type="rule" hidden="false" publicationId="d7c9-7773-4408-58f6" page="54" />
        <infoLink id="813e-2444-4774-0281" name="Champions, characters and challenges" targetId="c172-7f3e-b5a2-05ea" type="rule" hidden="false" publicationId="d7c9-7773-4408-58f6" page="59–67" />
      </infoLinks>
    </selectionEntry>
