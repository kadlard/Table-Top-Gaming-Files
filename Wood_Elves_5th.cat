                    <characteristic name="Ld" typeId="cedc-6339-9f57-49bd">8</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <categoryLinks>
                <categoryLink id="6b5c-6a0b-43bc-b9f2" name="Regiments" targetId="a2b5-2a83-607e-e007" primary="true" hidden="false" />
              </categoryLinks>
              <rules>
                <rule id="9340-b0ab-01a8-a141" name="Included equipment" hidden="false">
                  <description>Natural attacks; shapeshifting; 5+ special save. See Wood Elves p. 69.</description>
                </rule>
              </rules>
            </selectionEntry>
          </selectionEntries>
          <entryLinks>
            <entryLink id="8bbe-9712-cdeb-5ca3" name="Drycha" targetId="637e-fa81-6b01-89e8" type="selectionEntry" hidden="false" collective="false" import="true">
              <categoryLinks>
                <categoryLink id="3706-b455-6828-c852" name="Characters" targetId="0114-02b1-a20d-82f1" primary="true" hidden="false" />
              </categoryLinks>
