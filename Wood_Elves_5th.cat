      <rules>
        <rule id="56d8-0e3c-2f3b-7ec1" name="Wizard" hidden="false">
          <description>Magic level 1; normally receive 1 spells before battle. High Magic uses its own draw-and-discard procedure. Body armour and shields prevent spellcasting; steed barding does not. Book of Ashur/Crown of Sorcery effects and spell-deck changes require manual application. Warhammer Magic pp. 7–8, 18; Wood Elves p. 65.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry id="c27e-6d1b-bb3d-f207" name="Mage Champion" type="model" hidden="false" collective="false" import="true" publicationId="2e06-8dc0-e774-819f" page="65">
      <costs>
        <cost name="pts" typeId="0044-15f1-782b-00ea" value="121" />
      </costs>
      <categoryLinks>
        <categoryLink id="e814-4940-afdb-22a6" name="Characters" targetId="0114-02b1-a20d-82f1" primary="true" hidden="false" />
      </categoryLinks>
      <profiles>
        <profile id="d2f8-955f-2fa0-96c9" name="Mage Champion" typeId="e25d-f63f-8d67-4bda" typeName="Unit" hidden="false" publicationId="2e06-8dc0-e774-819f" page="65">
          <characteristics>
            <characteristic name="M" typeId="df0b-cf43-1955-6845">5</characteristic>
            <characteristic name="WS" typeId="c83c-b081-d246-d5ef">4</characteristic>
            <characteristic name="BS" typeId="960a-0c90-a448-96b4">4</characteristic>
            <characteristic name="S" typeId="639b-d234-7e46-084b">4</characteristic>
            <characteristic name="T" typeId="6a8e-5ca4-9d4e-d596">4</characteristic>
            <characteristic name="W" typeId="8a8d-ce29-476c-e0fa">2</characteristic>
