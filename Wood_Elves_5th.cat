            <selectionEntry id="a15c-09cf-fc1a-2593" name="Chariot" type="upgrade" hidden="false" collective="false" import="true">
              <costs>
                <cost name="pts" typeId="0044-15f1-782b-00ea" value="76" />
              </costs>
              <constraints>
                <constraint id="36c0-b45a-97d5-f9c5" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
              </constraints>
              <infoLinks>
                <infoLink id="4f1a-40ec-e352-9cb6" name="Chariots" targetId="4aec-6ebc-71f0-fd54" type="rule" hidden="false" publicationId="d7c9-7773-4408-58f6" page="75–77" />
              </infoLinks>
              <rules>
                <rule id="fb70-b662-92a1-31a7" name="Wood Elf chariot movement" hidden="false">
                  <description>Chariots do not benefit from the Wood Elf ability to ignore woodland movement penalties. Wood Elves p. 66.</description>
                </rule>
                <rule id="364e-810c-1ae7-f33d" name="Chariot impact Strength" hidden="false">
                  <description>The Wood Elf chariot profile prints a dash for Strength (Wood Elves p. 66). The core chariot rule gives Strength 7 in most cases (Rulebook p. 77). Use that core value for impact hits unless an agreed clarification says otherwise; the displayed army-book profile is preserved.</description>
                </rule>
                <rule id="dfaa-3c9c-e6a3-2be1" name="Chariot equipment" hidden="false">
                  <description>76 points includes two crew with hand weapons/light armour and two steeds. Crew upgrades are paid per crewman. A character replaces the optional third crewman. See Wood Elves p. 66. Chariot magic standards are pending, to avoid a duplicate army-wide allowance across mounts and units.</description>
                </rule>
              </rules>
              <profiles>
                <profile id="8ffe-d735-761f-0d4f" name="Chariot" typeId="e25d-f63f-8d67-4bda" typeName="Unit" hidden="false" publicationId="2e06-8dc0-e774-819f" page="66">
