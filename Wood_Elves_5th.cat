      <rules>
        <rule id="9142-cd08-60a0-aa42" name="Special character" hidden="false">
          <description>Unique named selection. 158 points includes the complete listed fixed equipment, companions, powers and mounts; only separately offered options add points. Printed profiles are before magic-item bonuses unless a rule says they are already included. Special-character use requires the players’ agreement under the books’ convention.</description>
        </rule>
        <rule id="b76f-f534-8a3e-cff8" name="Included equipment" hidden="false">
          <description>Sword; light armour; shield; barded Elven Steed.</description>
        </rule>
      </rules>
