            <selectionEntry id="ce13-3423-4ed9-7baa" name="Chariot" type="upgrade" hidden="false" collective="false" import="true">
              <costs>
                <cost name="pts" typeId="0044-15f1-782b-00ea" value="76" />
              </costs>
              <constraints>
                <constraint id="add2-0fb2-f2b8-b35c" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
              </constraints>
              <infoLinks>
                <infoLink id="e1d4-f0c4-3d4f-e8e8" name="Chariots" targetId="4aec-6ebc-71f0-fd54" type="rule" hidden="false" publicationId="d7c9-7773-4408-58f6" page="75–77" />
              </infoLinks>
              <rules>
                <rule id="2499-71f8-d11b-0042" name="Wood Elf chariot movement" hidden="false">
                  <description>Chariots do not benefit from the Wood Elf ability to ignore woodland movement penalties. Wood Elves p. 66.</description>
                </rule>
                <rule id="d5af-59b5-ea6c-b2b2" name="Chariot impact Strength" hidden="false">
                  <description>The Wood Elf chariot profile prints a dash for Strength (Wood Elves p. 66). The core chariot rule gives Strength 7 in most cases (Rulebook p. 77). Use that core value for impact hits unless an agreed clarification says otherwise; the displayed army-book profile is preserved.</description>
                </rule>
                <rule id="6ad2-8b28-43dd-adcb" name="Chariot equipment" hidden="false">
                  <description>76 points includes two crew with hand weapons/light armour and two steeds. Crew upgrades are paid per crewman. A character replaces the optional third crewman. See Wood Elves p. 66. Chariot magic standards are pending, to avoid a duplicate army-wide allowance across mounts and units.</description>
                </rule>
              </rules>
              <profiles>
                <profile id="5edb-8a81-a1d4-34c4" name="Chariot" typeId="e25d-f63f-8d67-4bda" typeName="Unit" hidden="false" publicationId="2e06-8dc0-e774-819f" page="66">
