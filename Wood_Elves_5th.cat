            <selectionEntry id="ad1c-0df5-6794-21a1" name="Chariot" type="upgrade" hidden="false" collective="false" import="true">
              <costs>
                <cost name="pts" typeId="0044-15f1-782b-00ea" value="76" />
              </costs>
              <constraints>
                <constraint id="ce80-0949-e558-4ff2" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
              </constraints>
              <infoLinks>
                <infoLink id="a3b2-cfd7-e919-2bf0" name="Chariots" targetId="4aec-6ebc-71f0-fd54" type="rule" hidden="false" publicationId="d7c9-7773-4408-58f6" page="75–77" />
              </infoLinks>
              <rules>
                <rule id="e062-7eea-be0d-2499" name="Wood Elf chariot movement" hidden="false">
                  <description>Chariots do not benefit from the Wood Elf ability to ignore woodland movement penalties. Wood Elves p. 66.</description>
                </rule>
                <rule id="6f4c-5ed7-21e4-0fbe" name="Chariot impact Strength" hidden="false">
                  <description>The Wood Elf chariot profile prints a dash for Strength (Wood Elves p. 66). The core chariot rule gives Strength 7 in most cases (Rulebook p. 77). Use that core value for impact hits unless an agreed clarification says otherwise; the displayed army-book profile is preserved.</description>
                </rule>
                <rule id="013d-f66b-9486-8198" name="Chariot equipment" hidden="false">
                  <description>76 points includes two crew with hand weapons/light armour and two steeds. Crew upgrades are paid per crewman. A character replaces the optional third crewman. See Wood Elves p. 66. Chariot magic standards are pending, to avoid a duplicate army-wide allowance across mounts and units.</description>
                </rule>
              </rules>
              <profiles>
                <profile id="044a-eaa8-adc8-9191" name="Chariot" typeId="e25d-f63f-8d67-4bda" typeName="Unit" hidden="false" publicationId="2e06-8dc0-e774-819f" page="66">
