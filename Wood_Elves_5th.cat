            <characteristic name="Ld" typeId="cedc-6339-9f57-49bd">8</characteristic>
          </characteristics>
        </profile>
        <profile id="c3fa-289b-f2ef-0278" name="Drum of Orcskin" typeId="b93a-4f1c-9871-3028" typeName="Magic item" hidden="false" publicationId="2e06-8dc0-e774-819f" page="77–78">
          <characteristics>
            <characteristic name="Type" typeId="7ef9-9797-693d-d937">Enchanted item</characteristic>
            <characteristic name="Effect" typeId="d277-fc43-48d0-6dce">Declare use at the start of a turn before charges. The Wardancer unit adds D6 inches to its charge move.</characteristic>
            <characteristic name="Reference" typeId="2fa3-15cf-fc7d-e42b">Woodelves, printed p. 77–78. Card value 25 points, included in the character total.</characteristic>
            <characteristic name="Coverage" typeId="23f7-abf1-238e-1daa">Book-checked summary; fixed loadout</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <constraints>
        <constraint id="f15d-0caf-7106-9362" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
        <constraint id="9602-556e-1234-fed3" type="max" value="1" scope="roster" field="selections" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" />
      </constraints>
      <rules>
        <rule id="7e52-d0a2-7b80-2c62" name="Special character" hidden="false">
          <description>Unique named selection. 100 points includes the complete listed fixed equipment, companions, powers and mounts; only separately offered options add points. Printed profiles are before magic-item bonuses unless a rule says they are already included. Special-character use requires the players’ agreement under the books’ convention.</description>
        </rule>
        <rule id="c8ba-a5ac-7747-e2bc" name="Included equipment" hidden="false">
          <description>Two hand weapons.</description>
        </rule>
        <rule id="81e3-8387-9b79-d251" name="Choose Opponent" hidden="false" publicationId="2e06-8dc0-e774-819f" page="77–78">
          <description>May attack any model in the opposing unit, not only a model in contact. Reference: Woodelves, printed p. 77–78.</description>
        </rule>
        <rule id="a03c-d24e-1a2f-9e75" name="Dance of Doom" hidden="false" publicationId="2e06-8dc0-e774-819f" page="77–78">
          <description>Once per battle, instead of normal attacks, make one attack against each model in the front rank of one enemy unit in combat. Other Wardancers choose a normal dance. Reference: Woodelves, printed p. 77–78.</description>
        </rule>
        <rule id="4da3-9406-59aa-769d" name="Wardancer defence" hidden="false" publicationId="2e06-8dc0-e774-819f" page="77–78">
          <description>Immune to psychology; dodge attacks on 5+, including war machines and breath attacks. Reference: Woodelves, printed p. 77–78.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="9804-8b3d-63ab-5391" name="Woodland movement" targetId="68da-795a-8b40-d237" type="rule" hidden="false" publicationId="2e06-8dc0-e774-819f" page="42" />
        <infoLink id="5b1b-80cf-f50a-7556" name="Wardancer protection" targetId="847c-2b05-898f-ffa9" type="rule" hidden="false" publicationId="2e06-8dc0-e774-819f" page="45, 67" />
        <infoLink id="f808-bde6-138d-b96d" name="Wardancer fighting formation" targetId="63f1-3336-9ca8-4b85" type="rule" hidden="false" publicationId="2e06-8dc0-e774-819f" page="46" />
        <infoLink id="1818-ab35-8060-c980" name="Wardances" targetId="ab7b-027d-93d9-2e90" type="rule" hidden="false" publicationId="2e06-8dc0-e774-819f" page="46" />
