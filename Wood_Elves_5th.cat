    <selectionEntry id="dbdf-053e-30ef-eb05" name="Sceolan" type="model" hidden="false" collective="false" import="true" publicationId="2e06-8dc0-e774-819f" page="78">
      <costs>
        <cost name="pts" typeId="0044-15f1-782b-00ea" value="166" />
      </costs>
      <categoryLinks>
        <categoryLink id="ef92-7cac-ca38-2104" name="Characters" targetId="0114-02b1-a20d-82f1" primary="true" hidden="false" />
      </categoryLinks>
      <profiles>
        <profile id="97c8-0490-ccd9-b8ff" name="Sceolan" typeId="e25d-f63f-8d67-4bda" typeName="Unit" hidden="false" publicationId="2e06-8dc0-e774-819f" page="78">
          <characteristics>
            <characteristic name="M" typeId="df0b-cf43-1955-6845">5</characteristic>
            <characteristic name="WS" typeId="c83c-b081-d246-d5ef">6</characteristic>
            <characteristic name="BS" typeId="960a-0c90-a448-96b4">6</characteristic>
            <characteristic name="S" typeId="639b-d234-7e46-084b">4</characteristic>
            <characteristic name="T" typeId="6a8e-5ca4-9d4e-d596">4</characteristic>
            <characteristic name="W" typeId="8a8d-ce29-476c-e0fa">2</characteristic>
            <characteristic name="I" typeId="946e-86c4-ffce-c3ed">8</characteristic>
