        <profile id="44bd-0bcc-7fe4-ae09" name="Standard of Athel Loren" typeId="b93a-4f1c-9871-3028" typeName="Magic item" hidden="false" publicationId="2e06-8dc0-e774-819f" page="76">
          <characteristics>
            <characteristic name="Type" typeId="7ef9-9797-693d-d937">Magic standard</characteristic>
            <characteristic name="Effect" typeId="d277-fc43-48d0-6dce">Army battle standard. Spells targeting a model within 12 inches fizzle on 5+. Spell templates approaching the aura can be dispelled as they enter it.</characteristic>
            <characteristic name="Reference" typeId="2fa3-15cf-fc7d-e42b">Woodelves, printed p. 76. Card value 50 points, included in the character total.</characteristic>
            <characteristic name="Coverage" typeId="23f7-abf1-238e-1daa">Book-checked summary; fixed loadout</characteristic>
          </characteristics>
        </profile>
      </profiles>
