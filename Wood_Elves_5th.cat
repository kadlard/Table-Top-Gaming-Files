            <characteristic name="Ld" typeId="cedc-6339-9f57-49bd">9</characteristic>
          </characteristics>
        </profile>
        <profile id="7c58-d692-7f9f-a46e" name="Buckler of Bronze" typeId="b93a-4f1c-9871-3028" typeName="Magic item" hidden="false" publicationId="2e06-8dc0-e774-819f" page="78">
          <characteristics>
            <characteristic name="Type" typeId="7ef9-9797-693d-d937">Magic armour</characteristic>
            <characteristic name="Effect" typeId="d277-fc43-48d0-6dce">Counts as a shield. Whenever his melee opponent rolls 1 To Hit, Sceolan immediately makes an extra attack with his own WS and Strength.</characteristic>
            <characteristic name="Reference" typeId="2fa3-15cf-fc7d-e42b">Woodelves, printed p. 78. Card value 10 points, included in the character total.</characteristic>
            <characteristic name="Coverage" typeId="23f7-abf1-238e-1daa">Book-checked summary; fixed loadout</characteristic>
          </characteristics>
        </profile>
        <profile id="d7eb-ccfc-01da-bbe6" name="Bow of Loren" typeId="b93a-4f1c-9871-3028" typeName="Magic item" hidden="false" publicationId="2e06-8dc0-e774-819f" page="78">
          <characteristics>
            <characteristic name="Type" typeId="7ef9-9797-693d-d937">Magic weapon</characteristic>
            <characteristic name="Effect" typeId="d277-fc43-48d0-6dce">Range 36 inches. Fire a number of magical shots equal to the bearer's Attacks, using the bearer's Strength. All shots target the same enemy. Available to High Elves and Wood Elves.</characteristic>
            <characteristic name="Reference" typeId="2fa3-15cf-fc7d-e42b">Woodelves, printed p. 78. Card value 50 points, included in the character total.</characteristic>
            <characteristic name="Coverage" typeId="23f7-abf1-238e-1daa">Book-checked summary; fixed loadout</characteristic>
          </characteristics>
        </profile>
      </profiles>
