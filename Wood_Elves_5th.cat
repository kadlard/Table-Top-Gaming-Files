      </categoryLinks>
      <profiles>
        <profile id="7e67-c872-8fa6-a24a" name="Thalandor" typeId="e25d-f63f-8d67-4bda" typeName="Unit" hidden="false" publicationId="2e06-8dc0-e774-819f" page="75">
          <characteristics>
            <characteristic name="M" typeId="df0b-cf43-1955-6845">5</characteristic>
