  <rules>
    <rule id="61e2-b521-2b07-ecb2" name="Army selection" hidden="false">
      <description>Wood Elves p. 62. Characters: max 50%; Regiments: min 25%; Monsters: max 25%; Allies: max 25%. Allies are not yet selectable. Apply percentages to the agreed battle limit; verify the app’s percentage basis and nested champion categories before competitive use.</description>
    </rule>
  </rules>
  <sharedSelectionEntries>
    <selectionEntry id="0e28-d811-5429-58fd" name="Orion, King in the Woods" type="model" hidden="false" collective="false" import="true" publicationId="2e06-8dc0-e774-819f" page="70–71">
      <costs>
        <cost name="pts" typeId="0044-15f1-782b-00ea" value="450" />
      </costs>
      <categoryLinks>
        <categoryLink id="47ea-78b8-e41f-8f3c" name="Characters" targetId="0114-02b1-a20d-82f1" primary="true" hidden="false" />
      </categoryLinks>
      <profiles>
        <profile id="8ab8-7f4e-1971-8c96" name="Orion, King in the Woods" typeId="e25d-f63f-8d67-4bda" typeName="Unit" hidden="false" publicationId="2e06-8dc0-e774-819f" page="70–71">
          <characteristics>
            <characteristic name="M" typeId="df0b-cf43-1955-6845">5</characteristic>
            <characteristic name="WS" typeId="c83c-b081-d246-d5ef">8</characteristic>
            <characteristic name="BS" typeId="960a-0c90-a448-96b4">7</characteristic>
            <characteristic name="S" typeId="639b-d234-7e46-084b">5</characteristic>
            <characteristic name="T" typeId="6a8e-5ca4-9d4e-d596">5</characteristic>
            <characteristic name="W" typeId="8a8d-ce29-476c-e0fa">5</characteristic>
            <characteristic name="I" typeId="946e-86c4-ffce-c3ed">9</characteristic>
            <characteristic name="A" typeId="4cc5-d3f5-26a7-37c2">5</characteristic>
            <characteristic name="Ld" typeId="cedc-6339-9f57-49bd">10</characteristic>
          </characteristics>
        </profile>
        <profile id="7d86-c9a6-4d54-d218" name="Spear of Kurnous" typeId="b93a-4f1c-9871-3028" typeName="Magic item" hidden="false" publicationId="2e06-8dc0-e774-819f" page="70–71">
          <characteristics>
            <characteristic name="Type" typeId="7ef9-9797-693d-d937">Magic weapon</characteristic>
            <characteristic name="Effect" typeId="d277-fc43-48d0-6dce">Thrown range 8 inches, use BS without long-range penalty. Against an independent model roll one D6 per starting Wound; against a unit one per rank. Each 4+ causes a wound. Only magic armour saves. In melee use ordinary spear rules and normal WS/Strength, but only magic armour saves. Cannot throw while in combat.</characteristic>
            <characteristic name="Reference" typeId="2fa3-15cf-fc7d-e42b">Woodelves, printed p. 70–71. Card value 50 points, included in the character total.</characteristic>
            <characteristic name="Coverage" typeId="23f7-abf1-238e-1daa">Book-checked summary; fixed loadout</characteristic>
          </characteristics>
        </profile>
        <profile id="ed32-02a5-3279-22a3" name="Horn of the Wild Hunt" typeId="b93a-4f1c-9871-3028" typeName="Magic item" hidden="false" publicationId="2e06-8dc0-e774-819f" page="70–71">
          <characteristics>
            <characteristic name="Type" typeId="7ef9-9797-693d-d937">Bound spell</characteristic>
            <characteristic name="Effect" typeId="d277-fc43-48d0-6dce">Own magic phase, when not in combat: nearest enemy unit within 12 inches tests Panic. Can be dispelled.</characteristic>
            <characteristic name="Reference" typeId="2fa3-15cf-fc7d-e42b">Woodelves, printed p. 70–71. Card value 50 points, included in the character total.</characteristic>
            <characteristic name="Coverage" typeId="23f7-abf1-238e-1daa">Book-checked summary; fixed loadout</characteristic>
          </characteristics>
        </profile>
        <profile id="e827-a95f-5484-ea98" name="Cloak of Isha" typeId="b93a-4f1c-9871-3028" typeName="Magic item" hidden="false" publicationId="2e06-8dc0-e774-819f" page="70–71">
          <characteristics>
            <characteristic name="Type" typeId="7ef9-9797-693d-d937">Ward</characteristic>
            <characteristic name="Effect" typeId="d277-fc43-48d0-6dce">Special save 4+ against all attacks, including those allowing no armour save.</characteristic>
            <characteristic name="Reference" typeId="2fa3-15cf-fc7d-e42b">Woodelves, printed p. 70–71. Card value 50 points, included in the character total.</characteristic>
            <characteristic name="Coverage" typeId="23f7-abf1-238e-1daa">Book-checked summary; fixed loadout</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <constraints>
        <constraint id="401d-888b-691f-0ac1" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
        <constraint id="ea22-78e3-ae99-8bd0" type="max" value="1" scope="roster" field="selections" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" />
        <constraint id="782f-e76c-32ad-9dba" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
      </constraints>
      <rules>
        <rule id="cdc6-645c-9740-490d" name="Special character" hidden="false">
          <description>Unique named selection. 450 points includes the complete listed fixed equipment, companions, powers and mounts; only separately offered options add points. Printed profiles are before magic-item bonuses unless a rule says they are already included. Special-character use requires the players’ agreement under the books’ convention.</description>
        </rule>
        <rule id="9718-14ee-d90f-47e0" name="Included equipment" hidden="false">
          <description>Hand weapon; Spear of Kurnous.</description>
        </rule>
        <rule id="78d7-76e4-4a88-5546" name="Aspect of Kurnous" hidden="false" publicationId="2e06-8dc0-e774-819f" page="70–71">
          <description>Immune to psychology; add D6 inches to each charge. Has a 4+ magical save against spells. Reference: Woodelves, printed p. 70–71.</description>
        </rule>
        <rule id="b2a9-2e3e-9dfb-bbd4" name="Baying Hounds" hidden="false" publicationId="2e06-8dc0-e774-819f" page="70–71">
          <description>Optional 5 points each. Orion and surviving hounds form one unit and cannot join another. Hounds keep pace, including the extra charge movement, and use Orion’s Leadership. Orion fleeing or dying makes them flee; they rally only if he does. Missile hits: 1–3 hounds, 4–6 Orion. Reference: Woodelves, printed p. 70–71.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="91da-06ad-866a-fdc6" name="Fear" targetId="7c4f-53c7-b87a-c8ff" type="rule" hidden="false" publicationId="d7c9-7773-4408-58f6" page="48–49" />
        <infoLink id="126b-ef4a-4bc2-08a3" name="Woodland movement" targetId="68da-795a-8b40-d237" type="rule" hidden="false" publicationId="2e06-8dc0-e774-819f" page="42" />
        <infoLink id="9ae5-c0a8-7bce-7b4b" name="Hand weapon" targetId="f660-63e8-377a-579c" type="rule" hidden="false" publicationId="d7c9-7773-4408-58f6" page="54" />
        <infoLink id="7cb0-1d68-0281-d979" name="General" targetId="d1ba-1b25-c83e-0e46" type="rule" hidden="false" publicationId="d7c9-7773-4408-58f6" page="88" />
      </infoLinks>
