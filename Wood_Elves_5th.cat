                <constraint id="1cfd-938f-af1f-d338" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                <constraint id="f482-d1cc-8eba-a4e9" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
              </constraints>
              <rules>
                <rule id="9391-bc0e-ddf1-4385" name="Named champion" hidden="false">
                  <description>Replaces the ordinary champion. Fixed equipment and companions are already included; whole-unit equipment options do not re-equip this named character.</description>
                </rule>
              </rules>
              <modifiers>
                <modifier type="set" field="f482-d1cc-8eba-a4e9" value="0">
                  <conditions>
                    <condition type="atLeast" field="selections" scope="5433-1024-f244-7842" value="1" childId="7001-57d5-b89a-4f27" shared="true" includeChildSelections="true" includeChildForces="false" percentValue="false" />
                  </conditions>
                </modifier>
              </modifiers>
            </entryLink>
          </entryLinks>
        </selectionEntryGroup>
      </selectionEntryGroups>
      <selectionEntries>
        <selectionEntry id="dcd5-8ab7-39f7-1578" name="Shield (whole unit)" type="upgrade" hidden="false" collective="false" import="true">
          <costs>
            <cost name="pts" typeId="0044-15f1-782b-00ea" value="0" />
          </costs>
          <constraints>
            <constraint id="2545-06ad-8824-d1dd" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <infoLinks>
            <infoLink id="351c-686f-daca-9bf3" name="Armour, shield and barding" targetId="1d9b-1051-0031-be6d" type="rule" hidden="false" publicationId="d7c9-7773-4408-58f6" page="15, 30, 37" />
          </infoLinks>
        </selectionEntry>
      </selectionEntries>
      <rules>
        <rule id="304b-7ba1-f3cd-1fa0" name="Champion equipment pricing" hidden="false">
          <description>The 60-point Wardancer Champion is treated as including his two hand weapons. This interpretation needs a second-source rules check; see source notes.</description>
        </rule>
        <rule id="f856-b0ff-d425-b51e" name="Model count" hidden="false">
          <description>Models includes troopers, standard bearer, musician and champion. Command models replace troopers; they do not upgrade a model already counted. Whole-unit options automatically charge every model; champions pay character equipment rates.</description>
        </rule>
        <rule id="1711-46de-7e71-faf3" name="Named champions available" hidden="false">
          <description>Wychwethyl the Wild</description>
        </rule>
      </rules>
    </selectionEntry>
