          <entryLinks>
            <entryLink id="2006-d472-5569-e0bc" name="Wychwethyl the Wild" targetId="56a0-8d51-5394-f7df" type="selectionEntry" hidden="false" collective="false" import="true">
              <categoryLinks>
                <categoryLink id="f6e0-7e6a-f18e-f979" name="Characters" targetId="0114-02b1-a20d-82f1" primary="true" hidden="false" />
              </categoryLinks>
