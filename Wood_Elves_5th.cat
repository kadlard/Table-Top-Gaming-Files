                <profile id="f08d-79f1-b304-f635" name="Dryads Trooper" typeId="e25d-f63f-8d67-4bda" typeName="Unit" hidden="false" publicationId="2e06-8dc0-e774-819f" page="69">
                  <characteristics>
                    <characteristic name="M" typeId="df0b-cf43-1955-6845">5</characteristic>
                    <characteristic name="WS" typeId="c83c-b081-d246-d5ef">4</characteristic>
