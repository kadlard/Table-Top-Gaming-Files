            <characteristic name="Ld" typeId="cedc-6339-9f57-49bd">10</characteristic>
          </characteristics>
        </profile>
        <profile id="b9f6-4e87-3d6a-837b" name="Gwandor the Black, Great Eagle" typeId="e25d-f63f-8d67-4bda" typeName="Unit" hidden="false" publicationId="2e06-8dc0-e774-819f" page="75">
          <characteristics>
            <characteristic name="M" typeId="df0b-cf43-1955-6845">2</characteristic>
            <characteristic name="WS" typeId="c83c-b081-d246-d5ef">7</characteristic>
            <characteristic name="BS" typeId="960a-0c90-a448-96b4">0</characteristic>
            <characteristic name="S" typeId="639b-d234-7e46-084b">5</characteristic>
            <characteristic name="T" typeId="6a8e-5ca4-9d4e-d596">5</characteristic>
            <characteristic name="W" typeId="8a8d-ce29-476c-e0fa">4</characteristic>
            <characteristic name="I" typeId="946e-86c4-ffce-c3ed">6</characteristic>
            <characteristic name="A" typeId="4cc5-d3f5-26a7-37c2">2</characteristic>
            <characteristic name="Ld" typeId="cedc-6339-9f57-49bd">8</characteristic>
          </characteristics>
        </profile>
        <profile id="044d-ed71-0c21-da6b" name="Magic War Paint" typeId="b93a-4f1c-9871-3028" typeName="Magic item" hidden="false" publicationId="2e06-8dc0-e774-819f" page="75">
          <characteristics>
            <characteristic name="Type" typeId="7ef9-9797-693d-d937">Magic armour</characteristic>
            <characteristic name="Effect" typeId="d277-fc43-48d0-6dce">Armour save 3+ against shooting and 5+ in close combat. Cannot combine with body armour, but can combine with a shield. The paint itself does not prevent a wizard casting spells.</characteristic>
            <characteristic name="Reference" typeId="2fa3-15cf-fc7d-e42b">Woodelves, printed p. 75. Card value 5 points, included in the character total.</characteristic>
            <characteristic name="Coverage" typeId="23f7-abf1-238e-1daa">Book-checked summary; fixed loadout</characteristic>
          </characteristics>
        </profile>
        <profile id="50de-af67-29bb-14b8" name="Talisman of Qwarr" typeId="b93a-4f1c-9871-3028" typeName="Magic item" hidden="false" publicationId="2e06-8dc0-e774-819f" page="75">
          <characteristics>
            <characteristic name="Type" typeId="7ef9-9797-693d-d937">Enchanted item</characteristic>
            <characteristic name="Effect" typeId="d277-fc43-48d0-6dce">Gwandor has a 4+ armour save against mundane weapons and missiles, not magic weapons or missiles.</characteristic>
            <characteristic name="Reference" typeId="2fa3-15cf-fc7d-e42b">Woodelves, printed p. 75. Card value 15 points, included in the character total.</characteristic>
            <characteristic name="Coverage" typeId="23f7-abf1-238e-1daa">Book-checked summary; fixed loadout</characteristic>
          </characteristics>
        </profile>
        <profile id="f6c0-5371-0051-7f23" name="Spear of Daith" typeId="b93a-4f1c-9871-3028" typeName="Magic item" hidden="false" publicationId="2e06-8dc0-e774-819f" page="75">
          <characteristics>
            <characteristic name="Type" typeId="7ef9-9797-693d-d937">Magic weapon</characteristic>
            <characteristic name="Effect" typeId="d277-fc43-48d0-6dce">Normal spear bonuses. Parry each successful enemy melee hit on 4+ before rolling to wound.</characteristic>
            <characteristic name="Reference" typeId="2fa3-15cf-fc7d-e42b">Woodelves, printed p. 75. Card value 25 points, included in the character total.</characteristic>
            <characteristic name="Coverage" typeId="23f7-abf1-238e-1daa">Book-checked summary; fixed loadout</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <constraints>
        <constraint id="fe57-df97-39be-0665" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
        <constraint id="fe70-c1cd-1271-62f3" type="max" value="1" scope="roster" field="selections" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" />
      </constraints>
      <rules>
        <rule id="52b3-e07a-300e-cb4c" name="Special character" hidden="false">
          <description>Unique named selection. 380 points includes the complete listed fixed equipment, companions, powers and mounts; only separately offered options add points. Printed profiles are before magic-item bonuses unless a rule says they are already included. Special-character use requires the players’ agreement under the books’ convention.</description>
        </rule>
        <rule id="0be9-baf2-82e3-8132" name="Included equipment" hidden="false">
          <description>Sword; Spear of Daith; Magic War Paint; Gwandor.</description>
        </rule>
        <rule id="e875-f217-0f39-ce69" name="Magic and spell allocation" hidden="false">
          <description>Magic level 3; 3 spells. Printed spell count already includes fixed bloodline effects; do not add those bonuses again. The lore profiles are reference decks, not a grant of all spells. Choose/draw the permitted spells before play and record them in roster notes.</description>
        </rule>
      </rules>
