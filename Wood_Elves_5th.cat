                <constraint id="01b9-7bae-6ebc-6fa4" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                <constraint id="5c8e-2b76-3b92-4c4b" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
              </constraints>
              <rules>
                <rule id="faea-6ba8-d76a-32a7" name="Named champion" hidden="false">
                  <description>Replaces the ordinary champion. Fixed equipment and companions are already included; whole-unit equipment options do not re-equip this named character.</description>
                </rule>
              </rules>
            </entryLink>
          </entryLinks>
        </selectionEntryGroup>
      </selectionEntryGroups>
      <rules>
        <rule id="5375-314f-4e21-5828" name="Dryad command — pending clarification" hidden="false">
          <description>Basic Dryad unit is implemented. Dryad command is omitted pending verification of eligibility; no Elf champion profile has been substituted.</description>
        </rule>
        <rule id="4df5-e37b-8a8d-33ba" name="Model count" hidden="false">
          <description>Models includes troopers, standard bearer, musician and champion. Command models replace troopers; they do not upgrade a model already counted. Whole-unit options automatically charge every model; champions pay character equipment rates.</description>
        </rule>
        <rule id="4477-24e7-8bd9-d8e4" name="Named champions available" hidden="false">
          <description>Drycha</description>
        </rule>
      </rules>
    </selectionEntry>
