                <selectionEntryGroup id="100f-85fb-44fd-3918" name="Bloodline powers" hidden="false" collective="false" import="true">
                  <constraints>
                    <constraint id="4bbd-28f6-7841-a907" type="max" value="3" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" />
                    <constraint id="c9d9-796d-79c3-9d46" type="min" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" />
                  </constraints>
                  <selectionEntryGroups>
                    <selectionEntryGroup id="e9d2-36ac-f2e5-c27f" name="Von Carstein" hidden="false" collective="false" import="true">
                      <constraints>
                        <constraint id="83ff-22c8-0ad7-4404" type="max" value="0" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                      </constraints>
                      <modifiers>
                        <modifier type="set" field="83ff-22c8-0ad7-4404" value="3">
                          <conditions>
                            <condition type="atLeast" field="selections" scope="roster" value="1" childId="20ca-22ed-4fa6-aa36" shared="true" includeChildSelections="true" includeChildForces="false" percentValue="false" />
                          </conditions>
                        </modifier>
                      </modifiers>
                      <selectionEntries>
                        <selectionEntry id="a012-7387-5f5c-d52c" name="Pure Blood" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="27">
                          <costs>
                            <cost name="pts" typeId="0044-15f1-782b-00ea" value="5" />
                          </costs>
                          <constraints>
                            <constraint id="1446-e698-f61e-5ad5" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                          </constraints>
                          <rules>
                            <rule id="c40a-9247-39b1-0ccb" name="Pure Blood" hidden="false">
                              <description>Allows this Vampire to buy the Carstein Ring. Reference: Vampire Counts p. 27.</description>
                            </rule>
                          </rules>
                        </selectionEntry>
                        <selectionEntry id="ba40-ba82-5645-a09d" name="Wolf Form" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="27">
                          <costs>
                            <cost name="pts" typeId="0044-15f1-782b-00ea" value="5" />
                          </costs>
                          <constraints>
                            <constraint id="6ae3-43ef-78fe-0bd2" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                          </constraints>
                          <rules>
                            <rule id="2668-7902-6d31-0552" name="Wolf Form" hidden="false">
                              <description>On foot, use Move 9 for normal movement, including marches; does not change charge, flee or pursuit distance. Reference: Vampire Counts p. 27.</description>
                            </rule>
                          </rules>
                        </selectionEntry>
                        <selectionEntry id="3381-9690-b6a2-1dfa" name="Honour or Death" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="27">
                          <costs>
                            <cost name="pts" typeId="0044-15f1-782b-00ea" value="10" />
                          </costs>
                          <constraints>
                            <constraint id="1894-cf9d-02e9-199c" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                          </constraints>
                          <rules>
                            <rule id="d61f-5adb-abca-14ea" name="Honour or Death" hidden="false">
                              <description>Must accept enemy challenges. Before the challengers move together, the enemy character tests basic Leadership with no modifiers. A psychology-immune character ignores this. On failure the enemy hides in the rear, no challenge is fought, and the Vampire fights ordinary opponents in contact. Reference: Vampire Counts p. 27.</description>
                            </rule>
                          </rules>
                        </selectionEntry>
                        <selectionEntry id="1ddb-d18e-7dd9-0e3c" name="Unbending Willpower" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="27">
                          <costs>
                            <cost name="pts" typeId="0044-15f1-782b-00ea" value="10" />
                          </costs>
                          <constraints>
                            <constraint id="7b08-4054-7c73-8239" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                          </constraints>
                          <rules>
                            <rule id="f187-e3cf-79f6-2c08" name="Unbending Willpower" hidden="false">
                              <description>An Undead unit led by this Vampire suffers one fewer crumbling wound from losing combat. If the General dies, its D6 loss becomes D6−1. Reference: Vampire Counts p. 27.</description>
                            </rule>
                          </rules>
                        </selectionEntry>
                        <selectionEntry id="4265-8cb5-f6f4-e463" name="Transfix" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="27">
                          <costs>
                            <cost name="pts" typeId="0044-15f1-782b-00ea" value="20" />
                          </costs>
                          <constraints>
                            <constraint id="90c8-b72e-0d93-efe8" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                          </constraints>
                          <rules>
                            <rule id="17fa-a2e4-89f6-b1ab" name="Transfix" hidden="false">
                              <description>At the start of melee choose one enemy in base contact. It tests basic Leadership, without modifiers; on failure it cannot attack and attacks against it hit automatically. Psychology-immune models are unaffected. Reference: Vampire Counts p. 27.</description>
                            </rule>
                          </rules>
                        </selectionEntry>
                        <selectionEntry id="3134-904f-1000-31b4" name="Summon Wolves" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="27">
                          <costs>
                            <cost name="pts" typeId="0044-15f1-782b-00ea" value="30" />
                          </costs>
                          <constraints>
                            <constraint id="2453-904a-b372-49b9" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                          </constraints>
                          <rules>
                            <rule id="25cf-468f-8722-e9c4" name="Summon Wolves" hidden="false">
                              <description>Summon D3+1 Dire Wolves. One use at the start of your turn. Random edge: 1 your edge, 2–3 left, 4–5 right, 6 enemy edge. Place centrally on that edge; the arrivals may move but not charge that turn. Reference: Vampire Counts p. 27.</description>
                            </rule>
                          </rules>
                        </selectionEntry>
                        <selectionEntry id="682b-dc50-03fe-07ff" name="Bat Form" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="27">
                          <costs>
                            <cost name="pts" typeId="0044-15f1-782b-00ea" value="40" />
                          </costs>
                          <constraints>
                            <constraint id="daaa-3a92-4ef0-f38f" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                          </constraints>
                          <rules>
                            <rule id="413c-316b-f9a7-135b" name="Bat Form" hidden="false">
                              <description>On foot, move up to 24 inches ignoring intervening terrain during normal movement; this does not change charge, flee or pursuit movement. Reference: Vampire Counts p. 27.</description>
                            </rule>
                          </rules>
                        </selectionEntry>
                        <selectionEntry id="c869-dd91-b9ca-ecb8" name="Summon Bats" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="28">
                          <costs>
                            <cost name="pts" typeId="0044-15f1-782b-00ea" value="50" />
                          </costs>
                          <constraints>
                            <constraint id="b632-b0fc-9cbb-a7b8" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                          </constraints>
                          <rules>
                            <rule id="e498-1bda-c26d-3b02" name="Summon Bats" hidden="false">
                              <description>Summon one Bat Swarm or D3 Vampire Bats. One use at the start of your turn. Random edge: 1 your edge, 2–3 left, 4–5 right, 6 enemy edge. Place centrally on that edge; the arrivals may move but not charge that turn. Reference: Vampire Counts p. 28.</description>
                            </rule>
                          </rules>
                        </selectionEntry>
                        <selectionEntry id="49b8-8853-5a6e-6d8d" name="Call Winds" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="28">
                          <costs>
                            <cost name="pts" typeId="0044-15f1-782b-00ea" value="60" />
                          </costs>
                          <constraints>
                            <constraint id="a275-daaa-b7b2-2237" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                          </constraints>
                          <rules>
                            <rule id="2aa2-691a-606d-a658" name="Call Winds" hidden="false">
                              <description>If stationary in movement, summon a storm in the following shooting phase. Shooting into, out of or through the area within 24 inches suffers -2. Flying through its boundary or area is impossible, and models flying high cannot land inside it. It lasts until the Vampire moves, enters combat, is wounded or dies; he may still cast spells. Reference: Vampire Counts p. 28.</description>
                            </rule>
                          </rules>
                        </selectionEntry>
                      </selectionEntries>
                    </selectionEntryGroup>
                    <selectionEntryGroup id="9baf-6ac1-b229-d17d" name="Necrarch" hidden="false" collective="false" import="true">
                      <constraints>
                        <constraint id="c78b-233f-0a3a-34a1" type="max" value="0" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                      </constraints>
                      <modifiers>
                        <modifier type="set" field="c78b-233f-0a3a-34a1" value="3">
                          <conditions>
                            <condition type="atLeast" field="selections" scope="roster" value="1" childId="b19a-d86d-7a8a-76f6" shared="true" includeChildSelections="true" includeChildForces="false" percentValue="false" />
                          </conditions>
                        </modifier>
                      </modifiers>
                      <selectionEntries>
                        <selectionEntry id="a3b4-40ba-9a28-e0e7" name="Dark Acolyte" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="28">
                          <costs>
                            <cost name="pts" typeId="0044-15f1-782b-00ea" value="5" />
                          </costs>
                          <constraints>
                            <constraint id="f1f1-7739-5fa1-f669" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                          </constraints>
                          <rules>
                            <rule id="1e20-3b2e-66cd-89ae" name="Dark Acolyte" hidden="false">
                              <description>May carry a Dispel Magic Scroll and retain one magic card between phases. This alone does not make a Thrall a wizard. Reference: Vampire Counts p. 28.</description>
                            </rule>
                          </rules>
                        </selectionEntry>
                        <selectionEntry id="57c7-4c1a-8e4c-47b3" name="Unbending Willpower" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="28">
                          <costs>
                            <cost name="pts" typeId="0044-15f1-782b-00ea" value="10" />
                          </costs>
                          <constraints>
                            <constraint id="a14c-19ae-3bbd-13c3" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                          </constraints>
                          <rules>
                            <rule id="d177-a010-70cb-667c" name="Unbending Willpower" hidden="false">
                              <description>Reduce combat-loss crumbling by one for this Vampire or the Undead unit he leads. Its loss on the General's death becomes D6−1. Reference: Vampire Counts p. 28.</description>
                            </rule>
                          </rules>
                        </selectionEntry>
                        <selectionEntry id="185f-092c-732b-117c" name="The Awakening" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="28">
                          <costs>
                            <cost name="pts" typeId="0044-15f1-782b-00ea" value="20" />
                          </costs>
                          <constraints>
                            <constraint id="3c2f-b2c9-c108-48c6" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                          </constraints>
                          <rules>
                            <rule id="ac8d-8d10-ae6b-794a" name="The Awakening" hidden="false">
                              <description>Add D3 raised models when casting Summon Skeletons, Raise the Dead or Summon Undead Horde. Reference: Vampire Counts p. 28.</description>
                            </rule>
                          </rules>
                        </selectionEntry>
                        <selectionEntry id="2b86-a391-7896-0ded" name="Master of the Black Arts" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="28">
                          <costs>
                            <cost name="pts" typeId="0044-15f1-782b-00ea" value="25" />
                          </costs>
                          <constraints>
                            <constraint id="1a3b-8f5c-a961-deda" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                          </constraints>
                          <rules>
                            <rule id="4cb5-095c-de0a-1a47" name="Master of the Black Arts" hidden="false">
                              <description>Add one to rolls to recast Necromantic spells. Reference: Vampire Counts p. 28.</description>
                            </rule>
                          </rules>
                        </selectionEntry>
                        <selectionEntry id="3377-7ad8-b636-9512" name="Supernatural Horror" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="28">
                          <costs>
                            <cost name="pts" typeId="0044-15f1-782b-00ea" value="30" />
                          </costs>
                          <constraints>
                            <constraint id="0ea6-4201-bfd1-dd46" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                          </constraints>
                          <rules>
                            <rule id="a4fb-3ab9-e85d-1793" name="Supernatural Horror" hidden="false">
                              <description>Causes terror. Reference: Vampire Counts p. 28.</description>
                            </rule>
                          </rules>
                        </selectionEntry>
                        <selectionEntry id="835c-2f5b-f080-f4fd" name="Forbidden Lore" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="28">
                          <costs>
                            <cost name="pts" typeId="0044-15f1-782b-00ea" value="40" />
                          </costs>
                          <constraints>
                            <constraint id="0a80-0d2e-223f-be7e" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                          </constraints>
                          <rules>
                            <rule id="7ad0-84ba-b202-ad61" name="Forbidden Lore" hidden="false">
                              <description>Receives one additional spell; magic level is unchanged. Reference: Vampire Counts p. 28.</description>
                            </rule>
                          </rules>
                        </selectionEntry>
                        <selectionEntry id="62be-b057-0c59-b1c5" name="Curse of the Revenant" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="28">
                          <costs>
                            <cost name="pts" typeId="0044-15f1-782b-00ea" value="50" />
                          </costs>
                          <constraints>
                            <constraint id="5d0c-494a-2bd9-0b60" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                          </constraints>
                          <rules>
                            <rule id="3e56-685b-129b-a2f2" name="Curse of the Revenant" hidden="false">
                              <description>Add one Wound to the profile. Reference: Vampire Counts p. 28.</description>
                            </rule>
                          </rules>
                        </selectionEntry>
                        <selectionEntry id="00b9-340f-2aa8-ec69" name="Death Incarnate" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="28">
                          <costs>
                            <cost name="pts" typeId="0044-15f1-782b-00ea" value="50" />
                          </costs>
                          <constraints>
                            <constraint id="e7be-9b78-c751-3a6d" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                          </constraints>
                          <rules>
                            <rule id="c7c8-1223-14e6-02cc" name="Death Incarnate" hidden="false">
                              <description>Living models within six inches suffer -1 Leadership. Does not affect Daemons or Undead. Reference: Vampire Counts p. 28.</description>
                            </rule>
                          </rules>
                        </selectionEntry>
                        <selectionEntry id="43df-d041-bf75-c5ae" name="Nehekhara’s Noble Blood" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="28">
                          <costs>
                            <cost name="pts" typeId="0044-15f1-782b-00ea" value="50" />
                          </costs>
                          <constraints>
                            <constraint id="b83a-6ecd-d291-0a4e" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                          </constraints>
                          <rules>
                            <rule id="f68a-1f99-de01-5616" name="Nehekhara’s Noble Blood" hidden="false">
                              <description>Becomes magic level 4 with three spell cards. Its Necromancy recast roll remains 5+. Reference: Vampire Counts p. 28.</description>
                            </rule>
                          </rules>
                        </selectionEntry>
                      </selectionEntries>
                    </selectionEntryGroup>
                    <selectionEntryGroup id="55b3-33d0-76d6-666d" name="Blood Dragon" hidden="false" collective="false" import="true">
                      <constraints>
                        <constraint id="5902-e05a-98f4-f62f" type="max" value="0" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                      </constraints>
                      <modifiers>
                        <modifier type="set" field="5902-e05a-98f4-f62f" value="3">
                          <conditions>
                            <condition type="atLeast" field="selections" scope="roster" value="1" childId="2dce-9d08-bbf3-cd0f" shared="true" includeChildSelections="true" includeChildForces="false" percentValue="false" />
                          </conditions>
                        </modifier>
                      </modifiers>
                      <selectionEntries>
                        <selectionEntry id="2b78-7a03-0926-262c" name="Doomrider" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="29">
                          <costs>
                            <cost name="pts" typeId="0044-15f1-782b-00ea" value="5" />
                          </costs>
                          <constraints>
                            <constraint id="02d9-ced3-b5bd-a623" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                          </constraints>
                          <rules>
                            <rule id="3077-83d7-8fe7-f995" name="Doomrider" hidden="false">
                              <description>A ridden Nightmare ignores movement penalties from armour and barding. Reference: Vampire Counts p. 29.</description>
                            </rule>
                          </rules>
                        </selectionEntry>
                        <selectionEntry id="b963-d157-484b-4ab5" name="Honour or Death" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="29">
                          <costs>
                            <cost name="pts" typeId="0044-15f1-782b-00ea" value="10" />
                          </costs>
                          <constraints>
                            <constraint id="6cae-ea6c-030f-12b0" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                          </constraints>
                          <rules>
                            <rule id="07cf-ad3e-28f1-a931" name="Honour or Death" hidden="false">
                              <description>Must accept enemy challenges. Before the challengers move together, the enemy character tests basic Leadership with no modifiers. A psychology-immune character ignores this. On failure the enemy hides in the rear, no challenge is fought, and the Vampire fights ordinary opponents in contact. Reference: Vampire Counts p. 29.</description>
                            </rule>
                          </rules>
                        </selectionEntry>
                        <selectionEntry id="da34-f914-108d-6509" name="Might of Arms" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="29">
                          <costs>
                            <cost name="pts" typeId="0044-15f1-782b-00ea" value="10" />
                          </costs>
                          <constraints>
                            <constraint id="3b82-1a87-ae76-003b" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                          </constraints>
                          <rules>
                            <rule id="1b76-be9e-cb23-1cce" name="Might of Arms" hidden="false">
                              <description>Add one Weapon Skill. Reference: Vampire Counts p. 29.</description>
                            </rule>
                          </rules>
                        </selectionEntry>
                        <selectionEntry id="1bec-07a7-79ce-4f2a" name="Strength of Steel" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="29">
                          <costs>
                            <cost name="pts" typeId="0044-15f1-782b-00ea" value="10" />
                          </costs>
                          <constraints>
                            <constraint id="f117-2f1f-da2f-3509" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                          </constraints>
                          <rules>
                            <rule id="0995-0515-3f90-c2df" name="Strength of Steel" hidden="false">
                              <description>May cast spells while wearing normal armour. Reference: Vampire Counts p. 29.</description>
                            </rule>
                          </rules>
                        </selectionEntry>
                        <selectionEntry id="1873-1bb7-5e07-ad59" name="Blademaster" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="29">
                          <costs>
                            <cost name="pts" typeId="0044-15f1-782b-00ea" value="20" />
                          </costs>
                          <constraints>
                            <constraint id="e248-7bb5-6093-96fb" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                          </constraints>
                          <rules>
                            <rule id="b9ad-8713-1850-fc41" name="Blademaster" hidden="false">
                              <description>Choose one enemy in base contact to lose one Attack. For mixed attacks choose which kind is lost, including a mount attack or bite. Reference: Vampire Counts p. 29.</description>
                            </rule>
                          </rules>
                        </selectionEntry>
                        <selectionEntry id="0de4-4dc4-7793-0f4e" name="Warrior Pride" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="29">
                          <costs>
                            <cost name="pts" typeId="0044-15f1-782b-00ea" value="20" />
                          </costs>
                          <constraints>
                            <constraint id="42bb-2032-cf14-4544" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                          </constraints>
                          <rules>
                            <rule id="8749-29ce-fc08-9d4d" name="Warrior Pride" hidden="false">
                              <description>May cast spells while wearing normal or magical armour. Reference: Vampire Counts p. 29.</description>
                            </rule>
                          </rules>
                        </selectionEntry>
                        <selectionEntry id="7e79-1ad5-47c1-b1b2" name="Red Fury" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="29">
                          <costs>
                            <cost name="pts" typeId="0044-15f1-782b-00ea" value="25" />
                          </costs>
                          <constraints>
                            <constraint id="1710-efdf-18d1-60f5" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                          </constraints>
                          <rules>
                            <rule id="d0a1-5aa3-f0af-49ae" name="Red Fury" hidden="false">
                              <description>Add one Attack. Reference: Vampire Counts p. 29.</description>
                            </rule>
                          </rules>
                        </selectionEntry>
                        <selectionEntry id="d977-9915-ce1a-e3e1" name="Killing Blow" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="29">
                          <costs>
                            <cost name="pts" typeId="0044-15f1-782b-00ea" value="30" />
                          </costs>
                          <constraints>
                            <constraint id="0c02-b93c-726e-8c60" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                          </constraints>
                          <rules>
                            <rule id="5a51-2908-80fb-e03a" name="Killing Blow" hidden="false">
                              <description>A natural 6 to wound multiplies that wound to D3 wounds. With a weapon that already causes multiple wounds, add an extra D3 to its normal total. Reference: Vampire Counts p. 29.</description>
                            </rule>
                          </rules>
                        </selectionEntry>
                        <selectionEntry id="244b-3697-babd-8756" name="Heart Piercing" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="29">
                          <costs>
                            <cost name="pts" typeId="0044-15f1-782b-00ea" value="35" />
                          </costs>
                          <constraints>
                            <constraint id="c738-6466-9f63-c012" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                          </constraints>
                          <rules>
                            <rule id="66c7-4be9-9597-66f8" name="Heart Piercing" hidden="false">
                              <description>Re-roll missed attacks in the first round of a close combat. Reference: Vampire Counts p. 29.</description>
                            </rule>
                          </rules>
                        </selectionEntry>
                      </selectionEntries>
                    </selectionEntryGroup>
                    <selectionEntryGroup id="0a96-5c30-02a5-4cb9" name="Lahmia" hidden="false" collective="false" import="true">
                      <constraints>
                        <constraint id="e585-0fca-a8e6-f201" type="max" value="0" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                      </constraints>
                      <modifiers>
                        <modifier type="set" field="e585-0fca-a8e6-f201" value="3">
                          <conditions>
                            <condition type="atLeast" field="selections" scope="roster" value="1" childId="261a-1963-87e7-5228" shared="true" includeChildSelections="true" includeChildForces="false" percentValue="false" />
                          </conditions>
                        </modifier>
                      </modifiers>
                      <selectionEntries>
                        <selectionEntry id="cda6-c1e0-9573-20f7" name="Lightning Reflexes" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="30">
                          <costs>
                            <cost name="pts" typeId="0044-15f1-782b-00ea" value="5" />
                          </costs>
                          <constraints>
                            <constraint id="4c62-a42b-e7a0-8113" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                          </constraints>
                          <rules>
                            <rule id="2fbf-62f9-2215-21c2" name="Lightning Reflexes" hidden="false">
                              <description>Initiative becomes 10. Reference: Vampire Counts p. 30.</description>
                            </rule>
                          </rules>
                        </selectionEntry>
                        <selectionEntry id="0c93-555f-532a-b141" name="The Dead Walk Fast" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="30">
                          <costs>
                            <cost name="pts" typeId="0044-15f1-782b-00ea" value="5" />
                          </costs>
                          <constraints>
                            <constraint id="fd20-0115-a746-30dc" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                          </constraints>
                          <rules>
                            <rule id="57c9-cb9e-000b-ad51" name="The Dead Walk Fast" hidden="false">
                              <description>Add one Move. Reference: Vampire Counts p. 30.</description>
                            </rule>
                          </rules>
                        </selectionEntry>
                        <selectionEntry id="d4d8-6b76-4a1b-75b7" name="Swiftness" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="30">
                          <costs>
                            <cost name="pts" typeId="0044-15f1-782b-00ea" value="10" />
                          </costs>
                          <constraints>
                            <constraint id="9351-683a-db40-d455" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                          </constraints>
                          <rules>
                            <rule id="233d-e763-47e8-2554" name="Swiftness" hidden="false">
                              <description>On foot and alone, may march even with enemies within eight inches. Reference: Vampire Counts p. 30.</description>
                            </rule>
                          </rules>
                        </selectionEntry>
                        <selectionEntry id="3b37-0342-6bec-ed29" name="Transfix" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="30">
                          <costs>
                            <cost name="pts" typeId="0044-15f1-782b-00ea" value="20" />
                          </costs>
                          <constraints>
                            <constraint id="4479-e7c2-d87d-ccce" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                          </constraints>
                          <rules>
                            <rule id="1cbd-6b1e-f80b-ead5" name="Transfix" hidden="false">
                              <description>At the start of melee choose one enemy in base contact. It tests basic Leadership, without modifiers; on failure it cannot attack and attacks against it hit automatically. Psychology-immune models are unaffected. Reference: Vampire Counts p. 30.</description>
                            </rule>
                          </rules>
                        </selectionEntry>
                        <selectionEntry id="c69c-e87a-d053-2144" name="Quickblood" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="30">
                          <costs>
                            <cost name="pts" typeId="0044-15f1-782b-00ea" value="25" />
                          </costs>
                          <constraints>
                            <constraint id="7064-e7ea-c5ae-215f" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                          </constraints>
                          <rules>
                            <rule id="e494-0e43-3259-46e0" name="Quickblood" hidden="false">
                              <description>Avoid each wound on 5+ before other saves and before multiplying wounds. Reference: Vampire Counts p. 30.</description>
                            </rule>
                          </rules>
                        </selectionEntry>
                        <selectionEntry id="d675-5f2d-9489-c807" name="Innocence Lost" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="30">
                          <costs>
                            <cost name="pts" typeId="0044-15f1-782b-00ea" value="30" />
                          </costs>
                          <constraints>
                            <constraint id="2312-a456-7fce-58db" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                          </constraints>
                          <rules>
                            <rule id="8ce0-e752-f110-0b2f" name="Innocence Lost" hidden="false">
                              <description>Always strikes first; against another first-strike ability use Initiative, then roll off ties. Reference: Vampire Counts p. 30.</description>
                            </rule>
                          </rules>
                        </selectionEntry>
                        <selectionEntry id="e3ff-7085-e16c-446b" name="Mist Form" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="30">
                          <costs>
                            <cost name="pts" typeId="0044-15f1-782b-00ea" value="40" />
                          </costs>
                          <constraints>
                            <constraint id="3527-3a2a-19ae-bf59" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                          </constraints>
                          <rules>
                            <rule id="6ab3-6b08-fb9c-02ac" name="Mist Form" hidden="false">
                              <description>On foot, move up to 24 inches ignoring intervening terrain during normal movement; this does not change charge, flee or pursuit movement. Reference: Vampire Counts p. 30.</description>
                            </rule>
                          </rules>
                        </selectionEntry>
                        <selectionEntry id="7a86-2eb3-e61a-758c" name="Seduction" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="30">
                          <costs>
                            <cost name="pts" typeId="0044-15f1-782b-00ea" value="50" />
                          </costs>
                          <constraints>
                            <constraint id="0417-b2fc-8315-94de" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                          </constraints>
                          <rules>
                            <rule id="c68e-7171-6502-e3d9" name="Seduction" hidden="false">
                              <description>Lord only. At the start of melee choose an enemy in contact to test basic Leadership; psychology-immune models ignore it. Failure gives control of the model, which moves alongside the Vampire. Retest at the start of its original side's turn. A model still controlled at the end counts as slain. Attacking the victim releases it. One attempt per turn, but multiple victims may remain controlled; controlled victims cannot attack each other. Reference: Vampire Counts p. 30.</description>
                            </rule>
                          </rules>
                        </selectionEntry>
                        <selectionEntry id="58b7-23f6-553d-1662" name="Night Creature" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="30">
                          <costs>
                            <cost name="pts" typeId="0044-15f1-782b-00ea" value="60" />
                          </costs>
                          <constraints>
                            <constraint id="708d-6a8f-ab21-f4cf" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                          </constraints>
                          <rules>
                            <rule id="8839-00ff-9249-a364" name="Night Creature" hidden="false">
                              <description>Enemies must roll 5+ to spot this Vampire before charging, shooting or targeting it with a spell. Failure allows another target/action. Does not apply while the Vampire is in a unit or already fighting. Reference: Vampire Counts p. 30.</description>
                            </rule>
                          </rules>
                        </selectionEntry>
                      </selectionEntries>
                    </selectionEntryGroup>
                  </selectionEntryGroups>
                  <rules>
                    <rule id="8e77-0310-9335-1fff" name="Power effects" hidden="false">
                      <description>Apply profile changes, spell counts, armour exceptions and temporary effects manually. Power costs and family/rank eligibility are encoded; effects do not rewrite the printed profile.</description>
                    </rule>
                  </rules>
                </selectionEntryGroup>
                <selectionEntryGroup id="9be9-fee4-7265-4352" name="Magic lore" hidden="false" collective="false" import="true" defaultSelectionEntryId="3149-d7bc-99e3-94c9">
                  <constraints>
                    <constraint id="94e0-a223-9e06-fdae" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                    <constraint id="6ea4-2256-487d-d2a2" type="min" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                  </constraints>
                  <selectionEntries>
                    <selectionEntry id="3149-d7bc-99e3-94c9" name="Necromantic Magic" type="upgrade" hidden="false" collective="false" import="true">
                      <costs>
                        <cost name="pts" typeId="0044-15f1-782b-00ea" value="0" />
                      </costs>
                      <constraints>
                        <constraint id="9e52-7d0f-ac08-dcaa" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                      </constraints>
                      <infoLinks>
                        <infoLink id="cce2-4638-dd00-8a4b" name="Necromancy and recasting" targetId="369a-00ed-fa25-3a9d" type="rule" hidden="false" publicationId="c115-e636-a63a-a216" page="31" />
                      </infoLinks>
                      <profiles>
                        <profile id="1148-bada-38a9-c5ed" name="Drain Life" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="26">
                          <characteristics>
                            <characteristic name="Lore" typeId="d783-9c87-2677-5247">Necromantic Magic</characteristic>
                            <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">2</characteristic>
                            <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">2D6-inch radius</characteristic>
                            <characteristic name="Effect" typeId="d107-f119-4175-3647">Living models in the rolled radius suffer S3 hits with no armour saves. Use wounds inflicted to restore the caster's lost wounds, up to his starting total. Undead, Daemons and objects are unaffected. Characters cannot use Look Out Sir; hit living crew/components of composite models.</characteristic>
                            <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                            <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 26</characteristic>
                            <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                          </characteristics>
                        </profile>
                        <profile id="b644-71a5-d300-59a8" name="Gaze of Nagash" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="26">
                          <characteristics>
                            <characteristic name="Lore" typeId="d783-9c87-2677-5247">Necromantic Magic</characteristic>
                            <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">2</characteristic>
                            <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">18 inches</characteristic>
                            <characteristic name="Effect" typeId="d107-f119-4175-3647">The first unit in its path suffers 2D6 S4 hits with no armour saves.</characteristic>
                            <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                            <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 26</characteristic>
                            <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                          </characteristics>
                        </profile>
                        <profile id="0c77-7902-4973-fb0e" name="Hand of Dust" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="26">
                          <characteristics>
                            <characteristic name="Lore" typeId="d783-9c87-2677-5247">Necromantic Magic</characteristic>
                            <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">2</characteristic>
                            <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">Base contact</characteristic>
                            <characteristic name="Effect" typeId="d107-f119-4175-3647">Both caster and one melee opponent roll D6 plus Strength; double the caster's total. Each point by which the caster wins inflicts one wound with no armour save. A slain victim becomes a friendly Wight, or a Wraith if it was a wizard.</characteristic>
                            <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                            <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 26</characteristic>
                            <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                          </characteristics>
                        </profile>
                        <profile id="6d17-f297-929a-d103" name="The Dark Mist" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="26">
                          <characteristics>
                            <characteristic name="Lore" typeId="d783-9c87-2677-5247">Necromantic Magic</characteristic>
                            <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">1</characteristic>
                            <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">Caster</characteristic>
                            <characteristic name="Effect" typeId="d107-f119-4175-3647">Move up to 24 inches in your movement phase, through terrain and buildings but not living models. Cannot make melee attacks; may cast spells. Only magical weapons and spells can harm the caster. Combat-result defeat is still possible and fleeing ends the effect (Vampire Counts p. 31).</characteristic>
                            <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Remains in play</characteristic>
                            <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 26</characteristic>
                            <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                          </characteristics>
                        </profile>
                        <profile id="1337-54df-8c1d-c2e6" name="Raise the Dead" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="26">
                          <characteristics>
                            <characteristic name="Lore" typeId="d783-9c87-2677-5247">Necromantic Magic</characteristic>
                            <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">2</characteristic>
                            <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">24 inches</characteristic>
                            <characteristic name="Effect" typeId="d107-f119-4175-3647">Raise 2D6 Skeletons or Zombies into an existing unit of that type in range, or make a new unit if at least five are raised. Apply the equipment and victory-point rules in Vampire Counts p. 31.</characteristic>
                            <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                            <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 26</characteristic>
                            <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                          </characteristics>
                        </profile>
                        <profile id="4951-e4eb-c39d-9013" name="Summon Skeletons" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="26">
                          <characteristics>
                            <characteristic name="Lore" typeId="d783-9c87-2677-5247">Necromantic Magic</characteristic>
                            <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">1</characteristic>
                            <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">18 inches</characteristic>
                            <characteristic name="Effect" typeId="d107-f119-4175-3647">Raise D6 Skeletons or Zombies into an existing unit of that type in range, or make a new unit if at least five are raised. Apply Vampire Counts p. 31 for equipment and victory points.</characteristic>
                            <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                            <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 26</characteristic>
                            <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                          </characteristics>
                        </profile>
                        <profile id="703f-5ece-1b1c-73ce" name="Summon Undead Horde" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="26">
                          <characteristics>
                            <characteristic name="Lore" typeId="d783-9c87-2677-5247">Necromantic Magic</characteristic>
                            <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">3</characteristic>
                            <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">36 inches</characteristic>
                            <characteristic name="Effect" typeId="d107-f119-4175-3647">Raise 3D6 Skeletons or Zombies into an existing unit of that type in range, or make a new unit if at least five are raised. Apply Vampire Counts p. 31 for equipment and victory points.</characteristic>
                            <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                            <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 26</characteristic>
                            <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                          </characteristics>
                        </profile>
                        <profile id="3d74-ed52-b2a8-d38b" name="The Curse of Years" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="26">
                          <characteristics>
                            <characteristic name="Lore" typeId="d783-9c87-2677-5247">Necromantic Magic</characteristic>
                            <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">3</characteristic>
                            <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">24 inches</characteristic>
                            <characteristic name="Effect" typeId="d107-f119-4175-3647">Roll per model in the target unit: 5+ kills it outright. At each later Undead magic phase improve the threshold by one (4+, then 3+, etc.). No armour or wound-based saves. Characters test too, without Look Out Sir; roll once for an entire composite model.</characteristic>
                            <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Remains in play</characteristic>
                            <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 26</characteristic>
                            <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                          </characteristics>
                        </profile>
                        <profile id="b683-acd0-2ea8-b8bf" name="Vanhel’s Danse Macabre" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="26">
                          <characteristics>
                            <characteristic name="Lore" typeId="d783-9c87-2677-5247">Necromantic Magic</characteristic>
                            <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">1</characteristic>
                            <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">36 inches</characteristic>
                            <characteristic name="Effect" typeId="d107-f119-4175-3647">One eligible regiment may charge, move, march, fight one round or shoot during the magic phase. For Vampire Counts use the updated p. 31 eligibility: Skeletons, Zombies, Wights (including mounted Wights and Lords), and Wraiths only.</characteristic>
                            <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                            <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 26</characteristic>
                            <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                          </characteristics>
                        </profile>
                        <profile id="545b-a710-1b79-6a4e" name="Wind of Death" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="26">
                          <characteristics>
                            <characteristic name="Lore" typeId="d783-9c87-2677-5247">Necromantic Magic</characteristic>
                            <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">3</characteristic>
                            <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">From any table edge</characteristic>
                            <characteristic name="Effect" typeId="d107-f119-4175-3647">Place its template at any table edge. Move 2D10 inches immediately, and the same direction at the start of later magic phases. Each model passed over suffers D6 wounds on 4+, with no armour saves.</characteristic>
                            <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Remains in play</characteristic>
                            <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 26</characteristic>
                            <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                          </characteristics>
                        </profile>
                      </profiles>
                      <rules>
                        <rule id="25ed-76b8-3744-3e94" name="Spell deck reference" hidden="false">
                          <description>Entire reference deck, not spells known. Draw/choose the permitted number before battle; record them in roster notes. Necromancy uses chosen spells and High Magic its special dealing rules.</description>
                        </rule>
                      </rules>
                    </selectionEntry>
                    <selectionEntry id="04c6-e79d-8f33-cff9" name="Battle Magic" type="upgrade" hidden="false" collective="false" import="true">
                      <costs>
                        <cost name="pts" typeId="0044-15f1-782b-00ea" value="0" />
                      </costs>
                      <constraints>
                        <constraint id="57ff-eff9-4de6-7cc4" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                      </constraints>
                      <profiles>
                        <profile id="1c31-fc18-a31d-e08e" name="Fireball" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="26">
                          <characteristics>
                            <characteristic name="Lore" typeId="d783-9c87-2677-5247">Battle Magic</characteristic>
                            <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">1</characteristic>
                            <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">24 inches</characteristic>
                            <characteristic name="Effect" typeId="d107-f119-4175-3647">Launch one fireball per magic level. Each strikes the first model in its path for one S4 hit, without armour saves. Line of sight required.</characteristic>
                            <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                            <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 26</characteristic>
                            <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                          </characteristics>
                        </profile>
                        <profile id="859e-27bd-9576-2025" name="Destruction" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="26">
                          <characteristics>
                            <characteristic name="Lore" typeId="d783-9c87-2677-5247">Battle Magic</characteristic>
                            <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">2+</characteristic>
                            <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">18 inches</characteristic>
                            <characteristic name="Effect" typeId="d107-f119-4175-3647">An enemy unit suffers 2D6 S4 hits, without armour saves. The summary prints Power 2+ but does not explain the additional-power procedure; use the spell card for that detail.</characteristic>
                            <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                            <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 26</characteristic>
                            <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary only card detail required</characteristic>
                          </characteristics>
                        </profile>
                        <profile id="8f79-f0a4-41b9-28c7" name="Fear" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="26">
                          <characteristics>
                            <characteristic name="Lore" typeId="d783-9c87-2677-5247">Battle Magic</characteristic>
                            <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">2</characteristic>
                            <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">24 inches</characteristic>
                            <characteristic name="Effect" typeId="d107-f119-4175-3647">The targeted enemy unit immediately takes a Fear test and flees if it fails.</characteristic>
                            <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                            <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 26</characteristic>
                            <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                          </characteristics>
                        </profile>
                        <profile id="c9e9-44a9-71ac-ae15" name="Blast" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="26">
                          <characteristics>
                            <characteristic name="Lore" typeId="d783-9c87-2677-5247">Battle Magic</characteristic>
                            <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">2</characteristic>
                            <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">24 inches</characteristic>
                            <characteristic name="Effect" typeId="d107-f119-4175-3647">The first enemy model in the path suffers either D6 S5 hits or D3 S10 hits, with no armour saves. The summary does not reproduce a Line of Sight label; check the original card for its targeting instructions.</characteristic>
                            <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                            <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 26</characteristic>
                            <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary only card detail required</characteristic>
                          </characteristics>
                        </profile>
                        <profile id="ed00-5b49-ac42-61f8" name="Shield" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="27">
                          <characteristics>
                            <characteristic name="Lore" typeId="d783-9c87-2677-5247">Battle Magic</characteristic>
                            <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">2</characteristic>
                            <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">18 inches</characteristic>
                            <characteristic name="Effect" typeId="d107-f119-4175-3647">A friendly unit gains a magical shield: before enemy shots roll to hit, roll for each shot; on 4+ it is stopped.</characteristic>
                            <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Remains in play</characteristic>
                            <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 27</characteristic>
                            <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                          </characteristics>
                        </profile>
                        <profile id="602e-30d0-43c8-9df1" name="Heal" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="27">
                          <characteristics>
                            <characteristic name="Lore" typeId="d783-9c87-2677-5247">Battle Magic</characteristic>
                            <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">1</characteristic>
                            <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">12 inches</characteristic>
                            <characteristic name="Effect" typeId="d107-f119-4175-3647">The wizard or one friendly model within range recovers one lost wound.</characteristic>
                            <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                            <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 27</characteristic>
                            <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                          </characteristics>
                        </profile>
                        <profile id="e8b9-18dc-c316-2404" name="Hold Fast" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="27">
                          <characteristics>
                            <characteristic name="Lore" typeId="d783-9c87-2677-5247">Battle Magic</characteristic>
                            <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">3</characteristic>
                            <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">24 inches</characteristic>
                            <characteristic name="Effect" typeId="d107-f119-4175-3647">An enemy unit can do nothing while the spell lasts.</characteristic>
                            <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Remains in play</characteristic>
                            <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 27</characteristic>
                            <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                          </characteristics>
                        </profile>
                        <profile id="338e-5ac9-4f4c-7e6b" name="Teleport Self" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="27">
                          <characteristics>
                            <characteristic name="Lore" typeId="d783-9c87-2677-5247">Battle Magic</characteristic>
                            <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">1</characteristic>
                            <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">Self</characteristic>
                            <characteristic name="Effect" typeId="d107-f119-4175-3647">Transport the wizard anywhere on the battlefield. Arrival in combat counts as charging.</characteristic>
                            <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                            <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 27</characteristic>
                            <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                          </characteristics>
                        </profile>
                        <profile id="00eb-d5d3-6f3b-6aa8" name="Curse" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="27">
                          <characteristics>
                            <characteristic name="Lore" typeId="d783-9c87-2677-5247">Battle Magic</characteristic>
                            <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">2</characteristic>
                            <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">24 inches</characteristic>
                            <characteristic name="Effect" typeId="d107-f119-4175-3647">An enemy unit suffers -1 to shooting and close-combat hit rolls.</characteristic>
                            <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Remains in play</characteristic>
                            <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 27</characteristic>
                            <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                          </characteristics>
                        </profile>
                        <profile id="89e7-9835-7e59-87e4" name="Net" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="27">
                          <characteristics>
                            <characteristic name="Lore" typeId="d783-9c87-2677-5247">Battle Magic</characteristic>
                            <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">2</characteristic>
                            <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">12 inches</characteristic>
                            <characteristic name="Effect" typeId="d107-f119-4175-3647">An enemy unit can do nothing while entangled.</characteristic>
                            <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Remains in play</characteristic>
                            <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 27</characteristic>
                            <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                          </characteristics>
                        </profile>
                        <profile id="92a9-b3e8-553d-bebf" name="Move Unit" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="27">
                          <characteristics>
                            <characteristic name="Lore" typeId="d783-9c87-2677-5247">Battle Magic</characteristic>
                            <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">2</characteristic>
                            <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">18 inches</characteristic>
                            <characteristic name="Effect" typeId="d107-f119-4175-3647">Transport the wizard and a friendly unit up to 18 inches across the battlefield. Moving into combat counts as charging in its first round.</characteristic>
                            <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                            <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 27</characteristic>
                            <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                          </characteristics>
                        </profile>
                        <profile id="e857-e583-fe28-8695" name="Bless" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="27">
                          <characteristics>
                            <characteristic name="Lore" typeId="d783-9c87-2677-5247">Battle Magic</characteristic>
                            <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">2</characteristic>
                            <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">24 inches</characteristic>
                            <characteristic name="Effect" typeId="d107-f119-4175-3647">A friendly unit gains +1 to shooting and close-combat hit rolls.</characteristic>
                            <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Remains in play</characteristic>
                            <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 27</characteristic>
                            <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                          </characteristics>
                        </profile>
                        <profile id="cbfc-6099-f422-15fa" name="Protect" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="27">
                          <characteristics>
                            <characteristic name="Lore" typeId="d783-9c87-2677-5247">Battle Magic</characteristic>
                            <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">3</characteristic>
                            <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">24 inches</characteristic>
                            <characteristic name="Effect" typeId="d107-f119-4175-3647">A friendly unit gains a 4+ special save against each wound.</characteristic>
                            <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Remains in play</characteristic>
                            <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 27</characteristic>
                            <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                          </characteristics>
                        </profile>
                      </profiles>
                      <rules>
                        <rule id="25d9-476c-c300-05bd" name="Spell deck reference" hidden="false">
