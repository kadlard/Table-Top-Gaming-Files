    <selectionEntry id="b758-d2d8-248c-e9f0" name="Isabella von Carstein" type="model" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="78">
      <costs>
        <cost name="pts" typeId="0044-15f1-782b-00ea" value="110" />
      </costs>
      <categoryLinks>
        <categoryLink id="7a2d-f4ab-f029-8758" name="Characters" targetId="0114-02b1-a20d-82f1" primary="true" hidden="false" />
      </categoryLinks>
      <profiles>
        <profile id="79b7-afdf-c9a4-2894" name="Isabella von Carstein" typeId="e25d-f63f-8d67-4bda" typeName="Unit" hidden="false" publicationId="c115-e636-a63a-a216" page="78">
          <characteristics>
            <characteristic name="M" typeId="df0b-cf43-1955-6845">6</characteristic>
            <characteristic name="WS" typeId="c83c-b081-d246-d5ef">6</characteristic>
            <characteristic name="BS" typeId="960a-0c90-a448-96b4">4</characteristic>
            <characteristic name="S" typeId="639b-d234-7e46-084b">6</characteristic>
            <characteristic name="T" typeId="6a8e-5ca4-9d4e-d596">5</characteristic>
            <characteristic name="W" typeId="8a8d-ce29-476c-e0fa">2</characteristic>
            <characteristic name="I" typeId="946e-86c4-ffce-c3ed">7</characteristic>
            <characteristic name="A" typeId="4cc5-d3f5-26a7-37c2">2</characteristic>
            <characteristic name="Ld" typeId="cedc-6339-9f57-49bd">8</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <constraints>
        <constraint id="34c3-c92c-4064-d198" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
        <constraint id="f637-d675-5fb9-7292" type="max" value="1" scope="roster" field="selections" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" />
        <constraint id="75ff-3246-43d7-5a8f" type="max" value="0" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
        <constraint id="d64a-69b7-44a7-4339" type="max" value="0" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
      </constraints>
      <rules>
        <rule id="a6fe-0f74-32a0-ea15" name="Special character" hidden="false">
          <description>Unique named selection. 110 points includes the complete listed fixed equipment, companions, powers and mounts; only separately offered options add points. Printed profiles are before magic-item bonuses unless a rule says they are already included. Special-character use requires the players’ agreement under the books’ convention.</description>
        </rule>
        <rule id="c5be-c9e3-f151-4c3f" name="Included equipment" hidden="false">
          <description>Sword; on foot.</description>
        </rule>
        <rule id="7bb1-acd4-db6c-d1c7" name="Undying Love" hidden="false" publicationId="c115-e636-a63a-a216" page="78">
          <description>If Vlad dies and is not resurrected by his ring, Isabella becomes frenzied and hates his killers for the rest of the battle. Reference: Vampire Counts, printed p. 78.</description>
        </rule>
        <rule id="3caa-4de3-0ad6-ea4c" name="Fixed bloodline" hidden="false">
          <description>Von Carstein. Select this family in Core rules and army reference. All listed powers are already included; no extra powers may be purchased.</description>
        </rule>
        <rule id="8b59-a3eb-d6e5-ba60" name="Bloodline: Transfix" hidden="false" publicationId="c115-e636-a63a-a216" page="27">
          <description>At the start of melee choose one enemy in base contact. It tests basic Leadership, without modifiers; on failure it cannot attack and attacks against it hit automatically. Psychology-immune models are unaffected.</description>
        </rule>
        <rule id="8208-26db-8ad1-d6e1" name="Bloodline: Bat Form" hidden="false" publicationId="c115-e636-a63a-a216" page="27">
          <description>On foot, move up to 24 inches ignoring intervening terrain during normal movement; this does not change charge, flee or pursuit movement.</description>
        </rule>
        <rule id="5dda-d102-bd0f-5ade" name="Required special character" hidden="false">
          <description>Requires Vlad von Carstein leading the army.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="6559-beeb-dc17-bb86" name="Vampires" targetId="1e6d-5f93-94e7-b409" type="rule" hidden="false" publicationId="c115-e636-a63a-a216" page="50" />
      </infoLinks>
      <modifiers>
