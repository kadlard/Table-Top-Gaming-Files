    <selectionEntry id="467c-3f14-572a-1ec8" name="Vlad von Carstein" type="model" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="78">
      <costs>
        <cost name="pts" typeId="0044-15f1-782b-00ea" value="680" />
      </costs>
      <categoryLinks>
        <categoryLink id="831d-8781-4d4e-51f9" name="Characters" targetId="0114-02b1-a20d-82f1" primary="true" hidden="false" />
      </categoryLinks>
      <profiles>
        <profile id="fc5b-8864-d99c-dae6" name="Vlad von Carstein" typeId="e25d-f63f-8d67-4bda" typeName="Unit" hidden="false" publicationId="c115-e636-a63a-a216" page="78">
          <characteristics>
            <characteristic name="M" typeId="df0b-cf43-1955-6845">6</characteristic>
            <characteristic name="WS" typeId="c83c-b081-d246-d5ef">8</characteristic>
            <characteristic name="BS" typeId="960a-0c90-a448-96b4">6</characteristic>
            <characteristic name="S" typeId="639b-d234-7e46-084b">7</characteristic>
            <characteristic name="T" typeId="6a8e-5ca4-9d4e-d596">6</characteristic>
            <characteristic name="W" typeId="8a8d-ce29-476c-e0fa">4</characteristic>
            <characteristic name="I" typeId="946e-86c4-ffce-c3ed">9</characteristic>
            <characteristic name="A" typeId="4cc5-d3f5-26a7-37c2">4</characteristic>
            <characteristic name="Ld" typeId="cedc-6339-9f57-49bd">10</characteristic>
          </characteristics>
        </profile>
        <profile id="fb63-b46c-cc3a-b1d5" name="The Carstein Ring" typeId="b93a-4f1c-9871-3028" typeName="Magic item" hidden="false" publicationId="c115-e636-a63a-a216" page="78">
          <characteristics>
            <characteristic name="Type" typeId="7ef9-9797-693d-d937">Enchanted item</characteristic>
            <characteristic name="Effect" typeId="d277-fc43-48d0-6dce">One use: immediately resurrect Vlad within 12 inches of his death, with full Wounds, items and spells. His first death does not cause General-death army losses; a second death does.</characteristic>
            <characteristic name="Reference" typeId="2fa3-15cf-fc7d-e42b">Vampire Counts, printed p. 78. Card value 50 points, included in the character total.</characteristic>
            <characteristic name="Coverage" typeId="23f7-abf1-238e-1daa">Book-checked summary; fixed loadout</characteristic>
          </characteristics>
        </profile>
        <profile id="a769-6d0e-2326-3e59" name="Wailing Blade" typeId="b93a-4f1c-9871-3028" typeName="Magic item" hidden="false" publicationId="c115-e636-a63a-a216" page="78">
          <characteristics>
            <characteristic name="Type" typeId="7ef9-9797-693d-d937">Magic weapon</characteristic>
            <characteristic name="Effect" typeId="d277-fc43-48d0-6dce">Causes terror. Each unsaved wound becomes two wounds.</characteristic>
            <characteristic name="Reference" typeId="2fa3-15cf-fc7d-e42b">Vampire Counts, printed p. 78. Card value 60 points, included in the character total.</characteristic>
            <characteristic name="Coverage" typeId="23f7-abf1-238e-1daa">Book-checked summary; fixed loadout</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <constraints>
        <constraint id="0f48-6262-3a4d-0307" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
        <constraint id="86a5-377d-9491-6ff0" type="max" value="1" scope="roster" field="selections" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" />
        <constraint id="c386-467b-83bf-3a9f" type="max" value="0" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
        <constraint id="4c67-5e5f-b356-3b4d" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
      </constraints>
      <rules>
        <rule id="4cf1-a0a6-0a39-d588" name="Special character" hidden="false">
          <description>Unique named selection. 680 points includes the complete listed fixed equipment, companions, powers and mounts; only separately offered options add points. Printed profiles are before magic-item bonuses unless a rule says they are already included. Special-character use requires the players’ agreement under the books’ convention.</description>
        </rule>
        <rule id="45d5-e1ef-bdbc-46b1" name="Included equipment" hidden="false">
          <description>Sword; on foot.</description>
        </rule>
        <rule id="c375-6660-928e-8663" name="Undying Love" hidden="false" publicationId="c115-e636-a63a-a216" page="78">
          <description>If Isabella is killed, Vlad is frenzied for the rest of the battle and hates the model or unit that killed her. Reference: Vampire Counts, printed p. 78.</description>
        </rule>
        <rule id="4aa9-0ebe-632b-1428" name="Magic and spell allocation" hidden="false">
          <description>Magic level 3; 2 spells. Printed spell count already includes fixed bloodline effects; do not add those bonuses again. The lore profiles are reference decks, not a grant of all spells. Choose/draw the permitted spells before play and record them in roster notes.</description>
        </rule>
        <rule id="3ab2-7075-ae57-4e75" name="Fixed bloodline" hidden="false">
          <description>Von Carstein. Select this family in Core rules and army reference. All listed powers are already included; no extra powers may be purchased.</description>
        </rule>
        <rule id="02c1-b012-0b74-35bd" name="Bloodline: Pure Blood" hidden="false" publicationId="c115-e636-a63a-a216" page="27">
          <description>Allows this Vampire to buy the Carstein Ring.</description>
        </rule>
        <rule id="9586-3775-46e7-d6db" name="Bloodline: Wolf Form" hidden="false" publicationId="c115-e636-a63a-a216" page="27">
          <description>On foot, use Move 9 for normal movement, including marches; does not change charge, flee or pursuit distance.</description>
        </rule>
        <rule id="55bd-24a7-6c71-5fa9" name="Bloodline: Honour or Death" hidden="false" publicationId="c115-e636-a63a-a216" page="27">
          <description>Must accept enemy challenges. Before the challengers move together, the enemy character tests basic Leadership with no modifiers. A psychology-immune character ignores this. On failure the enemy hides in the rear, no challenge is fought, and the Vampire fights ordinary opponents in contact.</description>
        </rule>
        <rule id="e27a-7308-dff8-7c48" name="Bloodline: Unbending Willpower" hidden="false" publicationId="c115-e636-a63a-a216" page="27">
          <description>An Undead unit led by this Vampire suffers one fewer crumbling wound from losing combat. If the General dies, its D6 loss becomes D6−1.</description>
        </rule>
        <rule id="e2fc-93e7-d95d-dfb5" name="Bloodline: Transfix" hidden="false" publicationId="c115-e636-a63a-a216" page="27">
          <description>At the start of melee choose one enemy in base contact. It tests basic Leadership, without modifiers; on failure it cannot attack and attacks against it hit automatically. Psychology-immune models are unaffected.</description>
        </rule>
        <rule id="500e-4288-f742-6105" name="Bloodline: Summon Wolves" hidden="false" publicationId="c115-e636-a63a-a216" page="27">
          <description>Summon D3+1 Dire Wolves. One use at the start of your turn. Random edge: 1 your edge, 2–3 left, 4–5 right, 6 enemy edge. Place centrally on that edge; the arrivals may move but not charge that turn.</description>
        </rule>
        <rule id="234b-7374-3456-594e" name="Bloodline: Bat Form" hidden="false" publicationId="c115-e636-a63a-a216" page="27">
          <description>On foot, move up to 24 inches ignoring intervening terrain during normal movement; this does not change charge, flee or pursuit movement.</description>
        </rule>
        <rule id="f929-065d-8cf7-62a8" name="Bloodline: Summon Bats" hidden="false" publicationId="c115-e636-a63a-a216" page="28">
          <description>Summon one Bat Swarm or D3 Vampire Bats. One use at the start of your turn. Random edge: 1 your edge, 2–3 left, 4–5 right, 6 enemy edge. Place centrally on that edge; the arrivals may move but not charge that turn.</description>
        </rule>
        <rule id="9741-c23d-8ec8-0837" name="Bloodline: Call Winds" hidden="false" publicationId="c115-e636-a63a-a216" page="28">
          <description>If stationary in movement, summon a storm in the following shooting phase. Shooting into, out of or through the area within 24 inches suffers -2. Flying through its boundary or area is impossible, and models flying high cannot land inside it. It lasts until the Vampire moves, enters combat, is wounded or dies; he may still cast spells.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="802e-0355-7c23-119b" name="Vampires" targetId="1e6d-5f93-94e7-b409" type="rule" hidden="false" publicationId="c115-e636-a63a-a216" page="50" />
        <infoLink id="3af7-8941-24ca-fb20" name="General" targetId="d1ba-1b25-c83e-0e46" type="rule" hidden="false" publicationId="d7c9-7773-4408-58f6" page="88" />
        <infoLink id="cd69-f8fa-cdec-c529" name="Magic phase and Winds of Magic" targetId="51af-8134-e1d0-5c8f" type="rule" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="9–12" />
        <infoLink id="006d-4961-4d5d-fe9f" name="Counter magic and natural dispels" targetId="a2e7-268a-edde-1495" type="rule" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="10–14" />
        <infoLink id="6d77-90ac-f0e0-58e4" name="Winds of Magic special cards" targetId="0d22-3d38-e047-8557" type="rule" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="9–10" />
        <infoLink id="bde2-e931-c3c0-500b" name="Spells remaining in play" targetId="b403-7328-b3ca-4dd7" type="rule" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="11–14" />
        <infoLink id="c82d-e133-9f7e-8edd" name="Spell targets, sight and templates" targetId="34de-d976-f1cf-5402" type="rule" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="12, 22" />
      </infoLinks>
      <selectionEntryGroups>
        <selectionEntryGroup id="cac8-56cf-e387-bc03" name="Magic lore" hidden="false" collective="false" import="true" defaultSelectionEntryId="db44-b5a1-a7f5-3a5f">
          <constraints>
            <constraint id="632c-5837-7f5f-36e8" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
            <constraint id="04cb-8def-f90d-6391" type="min" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <selectionEntries>
            <selectionEntry id="db44-b5a1-a7f5-3a5f" name="Necromantic Magic" type="upgrade" hidden="false" collective="false" import="true">
              <costs>
                <cost name="pts" typeId="0044-15f1-782b-00ea" value="0" />
              </costs>
              <constraints>
                <constraint id="d664-aa48-321e-f606" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
              </constraints>
              <infoLinks>
                <infoLink id="e5a8-6c01-ca4b-f894" name="Necromancy and recasting" targetId="369a-00ed-fa25-3a9d" type="rule" hidden="false" publicationId="c115-e636-a63a-a216" page="31" />
              </infoLinks>
              <profiles>
                <profile id="056a-33f8-1ad3-a538" name="Drain Life" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="26">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Necromantic Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">2</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">2D6-inch radius</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">Living models in the rolled radius suffer S3 hits with no armour saves. Use wounds inflicted to restore the caster's lost wounds, up to his starting total. Undead, Daemons and objects are unaffected. Characters cannot use Look Out Sir; hit living crew/components of composite models.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 26</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">Reference deck; not automatically known</characteristic>
                  </characteristics>
                </profile>
                <profile id="e923-c080-82a9-0bb7" name="Gaze of Nagash" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="26">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Necromantic Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">2</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">18 inches</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">The first unit in its path suffers 2D6 S4 hits with no armour saves.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 26</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">Reference deck; not automatically known</characteristic>
                  </characteristics>
                </profile>
                <profile id="a011-de28-3493-c23a" name="Hand of Dust" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="26">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Necromantic Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">2</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">Base contact</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">Both caster and one melee opponent roll D6 plus Strength; double the caster's total. Each point by which the caster wins inflicts one wound with no armour save. A slain victim becomes a friendly Wight, or a Wraith if it was a wizard.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 26</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">Reference deck; not automatically known</characteristic>
                  </characteristics>
                </profile>
                <profile id="3d6c-3f76-2e2a-f1d7" name="The Dark Mist" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="26">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Necromantic Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">1</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">Caster</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">Move up to 24 inches in your movement phase, through terrain and buildings but not living models. Cannot make melee attacks; may cast spells. Only magical weapons and spells can harm the caster. Combat-result defeat is still possible and fleeing ends the effect (Vampire Counts p. 31).</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Remains in play</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 26</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">Reference deck; not automatically known</characteristic>
                  </characteristics>
                </profile>
                <profile id="5397-6175-9b56-6bef" name="Raise the Dead" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="26">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Necromantic Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">2</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">24 inches</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">Raise 2D6 Skeletons or Zombies into an existing unit of that type in range, or make a new unit if at least five are raised. Apply the equipment and victory-point rules in Vampire Counts p. 31.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 26</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">Reference deck; not automatically known</characteristic>
                  </characteristics>
                </profile>
                <profile id="5705-bbcd-8fab-e240" name="Summon Skeletons" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="26">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Necromantic Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">1</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">18 inches</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">Raise D6 Skeletons or Zombies into an existing unit of that type in range, or make a new unit if at least five are raised. Apply Vampire Counts p. 31 for equipment and victory points.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 26</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">Reference deck; not automatically known</characteristic>
                  </characteristics>
                </profile>
                <profile id="8dbb-a5bd-c9a1-c71d" name="Summon Undead Horde" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="26">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Necromantic Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">3</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">36 inches</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">Raise 3D6 Skeletons or Zombies into an existing unit of that type in range, or make a new unit if at least five are raised. Apply Vampire Counts p. 31 for equipment and victory points.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 26</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">Reference deck; not automatically known</characteristic>
                  </characteristics>
                </profile>
                <profile id="dc8d-2924-b86e-01fe" name="The Curse of Years" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="26">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Necromantic Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">3</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">24 inches</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">Roll per model in the target unit: 5+ kills it outright. At each later Undead magic phase improve the threshold by one (4+, then 3+, etc.). No armour or wound-based saves. Characters test too, without Look Out Sir; roll once for an entire composite model.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Remains in play</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 26</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">Reference deck; not automatically known</characteristic>
                  </characteristics>
                </profile>
                <profile id="ea42-31d5-e60e-fe7b" name="Vanhel’s Danse Macabre" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="26">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Necromantic Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">1</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">36 inches</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">One eligible regiment may charge, move, march, fight one round or shoot during the magic phase. For Vampire Counts use the updated p. 31 eligibility: Skeletons, Zombies, Wights (including mounted Wights and Lords), and Wraiths only.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 26</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">Reference deck; not automatically known</characteristic>
                  </characteristics>
                </profile>
                <profile id="c3d8-91db-75fc-4af1" name="Wind of Death" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="26">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Necromantic Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">3</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">From any table edge</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">Place its template at any table edge. Move 2D10 inches immediately, and the same direction at the start of later magic phases. Each model passed over suffers D6 wounds on 4+, with no armour saves.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Remains in play</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 26</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">Reference deck; not automatically known</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
      </selectionEntryGroups>
