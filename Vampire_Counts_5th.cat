                        <infoLink id="30bb-0dd2-4ed1-284d" name="Manticore: Enraged Bound Monster" targetId="4437-19bb-b07a-ebcf" type="rule" hidden="false" publicationId="7bde-49a8-e4f5-1832" page="134" />
                        <infoLink id="7a90-b310-8307-2d95" name="Flying and being driven off" targetId="f8d8-8222-78f2-a11c" type="rule" hidden="false" publicationId="d7c9-7773-4408-58f6" page="71–74" />
                        <infoLink id="3a48-e951-fd88-831c" name="Flying high" targetId="99d7-0426-702a-003b" type="rule" hidden="false" publicationId="d7c9-7773-4408-58f6" page="73–74" />
                        <infoLink id="bcb8-bcca-e9e9-7c1c" name="Terror" targetId="baed-6e1f-98ad-7e00" type="rule" hidden="false" publicationId="d7c9-7773-4408-58f6" page="49" />
                        <infoLink id="4726-8feb-02d0-0178" name="Ridden monsters and rider loss" targetId="70ef-ea27-1ae3-36d7" type="rule" hidden="false" publicationId="d7c9-7773-4408-58f6" page="68–70" />
                      </infoLinks>
                      <rules>
                        <rule id="b345-08d0-c0cf-0458" name="Included equipment" hidden="false">
                          <description>Natural attacks.</description>
                        </rule>
                      </rules>
                    </selectionEntry>
                  </selectionEntries>
