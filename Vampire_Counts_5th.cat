        <infoLink id="8a10-8c50-d684-21f6" name="Wizards and armour" targetId="2464-78f1-754b-15cb" type="rule" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="7–8, 36" />
      </infoLinks>
      <rules>
        <rule id="c8e6-8ac4-87a7-ba16" name="Included equipment" hidden="false">
          <description>Hand weapon.</description>
        </rule>
        <rule id="cd86-7b56-2081-bc7a" name="Wizard level and spells" hidden="false">
          <description>Magic level 2; 1 spell cards before bloodline/item changes. Those changes, including Forbidden Lore and Nehekhara’s Noble Blood, are applied manually. Normal armour casting restrictions apply unless a specific power overrides them.</description>
        </rule>
      </rules>
