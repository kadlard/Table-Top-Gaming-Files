    <selectionEntry id="9481-ac03-40e8-a7cb" name="Krell" type="model" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="72">
      <costs>
        <cost name="pts" typeId="0044-15f1-782b-00ea" value="280" />
      </costs>
      <categoryLinks>
        <categoryLink id="c710-2343-28ca-5e89" name="Characters" targetId="0114-02b1-a20d-82f1" primary="true" hidden="false" />
      </categoryLinks>
      <profiles>
        <profile id="9cd1-096d-7d02-0392" name="Krell" typeId="e25d-f63f-8d67-4bda" typeName="Unit" hidden="false" publicationId="c115-e636-a63a-a216" page="72">
          <characteristics>
            <characteristic name="M" typeId="df0b-cf43-1955-6845">4</characteristic>
            <characteristic name="WS" typeId="c83c-b081-d246-d5ef">5</characteristic>
            <characteristic name="BS" typeId="960a-0c90-a448-96b4">0</characteristic>
            <characteristic name="S" typeId="639b-d234-7e46-084b">4</characteristic>
            <characteristic name="T" typeId="6a8e-5ca4-9d4e-d596">5</characteristic>
            <characteristic name="W" typeId="8a8d-ce29-476c-e0fa">3</characteristic>
            <characteristic name="I" typeId="946e-86c4-ffce-c3ed">3</characteristic>
            <characteristic name="A" typeId="4cc5-d3f5-26a7-37c2">3</characteristic>
            <characteristic name="Ld" typeId="cedc-6339-9f57-49bd">10</characteristic>
          </characteristics>
        </profile>
        <profile id="5616-860c-efc8-7096" name="Armour of Protection" typeId="b93a-4f1c-9871-3028" typeName="Magic item" hidden="false" publicationId="c115-e636-a63a-a216" page="72">
          <characteristics>
            <characteristic name="Type" typeId="7ef9-9797-693d-d937">Magic armour</characteristic>
            <characteristic name="Effect" typeId="d277-fc43-48d0-6dce">Provides a 5+ armour save, followed by a separate 4+ special save for wounds not stopped by armour.</characteristic>
            <characteristic name="Reference" typeId="2fa3-15cf-fc7d-e42b">Vampire Counts, printed p. 72. Card value 50 points, included in the character total.</characteristic>
            <characteristic name="Coverage" typeId="23f7-abf1-238e-1daa">Book-checked summary; fixed loadout</characteristic>
          </characteristics>
        </profile>
        <profile id="4001-d9f2-abcf-664f" name="Black Axe of Krell" typeId="b93a-4f1c-9871-3028" typeName="Magic item" hidden="false" publicationId="c115-e636-a63a-a216" page="72">
          <characteristics>
            <characteristic name="Type" typeId="7ef9-9797-693d-d937">Magic weapon</characteristic>
            <characteristic name="Effect" typeId="d277-fc43-48d0-6dce">No armour saves. At the start of each magic phase roll for each surviving model wounded by this axe: on 1–2 it suffers another wound.</characteristic>
            <characteristic name="Reference" typeId="2fa3-15cf-fc7d-e42b">Vampire Counts, printed p. 72. Card value 125 points, included in the character total.</characteristic>
            <characteristic name="Coverage" typeId="23f7-abf1-238e-1daa">Book-checked summary; fixed loadout</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <constraints>
        <constraint id="12e6-1925-d8e2-5e2b" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
        <constraint id="08e9-5c3c-f4ee-fe5d" type="max" value="1" scope="roster" field="selections" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" />
        <constraint id="99bf-596d-b4ad-286a" type="max" value="0" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
      </constraints>
      <rules>
        <rule id="6ff6-1040-9bf1-ff34" name="Special character" hidden="false">
          <description>Unique named selection. 280 points includes the complete listed fixed equipment, companions, powers and mounts; only separately offered options add points. Printed profiles are before magic-item bonuses unless a rule says they are already included. Special-character use requires the players’ agreement under the books’ convention.</description>
        </rule>
        <rule id="657a-fb1c-fef7-7772" name="Included equipment" hidden="false">
          <description>Armour of Protection; Black Axe; on foot.</description>
        </rule>
        <rule id="d956-63da-6b0e-ce59" name="Required special character" hidden="false">
          <description>Requires Heinrich Kemmler, the Lichemaster leading the army.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="430f-6a1c-4ce1-faf5" name="Undead" targetId="d11e-3731-0222-44e5" type="rule" hidden="false" publicationId="c115-e636-a63a-a216" page="49–50" />
        <infoLink id="7b6d-3b9b-888c-e8ec" name="Terror" targetId="baed-6e1f-98ad-7e00" type="rule" hidden="false" publicationId="d7c9-7773-4408-58f6" page="49" />
      </infoLinks>
