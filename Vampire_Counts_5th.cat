                        <selectionEntry id="eb91-3736-df0b-e31b" name="Lightning Reflexes" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="30">
                          <costs>
                            <cost name="pts" typeId="0044-15f1-782b-00ea" value="5" />
                          </costs>
                          <constraints>
                            <constraint id="cc6b-6ca5-19ce-65a4" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                          </constraints>
                          <rules>
                            <rule id="cdea-92b7-d008-ff61" name="Lightning Reflexes" hidden="false">
                              <description>Initiative becomes 10. Reference: Vampire Counts p. 30.</description>
                            </rule>
                          </rules>
                        </selectionEntry>
                        <selectionEntry id="a097-3857-dfd3-c74c" name="The Dead Walk Fast" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="30">
                          <costs>
                            <cost name="pts" typeId="0044-15f1-782b-00ea" value="5" />
                          </costs>
                          <constraints>
                            <constraint id="a957-b94d-5765-6620" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                          </constraints>
                          <rules>
                            <rule id="ce91-7525-afa0-6ff6" name="The Dead Walk Fast" hidden="false">
                              <description>Add one Move. Reference: Vampire Counts p. 30.</description>
                            </rule>
                          </rules>
                        </selectionEntry>
                        <selectionEntry id="a98d-8f4a-6f41-892f" name="Swiftness" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="30">
                          <costs>
                            <cost name="pts" typeId="0044-15f1-782b-00ea" value="10" />
                          </costs>
                          <constraints>
                            <constraint id="2912-c1fe-6dd9-c54b" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                          </constraints>
                          <rules>
                            <rule id="6618-2bae-de22-bad6" name="Swiftness" hidden="false">
                              <description>On foot and alone, may march even with enemies within eight inches. Reference: Vampire Counts p. 30.</description>
                            </rule>
                          </rules>
                        </selectionEntry>
                        <selectionEntry id="95fd-825b-b8f0-b69f" name="Transfix" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="30">
                          <costs>
                            <cost name="pts" typeId="0044-15f1-782b-00ea" value="20" />
                          </costs>
                          <constraints>
                            <constraint id="edb3-20b5-b7b1-49a1" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                          </constraints>
                          <rules>
                            <rule id="7fcb-252b-d551-50a4" name="Transfix" hidden="false">
                              <description>At the start of melee choose one enemy in base contact. It tests basic Leadership, without modifiers; on failure it cannot attack and attacks against it hit automatically. Psychology-immune models are unaffected. Reference: Vampire Counts p. 30.</description>
                            </rule>
                          </rules>
                        </selectionEntry>
                        <selectionEntry id="7ae2-a89c-90e3-193c" name="Quickblood" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="30">
                          <costs>
                            <cost name="pts" typeId="0044-15f1-782b-00ea" value="25" />
                          </costs>
                          <constraints>
                            <constraint id="67ef-707d-8bad-72ae" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                          </constraints>
                          <rules>
                            <rule id="0cd1-80bc-6ff4-a73e" name="Quickblood" hidden="false">
                              <description>Avoid each wound on 5+ before other saves and before multiplying wounds. Reference: Vampire Counts p. 30.</description>
                            </rule>
                          </rules>
                        </selectionEntry>
                        <selectionEntry id="fd54-a86c-8a87-34a5" name="Innocence Lost" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="30">
                          <costs>
                            <cost name="pts" typeId="0044-15f1-782b-00ea" value="30" />
                          </costs>
                          <constraints>
                            <constraint id="4593-8924-c907-550a" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                          </constraints>
                          <rules>
                            <rule id="2047-2395-3569-c502" name="Innocence Lost" hidden="false">
                              <description>Always strikes first; against another first-strike ability use Initiative, then roll off ties. Reference: Vampire Counts p. 30.</description>
                            </rule>
                          </rules>
                        </selectionEntry>
                        <selectionEntry id="23aa-17d0-49f7-3fae" name="Mist Form" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="30">
                          <costs>
                            <cost name="pts" typeId="0044-15f1-782b-00ea" value="40" />
                          </costs>
                          <constraints>
                            <constraint id="2dfa-3f3a-1857-aee3" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                          </constraints>
                          <rules>
                            <rule id="1062-62ba-2fcf-e291" name="Mist Form" hidden="false">
                              <description>On foot, move up to 24 inches ignoring intervening terrain during normal movement; this does not change charge, flee or pursuit movement. Reference: Vampire Counts p. 30.</description>
                            </rule>
                          </rules>
                        </selectionEntry>
                      </selectionEntries>
