        <profile id="fe1c-9336-7a6a-86f3" name="Staff of Flaming Death" typeId="b93a-4f1c-9871-3028" typeName="Magic item" hidden="false" publicationId="c115-e636-a63a-a216" page="70">
          <characteristics>
            <characteristic name="Type" typeId="7ef9-9797-693d-d937">Wizard arcana</characteristic>
            <characteristic name="Effect" typeId="d277-fc43-48d0-6dce">Bound spell once per own magic phase: range 24 inches and line of sight required. The first model or unit in its path takes D3 S4 hits. A unit suffering casualties must take a Panic test.</characteristic>
            <characteristic name="Reference" typeId="2fa3-15cf-fc7d-e42b">Vampire Counts, printed p. 70. Card value 50 points, included in the character total.</characteristic>
            <characteristic name="Coverage" typeId="23f7-abf1-238e-1daa">Book-checked summary; fixed loadout</characteristic>
          </characteristics>
        </profile>
        <profile id="3d9b-c7c2-5d8e-5298" name="Chaos Runesword of Grungni Ironheart" typeId="b93a-4f1c-9871-3028" typeName="Magic item" hidden="false" publicationId="c115-e636-a63a-a216" page="70">
          <characteristics>
            <characteristic name="Type" typeId="7ef9-9797-693d-d937">Magic weapon</characteristic>
            <characteristic name="Effect" typeId="d277-fc43-48d0-6dce">Bearer gains +1 Weapon Skill, Strength and Attacks.</characteristic>
            <characteristic name="Reference" typeId="2fa3-15cf-fc7d-e42b">Vampire Counts, printed p. 70. Card value 65 points, included in the character total.</characteristic>
            <characteristic name="Coverage" typeId="23f7-abf1-238e-1daa">Book-checked summary; fixed loadout</characteristic>
          </characteristics>
        </profile>
        <profile id="3e03-55e3-3770-10ec" name="Power Scroll" typeId="b93a-4f1c-9871-3028" typeName="Magic item" hidden="false" publicationId="c115-e636-a63a-a216" page="70">
          <characteristics>
            <characteristic name="Type" typeId="7ef9-9797-693d-d937">Wizard arcana</characteristic>
            <characteristic name="Effect" typeId="d277-fc43-48d0-6dce">One use. Supplies all power needed to cast one spell.</characteristic>
            <characteristic name="Reference" typeId="2fa3-15cf-fc7d-e42b">Vampire Counts, printed p. 70. Card value 30 points, included in the character total.</characteristic>
            <characteristic name="Coverage" typeId="23f7-abf1-238e-1daa">Book-checked summary; fixed loadout</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <constraints>
        <constraint id="55f8-7d2d-878f-38e0" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
        <constraint id="3679-e7e7-7ee2-20c2" type="max" value="1" scope="roster" field="selections" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" />
      </constraints>
      <rules>
        <rule id="b79e-60c2-707f-c51b" name="Special character" hidden="false">
          <description>Unique named selection. 690 points includes the complete listed fixed equipment, companions, powers and mounts; only separately offered options add points. Printed profiles are before magic-item bonuses unless a rule says they are already included. Special-character use requires the players’ agreement under the books’ convention.</description>
        </rule>
        <rule id="3038-c61b-259a-7443" name="Included equipment" hidden="false">
          <description>Chaos Runesword; Manticore.</description>
        </rule>
        <rule id="cb07-8c61-e97e-5f1e" name="Doom Lord" hidden="false" publicationId="c115-e636-a63a-a216" page="70">
          <description>His Manticore never takes enraged bound-monster rolls. Reference: Vampire Counts, printed p. 70.</description>
        </rule>
        <rule id="d610-d340-4d4b-5ddf" name="Mixed spell allocation" hidden="false" publicationId="c115-e636-a63a-a216" page="70">
          <description>Four spells total, freely mixed between chosen Necromantic spells and randomly drawn Dark Magic spells. The two reference decks do not grant their entire contents. Reference: Vampire Counts, printed p. 70.</description>
        </rule>
        <rule id="7d6d-fa3b-8907-e2ab" name="Magic and spell allocation" hidden="false">
          <description>Magic level 4; 4 spells. Printed spell count already includes fixed bloodline effects; do not add those bonuses again. The lore profiles are reference decks, not a grant of all spells. Choose/draw the permitted spells before play and record them in roster notes.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="341e-1f94-337c-f3fc" name="Living Necromancers" targetId="4330-8bfe-ae9c-b8eb" type="rule" hidden="false" publicationId="c115-e636-a63a-a216" page="51" />
        <infoLink id="4b7c-08ad-2697-4e91" name="Manticore: Enraged Bound Monster" targetId="4437-19bb-b07a-ebcf" type="rule" hidden="false" publicationId="7bde-49a8-e4f5-1832" page="134" />
