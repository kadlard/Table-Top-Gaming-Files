          </constraints>
          <selectionEntryGroups>
            <selectionEntryGroup id="ec87-7b21-531d-9432" name="Von Carstein" hidden="false" collective="false" import="true">
              <constraints>
                <constraint id="030f-0056-6dc9-033b" type="max" value="0" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
              </constraints>
              <modifiers>
                <modifier type="set" field="030f-0056-6dc9-033b" value="2">
                  <conditions>
                    <condition type="atLeast" field="selections" scope="roster" value="1" childId="20ca-22ed-4fa6-aa36" shared="true" includeChildSelections="true" includeChildForces="false" percentValue="false" />
                  </conditions>
                </modifier>
              </modifiers>
              <selectionEntries>
                <selectionEntry id="2b28-089e-eb9f-044e" name="Pure Blood" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="27">
                  <costs>
                    <cost name="pts" typeId="0044-15f1-782b-00ea" value="5" />
                  </costs>
                  <constraints>
                    <constraint id="0ef0-559b-60ce-1cb1" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                  </constraints>
                  <rules>
                    <rule id="b1c4-f73e-35c9-038c" name="Pure Blood" hidden="false">
                      <description>Allows this Vampire to buy the Carstein Ring. Reference: Vampire Counts p. 27.</description>
                    </rule>
                  </rules>
                </selectionEntry>
                <selectionEntry id="fff7-2f3f-be6e-1f84" name="Wolf Form" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="27">
                  <costs>
                    <cost name="pts" typeId="0044-15f1-782b-00ea" value="5" />
                  </costs>
                  <constraints>
                    <constraint id="c0bc-2d01-46e4-14a4" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                  </constraints>
                  <rules>
                    <rule id="ad3b-42a9-0ac5-001f" name="Wolf Form" hidden="false">
                      <description>On foot, use Move 9 for normal movement, including marches; does not change charge, flee or pursuit distance. Reference: Vampire Counts p. 27.</description>
                    </rule>
                  </rules>
                </selectionEntry>
                <selectionEntry id="f8ea-17c6-68c3-8a1c" name="Honour or Death" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="27">
                  <costs>
                    <cost name="pts" typeId="0044-15f1-782b-00ea" value="10" />
                  </costs>
                  <constraints>
                    <constraint id="63db-e497-651e-c8ee" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                  </constraints>
                  <rules>
                    <rule id="b519-8620-1c10-44e4" name="Honour or Death" hidden="false">
                      <description>Must accept enemy challenges. Before the challengers move together, the enemy character tests basic Leadership with no modifiers. A psychology-immune character ignores this. On failure the enemy hides in the rear, no challenge is fought, and the Vampire fights ordinary opponents in contact. Reference: Vampire Counts p. 27.</description>
                    </rule>
                  </rules>
                </selectionEntry>
                <selectionEntry id="df4a-2e6e-c6c1-7701" name="Unbending Willpower" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="27">
                  <costs>
                    <cost name="pts" typeId="0044-15f1-782b-00ea" value="10" />
                  </costs>
                  <constraints>
                    <constraint id="9bb4-56e8-c517-0dd0" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                  </constraints>
                  <rules>
                    <rule id="fd93-6a64-ae92-9041" name="Unbending Willpower" hidden="false">
                      <description>An Undead unit led by this Vampire suffers one fewer crumbling wound from losing combat. If the General dies, its D6 loss becomes D6−1. Reference: Vampire Counts p. 27.</description>
                    </rule>
                  </rules>
                </selectionEntry>
                <selectionEntry id="49ba-7335-b1a5-e393" name="Transfix" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="27">
                  <costs>
                    <cost name="pts" typeId="0044-15f1-782b-00ea" value="20" />
                  </costs>
                  <constraints>
                    <constraint id="7c28-30af-2445-ed8e" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                  </constraints>
                  <rules>
                    <rule id="2b6f-89b1-4fa7-e5e7" name="Transfix" hidden="false">
                      <description>At the start of melee choose one enemy in base contact. It tests basic Leadership, without modifiers; on failure it cannot attack and attacks against it hit automatically. Psychology-immune models are unaffected. Reference: Vampire Counts p. 27.</description>
                    </rule>
                  </rules>
                </selectionEntry>
                <selectionEntry id="500f-b97b-3147-95e3" name="Summon Wolves" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="27">
                  <costs>
                    <cost name="pts" typeId="0044-15f1-782b-00ea" value="30" />
                  </costs>
                  <constraints>
                    <constraint id="fe15-df16-8b69-5faf" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                  </constraints>
                  <rules>
                    <rule id="eea7-3472-3e02-41ca" name="Summon Wolves" hidden="false">
                      <description>Summon D3+1 Dire Wolves. One use at the start of your turn. Random edge: 1 your edge, 2–3 left, 4–5 right, 6 enemy edge. Place centrally on that edge; the arrivals may move but not charge that turn. Reference: Vampire Counts p. 27.</description>
                    </rule>
                  </rules>
                </selectionEntry>
                <selectionEntry id="75df-dc66-e83d-32a4" name="Bat Form" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="27">
                  <costs>
                    <cost name="pts" typeId="0044-15f1-782b-00ea" value="40" />
                  </costs>
                  <constraints>
                    <constraint id="2be7-b33f-f23e-7a4b" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                  </constraints>
                  <rules>
                    <rule id="3e20-2d87-8120-3a3e" name="Bat Form" hidden="false">
                      <description>On foot, move up to 24 inches ignoring intervening terrain during normal movement; this does not change charge, flee or pursuit movement. Reference: Vampire Counts p. 27.</description>
                    </rule>
                  </rules>
                </selectionEntry>
              </selectionEntries>
            </selectionEntryGroup>
            <selectionEntryGroup id="ce8d-24d9-ea39-c942" name="Necrarch" hidden="false" collective="false" import="true">
              <constraints>
                <constraint id="d9e6-cf86-32d5-5ffa" type="max" value="0" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
              </constraints>
              <modifiers>
                <modifier type="set" field="d9e6-cf86-32d5-5ffa" value="2">
                  <conditions>
                    <condition type="atLeast" field="selections" scope="roster" value="1" childId="b19a-d86d-7a8a-76f6" shared="true" includeChildSelections="true" includeChildForces="false" percentValue="false" />
                  </conditions>
                </modifier>
              </modifiers>
              <selectionEntries>
                <selectionEntry id="390b-751a-2eaa-7fed" name="Dark Acolyte" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="28">
                  <costs>
                    <cost name="pts" typeId="0044-15f1-782b-00ea" value="5" />
                  </costs>
                  <constraints>
                    <constraint id="78a0-c0f7-ce94-ef2c" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                  </constraints>
                  <rules>
                    <rule id="6b13-6919-4dcb-6fae" name="Dark Acolyte" hidden="false">
                      <description>May carry a Dispel Magic Scroll and retain one magic card between phases. This alone does not make a Thrall a wizard. Reference: Vampire Counts p. 28.</description>
                    </rule>
                  </rules>
                </selectionEntry>
                <selectionEntry id="e4e9-9894-54f7-44d1" name="Unbending Willpower" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="28">
                  <costs>
                    <cost name="pts" typeId="0044-15f1-782b-00ea" value="10" />
                  </costs>
                  <constraints>
                    <constraint id="7aa9-3867-f392-4cf3" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                  </constraints>
                  <rules>
                    <rule id="bbda-a34d-b04e-20f9" name="Unbending Willpower" hidden="false">
                      <description>Reduce combat-loss crumbling by one for this Vampire or the Undead unit he leads. Its loss on the General's death becomes D6−1. Reference: Vampire Counts p. 28.</description>
                    </rule>
                  </rules>
                </selectionEntry>
                <selectionEntry id="c58c-5692-c8e8-81ab" name="The Awakening" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="28">
                  <costs>
                    <cost name="pts" typeId="0044-15f1-782b-00ea" value="20" />
                  </costs>
                  <constraints>
                    <constraint id="4531-2a2b-4845-42dc" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                  </constraints>
                  <rules>
                    <rule id="44d6-430a-699c-7460" name="The Awakening" hidden="false">
                      <description>Add D3 raised models when casting Summon Skeletons, Raise the Dead or Summon Undead Horde. Reference: Vampire Counts p. 28.</description>
                    </rule>
                  </rules>
                </selectionEntry>
                <selectionEntry id="111b-878f-8266-4806" name="Master of the Black Arts" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="28">
                  <costs>
                    <cost name="pts" typeId="0044-15f1-782b-00ea" value="25" />
                  </costs>
                  <constraints>
                    <constraint id="931c-18d5-ccef-d0cd" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                  </constraints>
                  <rules>
                    <rule id="ce70-c44f-e376-fb25" name="Master of the Black Arts" hidden="false">
                      <description>Add one to rolls to recast Necromantic spells. Reference: Vampire Counts p. 28.</description>
                    </rule>
                  </rules>
                </selectionEntry>
                <selectionEntry id="a4f9-e7fe-b9cb-78ca" name="Supernatural Horror" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="28">
                  <costs>
                    <cost name="pts" typeId="0044-15f1-782b-00ea" value="30" />
                  </costs>
                  <constraints>
                    <constraint id="63ae-001d-ecdb-13f9" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                  </constraints>
                  <rules>
                    <rule id="7e12-bfd1-69ee-e713" name="Supernatural Horror" hidden="false">
                      <description>Causes terror. Reference: Vampire Counts p. 28.</description>
                    </rule>
                  </rules>
                </selectionEntry>
                <selectionEntry id="883d-40d0-8417-fe77" name="Forbidden Lore" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="28">
                  <costs>
                    <cost name="pts" typeId="0044-15f1-782b-00ea" value="40" />
                  </costs>
                  <constraints>
                    <constraint id="4a68-2ad7-7bcf-2cba" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                  </constraints>
                  <rules>
                    <rule id="6be1-f831-5f50-9fa4" name="Forbidden Lore" hidden="false">
                      <description>Receives one additional spell; magic level is unchanged. Reference: Vampire Counts p. 28.</description>
                    </rule>
                  </rules>
                </selectionEntry>
                <selectionEntry id="8b41-a9c5-4a8b-8cca" name="Curse of the Revenant" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="28">
                  <costs>
                    <cost name="pts" typeId="0044-15f1-782b-00ea" value="50" />
                  </costs>
                  <constraints>
                    <constraint id="3e03-5698-fb20-964d" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                  </constraints>
                  <rules>
                    <rule id="b5dd-249c-6f0a-a93a" name="Curse of the Revenant" hidden="false">
                      <description>Add one Wound to the profile. Reference: Vampire Counts p. 28.</description>
                    </rule>
                  </rules>
                </selectionEntry>
              </selectionEntries>
            </selectionEntryGroup>
            <selectionEntryGroup id="b6a4-2f28-3d32-2e41" name="Blood Dragon" hidden="false" collective="false" import="true">
              <constraints>
                <constraint id="ccd8-f46f-5f20-3ff6" type="max" value="0" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
              </constraints>
              <modifiers>
                <modifier type="set" field="ccd8-f46f-5f20-3ff6" value="2">
                  <conditions>
                    <condition type="atLeast" field="selections" scope="roster" value="1" childId="2dce-9d08-bbf3-cd0f" shared="true" includeChildSelections="true" includeChildForces="false" percentValue="false" />
                  </conditions>
                </modifier>
              </modifiers>
              <selectionEntries>
                <selectionEntry id="fb80-24bb-8242-9fee" name="Doomrider" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="29">
                  <costs>
                    <cost name="pts" typeId="0044-15f1-782b-00ea" value="5" />
                  </costs>
                  <constraints>
                    <constraint id="5399-bf4c-a80e-b858" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                  </constraints>
                  <rules>
                    <rule id="05c9-221b-b168-62c8" name="Doomrider" hidden="false">
                      <description>A ridden Nightmare ignores movement penalties from armour and barding. Reference: Vampire Counts p. 29.</description>
                    </rule>
                  </rules>
                </selectionEntry>
                <selectionEntry id="cd9f-242b-7116-af05" name="Honour or Death" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="29">
                  <costs>
                    <cost name="pts" typeId="0044-15f1-782b-00ea" value="10" />
                  </costs>
                  <constraints>
                    <constraint id="d9c2-778f-c881-6e19" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                  </constraints>
                  <rules>
                    <rule id="4b8f-a7e9-a4d4-7b7b" name="Honour or Death" hidden="false">
                      <description>Must accept enemy challenges. Before the challengers move together, the enemy character tests basic Leadership with no modifiers. A psychology-immune character ignores this. On failure the enemy hides in the rear, no challenge is fought, and the Vampire fights ordinary opponents in contact. Reference: Vampire Counts p. 29.</description>
                    </rule>
                  </rules>
                </selectionEntry>
                <selectionEntry id="18f1-ec7a-8fda-9e93" name="Might of Arms" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="29">
                  <costs>
                    <cost name="pts" typeId="0044-15f1-782b-00ea" value="10" />
                  </costs>
                  <constraints>
                    <constraint id="aa85-a686-e26f-bf91" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                  </constraints>
                  <rules>
                    <rule id="7242-d22c-2e59-2dd3" name="Might of Arms" hidden="false">
                      <description>Add one Weapon Skill. Reference: Vampire Counts p. 29.</description>
                    </rule>
                  </rules>
                </selectionEntry>
                <selectionEntry id="c1b1-c9b2-5207-6e36" name="Strength of Steel" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="29">
                  <costs>
                    <cost name="pts" typeId="0044-15f1-782b-00ea" value="10" />
                  </costs>
                  <constraints>
                    <constraint id="9df7-63c9-8b61-1bd2" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                  </constraints>
                  <rules>
                    <rule id="901e-3d73-d0a6-9618" name="Strength of Steel" hidden="false">
                      <description>May cast spells while wearing normal armour. Reference: Vampire Counts p. 29.</description>
                    </rule>
                  </rules>
                </selectionEntry>
                <selectionEntry id="61d6-42b1-de3c-f66c" name="Blademaster" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="29">
                  <costs>
                    <cost name="pts" typeId="0044-15f1-782b-00ea" value="20" />
                  </costs>
                  <constraints>
                    <constraint id="2953-6710-0dfd-a972" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                  </constraints>
                  <rules>
                    <rule id="6090-96c5-0441-1a65" name="Blademaster" hidden="false">
                      <description>Choose one enemy in base contact to lose one Attack. For mixed attacks choose which kind is lost, including a mount attack or bite. Reference: Vampire Counts p. 29.</description>
                    </rule>
                  </rules>
                </selectionEntry>
                <selectionEntry id="af6b-aa11-f09f-df8c" name="Warrior Pride" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="29">
                  <costs>
                    <cost name="pts" typeId="0044-15f1-782b-00ea" value="20" />
                  </costs>
                  <constraints>
                    <constraint id="9553-5ebb-ae28-5cbc" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                  </constraints>
                  <rules>
                    <rule id="82b1-b171-1d04-ca5e" name="Warrior Pride" hidden="false">
                      <description>May cast spells while wearing normal or magical armour. Reference: Vampire Counts p. 29.</description>
                    </rule>
                  </rules>
                </selectionEntry>
                <selectionEntry id="ea78-ec53-5ccd-7b35" name="Red Fury" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="29">
                  <costs>
                    <cost name="pts" typeId="0044-15f1-782b-00ea" value="25" />
                  </costs>
                  <constraints>
                    <constraint id="c3e0-df53-68b6-a654" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                  </constraints>
                  <rules>
                    <rule id="98ae-c524-4364-20fc" name="Red Fury" hidden="false">
                      <description>Add one Attack. Reference: Vampire Counts p. 29.</description>
                    </rule>
                  </rules>
                </selectionEntry>
              </selectionEntries>
            </selectionEntryGroup>
            <selectionEntryGroup id="046b-aed7-3bb4-6ab5" name="Lahmia" hidden="false" collective="false" import="true">
              <constraints>
                <constraint id="24c4-6386-7085-8873" type="max" value="0" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
              </constraints>
              <modifiers>
                <modifier type="set" field="24c4-6386-7085-8873" value="2">
                  <conditions>
                    <condition type="atLeast" field="selections" scope="roster" value="1" childId="261a-1963-87e7-5228" shared="true" includeChildSelections="true" includeChildForces="false" percentValue="false" />
                  </conditions>
                </modifier>
              </modifiers>
              <selectionEntries>
                <selectionEntry id="d96b-00e9-e56a-701a" name="Lightning Reflexes" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="30">
                  <costs>
                    <cost name="pts" typeId="0044-15f1-782b-00ea" value="5" />
                  </costs>
                  <constraints>
                    <constraint id="9bf4-cef0-5580-6dbf" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                  </constraints>
                  <rules>
                    <rule id="93ae-7fbb-da07-907e" name="Lightning Reflexes" hidden="false">
                      <description>Initiative becomes 10. Reference: Vampire Counts p. 30.</description>
                    </rule>
                  </rules>
                </selectionEntry>
                <selectionEntry id="a50f-320f-6ea7-8c02" name="The Dead Walk Fast" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="30">
                  <costs>
                    <cost name="pts" typeId="0044-15f1-782b-00ea" value="5" />
                  </costs>
                  <constraints>
                    <constraint id="4aa3-b9a8-f19d-aa5b" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                  </constraints>
                  <rules>
                    <rule id="cbd9-380c-b381-1c21" name="The Dead Walk Fast" hidden="false">
                      <description>Add one Move. Reference: Vampire Counts p. 30.</description>
                    </rule>
                  </rules>
                </selectionEntry>
                <selectionEntry id="fa0c-a778-888f-0be6" name="Swiftness" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="30">
                  <costs>
                    <cost name="pts" typeId="0044-15f1-782b-00ea" value="10" />
                  </costs>
                  <constraints>
                    <constraint id="b98f-6a99-453b-da3e" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                  </constraints>
                  <rules>
                    <rule id="da97-67f9-f11c-2e5e" name="Swiftness" hidden="false">
                      <description>On foot and alone, may march even with enemies within eight inches. Reference: Vampire Counts p. 30.</description>
                    </rule>
                  </rules>
                </selectionEntry>
                <selectionEntry id="a4be-3522-c40d-b33f" name="Transfix" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="30">
                  <costs>
                    <cost name="pts" typeId="0044-15f1-782b-00ea" value="20" />
                  </costs>
                  <constraints>
                    <constraint id="85fd-4857-4105-809d" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                  </constraints>
                  <rules>
                    <rule id="d0f4-e099-360b-f35a" name="Transfix" hidden="false">
                      <description>At the start of melee choose one enemy in base contact. It tests basic Leadership, without modifiers; on failure it cannot attack and attacks against it hit automatically. Psychology-immune models are unaffected. Reference: Vampire Counts p. 30.</description>
                    </rule>
                  </rules>
                </selectionEntry>
                <selectionEntry id="d68e-8825-3d85-cf01" name="Quickblood" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="30">
                  <costs>
                    <cost name="pts" typeId="0044-15f1-782b-00ea" value="25" />
                  </costs>
                  <constraints>
                    <constraint id="d622-7a3d-df79-741e" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                  </constraints>
                  <rules>
                    <rule id="7aa0-aabb-3089-4cf8" name="Quickblood" hidden="false">
                      <description>Avoid each wound on 5+ before other saves and before multiplying wounds. Reference: Vampire Counts p. 30.</description>
                    </rule>
                  </rules>
                </selectionEntry>
                <selectionEntry id="93e8-4f70-9db9-a34b" name="Innocence Lost" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="30">
                  <costs>
                    <cost name="pts" typeId="0044-15f1-782b-00ea" value="30" />
                  </costs>
                  <constraints>
                    <constraint id="6570-0e04-2e8c-ad1b" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                  </constraints>
                  <rules>
                    <rule id="2100-472c-8e23-767e" name="Innocence Lost" hidden="false">
                      <description>Always strikes first; against another first-strike ability use Initiative, then roll off ties. Reference: Vampire Counts p. 30.</description>
                    </rule>
                  </rules>
                </selectionEntry>
                <selectionEntry id="a78b-5e1a-2da1-b6d9" name="Mist Form" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="30">
                  <costs>
                    <cost name="pts" typeId="0044-15f1-782b-00ea" value="40" />
                  </costs>
                  <constraints>
                    <constraint id="2cc0-82b8-4bc9-a7c3" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                  </constraints>
                  <rules>
                    <rule id="f10b-a429-e7b3-18e0" name="Mist Form" hidden="false">
                      <description>On foot, move up to 24 inches ignoring intervening terrain during normal movement; this does not change charge, flee or pursuit movement. Reference: Vampire Counts p. 30.</description>
                    </rule>
                  </rules>
                </selectionEntry>
              </selectionEntries>
            </selectionEntryGroup>
          </selectionEntryGroups>
          <rules>
            <rule id="ea1d-93e5-b0f1-d762" name="Power effects" hidden="false">
              <description>Apply profile changes, spell counts, armour exceptions and temporary effects manually. Power costs and family/rank eligibility are encoded; effects do not rewrite the printed profile.</description>
            </rule>
          </rules>
        </selectionEntryGroup>
        <selectionEntryGroup id="da8c-0467-57dc-45f4" name="Magic lore" hidden="false" collective="false" import="true" defaultSelectionEntryId="f03d-ff9a-20ac-4704">
          <constraints>
            <constraint id="8b86-cc5c-d603-801a" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
            <constraint id="fab7-f538-642a-0d26" type="min" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <selectionEntries>
            <selectionEntry id="f03d-ff9a-20ac-4704" name="Necromantic Magic" type="upgrade" hidden="false" collective="false" import="true">
              <costs>
                <cost name="pts" typeId="0044-15f1-782b-00ea" value="0" />
              </costs>
              <constraints>
                <constraint id="521c-377b-572f-d5ed" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
              </constraints>
              <infoLinks>
                <infoLink id="14d3-377e-b18f-d442" name="Necromancy and recasting" targetId="369a-00ed-fa25-3a9d" type="rule" hidden="false" publicationId="c115-e636-a63a-a216" page="31" />
              </infoLinks>
              <profiles>
                <profile id="0f75-7285-30e3-cb71" name="Drain Life" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="26">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Necromantic Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">2</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">2D6-inch radius</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">Living models in the rolled radius suffer S3 hits with no armour saves. Use wounds inflicted to restore the caster's lost wounds, up to his starting total. Undead, Daemons and objects are unaffected. Characters cannot use Look Out Sir; hit living crew/components of composite models.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 26</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                  </characteristics>
                </profile>
                <profile id="bafb-8047-b279-a602" name="Gaze of Nagash" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="26">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Necromantic Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">2</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">18 inches</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">The first unit in its path suffers 2D6 S4 hits with no armour saves.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 26</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                  </characteristics>
                </profile>
                <profile id="1271-c8cc-43de-28a8" name="Hand of Dust" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="26">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Necromantic Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">2</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">Base contact</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">Both caster and one melee opponent roll D6 plus Strength; double the caster's total. Each point by which the caster wins inflicts one wound with no armour save. A slain victim becomes a friendly Wight, or a Wraith if it was a wizard.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 26</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                  </characteristics>
                </profile>
                <profile id="66a4-e711-05af-af5f" name="The Dark Mist" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="26">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Necromantic Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">1</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">Caster</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">Move up to 24 inches in your movement phase, through terrain and buildings but not living models. Cannot make melee attacks; may cast spells. Only magical weapons and spells can harm the caster. Combat-result defeat is still possible and fleeing ends the effect (Vampire Counts p. 31).</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Remains in play</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 26</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                  </characteristics>
                </profile>
                <profile id="7a55-5743-88e3-6985" name="Raise the Dead" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="26">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Necromantic Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">2</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">24 inches</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">Raise 2D6 Skeletons or Zombies into an existing unit of that type in range, or make a new unit if at least five are raised. Apply the equipment and victory-point rules in Vampire Counts p. 31.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 26</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                  </characteristics>
                </profile>
                <profile id="7efb-c800-2704-75d8" name="Summon Skeletons" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="26">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Necromantic Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">1</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">18 inches</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">Raise D6 Skeletons or Zombies into an existing unit of that type in range, or make a new unit if at least five are raised. Apply Vampire Counts p. 31 for equipment and victory points.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 26</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                  </characteristics>
                </profile>
                <profile id="675a-400f-4b68-faa0" name="Summon Undead Horde" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="26">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Necromantic Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">3</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">36 inches</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">Raise 3D6 Skeletons or Zombies into an existing unit of that type in range, or make a new unit if at least five are raised. Apply Vampire Counts p. 31 for equipment and victory points.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 26</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                  </characteristics>
                </profile>
                <profile id="a01e-249d-0a82-e321" name="The Curse of Years" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="26">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Necromantic Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">3</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">24 inches</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">Roll per model in the target unit: 5+ kills it outright. At each later Undead magic phase improve the threshold by one (4+, then 3+, etc.). No armour or wound-based saves. Characters test too, without Look Out Sir; roll once for an entire composite model.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Remains in play</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 26</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                  </characteristics>
                </profile>
                <profile id="1700-606d-da1b-53e0" name="Vanhel’s Danse Macabre" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="26">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Necromantic Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">1</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">36 inches</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">One eligible regiment may charge, move, march, fight one round or shoot during the magic phase. For Vampire Counts use the updated p. 31 eligibility: Skeletons, Zombies, Wights (including mounted Wights and Lords), and Wraiths only.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 26</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                  </characteristics>
                </profile>
                <profile id="9956-6a77-5abd-30cc" name="Wind of Death" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="26">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Necromantic Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">3</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">From any table edge</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">Place its template at any table edge. Move 2D10 inches immediately, and the same direction at the start of later magic phases. Each model passed over suffers D6 wounds on 4+, with no armour saves.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Remains in play</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 26</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule id="bac9-0fc3-8c5c-19f0" name="Spell deck reference" hidden="false">
                  <description>Entire reference deck, not spells known. Draw/choose the permitted number before battle; record them in roster notes. Necromancy uses chosen spells and High Magic its special dealing rules.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry id="3cde-f480-26e6-6969" name="Battle Magic" type="upgrade" hidden="false" collective="false" import="true">
              <costs>
                <cost name="pts" typeId="0044-15f1-782b-00ea" value="0" />
              </costs>
              <constraints>
                <constraint id="3962-1203-78f0-358d" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
              </constraints>
              <profiles>
                <profile id="e50e-17e0-ddb6-16cb" name="Fireball" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="26">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Battle Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">1</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">24 inches</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">Launch one fireball per magic level. Each strikes the first model in its path for one S4 hit, without armour saves. Line of sight required.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 26</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                  </characteristics>
                </profile>
                <profile id="1502-66f0-cf5f-f804" name="Destruction" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="26">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Battle Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">2+</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">18 inches</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">An enemy unit suffers 2D6 S4 hits, without armour saves. The summary prints Power 2+ but does not explain the additional-power procedure; use the spell card for that detail.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 26</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary only card detail required</characteristic>
                  </characteristics>
                </profile>
                <profile id="1701-2693-406b-6d07" name="Fear" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="26">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Battle Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">2</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">24 inches</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">The targeted enemy unit immediately takes a Fear test and flees if it fails.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 26</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                  </characteristics>
                </profile>
                <profile id="fea7-b871-02cd-79d1" name="Blast" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="26">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Battle Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">2</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">24 inches</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">The first enemy model in the path suffers either D6 S5 hits or D3 S10 hits, with no armour saves. The summary does not reproduce a Line of Sight label; check the original card for its targeting instructions.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 26</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary only card detail required</characteristic>
                  </characteristics>
                </profile>
                <profile id="3466-bfae-6eec-d3b3" name="Shield" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="27">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Battle Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">2</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">18 inches</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">A friendly unit gains a magical shield: before enemy shots roll to hit, roll for each shot; on 4+ it is stopped.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Remains in play</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 27</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                  </characteristics>
                </profile>
                <profile id="ed4b-49ad-9bc7-0fc7" name="Heal" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="27">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Battle Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">1</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">12 inches</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">The wizard or one friendly model within range recovers one lost wound.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 27</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                  </characteristics>
                </profile>
                <profile id="63f8-4dca-f6b5-ba04" name="Hold Fast" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="27">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Battle Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">3</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">24 inches</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">An enemy unit can do nothing while the spell lasts.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Remains in play</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 27</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                  </characteristics>
                </profile>
                <profile id="1b69-daf1-3c59-6ed8" name="Teleport Self" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="27">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Battle Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">1</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">Self</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">Transport the wizard anywhere on the battlefield. Arrival in combat counts as charging.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 27</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                  </characteristics>
                </profile>
                <profile id="6bc4-a8c1-817d-160f" name="Curse" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="27">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Battle Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">2</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">24 inches</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">An enemy unit suffers -1 to shooting and close-combat hit rolls.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Remains in play</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 27</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                  </characteristics>
                </profile>
                <profile id="d716-d0cd-8bee-041b" name="Net" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="27">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Battle Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">2</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">12 inches</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">An enemy unit can do nothing while entangled.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Remains in play</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 27</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                  </characteristics>
                </profile>
                <profile id="f8ac-c775-960a-2edb" name="Move Unit" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="27">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Battle Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">2</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">18 inches</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">Transport the wizard and a friendly unit up to 18 inches across the battlefield. Moving into combat counts as charging in its first round.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 27</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                  </characteristics>
                </profile>
                <profile id="a4c4-103d-8dd9-669f" name="Bless" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="27">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Battle Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">2</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">24 inches</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">A friendly unit gains +1 to shooting and close-combat hit rolls.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Remains in play</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 27</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                  </characteristics>
                </profile>
                <profile id="68fb-fd30-d95b-95c6" name="Protect" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="27">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Battle Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">3</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">24 inches</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">A friendly unit gains a 4+ special save against each wound.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Remains in play</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 27</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule id="be63-bea8-b6e5-7f45" name="Spell deck reference" hidden="false">
                  <description>Entire reference deck, not spells known. Draw/choose the permitted number before battle; record them in roster notes. Necromancy uses chosen spells and High Magic its special dealing rules.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry id="2b5f-6da1-936d-ce15" name="Dark Magic" type="upgrade" hidden="false" collective="false" import="true">
              <costs>
                <cost name="pts" typeId="0044-15f1-782b-00ea" value="0" />
              </costs>
              <constraints>
                <constraint id="9d66-a6ce-2b8e-d7d6" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
              </constraints>
              <profiles>
                <profile id="d7ef-32a3-e5aa-6ef0" name="Arnizipal’s Black Horror" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="25">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Dark Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">3</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">4D6 inches</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">Move the Black Horror template 4D6 inches immediately and the same direction at the start of later magic phases. Models passed over die unless they roll under Strength on D6; only magical armour may save. Units taking casualties test Panic.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Remains in play</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 25</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                  </characteristics>
                </profile>
                <profile id="80c7-f398-22d7-9102" name="Blade Wind" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="25">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Dark Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">2</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">24 inches</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">The first unit in its path suffers 3D6 hits minus its Weapon Skill. Each hit wounds on 4+.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 25</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                  </characteristics>
                </profile>
                <profile id="993f-8767-eefe-657f" name="Dark Hand of Destruction" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="25">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Dark Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">1</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">Base contact</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">Make one melee attack on a touching enemy. If it hits it inflicts D3 wounds; only magic armour may save.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 25</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                  </characteristics>
                </profile>
                <profile id="9f9f-9d95-dcf6-15cc" name="Death Spasm" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="25">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Dark Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">2</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">18 inches</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">The first model in the bolt's path dies if a D6 exceeds its Toughness. It inflicts one hit at its own Strength on each model touching it. This is an outright kill with no armour or wound-based saves. Line of sight required.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 25</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                  </characteristics>
                </profile>
                <profile id="2d85-0ba8-6f3d-a24b" name="Doombolt" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="25">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Dark Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">2</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">18 inches</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">The first model in its path suffers D6 S5 hits. Against a chariot, war machine or building these are D6 S10 hits.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 25</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                  </characteristics>
                </profile>
                <profile id="5d74-10ee-8a6b-2b8b" name="Malediction of Nagash" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="25">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Dark Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">3</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">36 inches</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">The target unit cannot move or shoot; it may fight at -2 WS and -2 Initiative. At the start of each subsequent magic phase it suffers D3 wounds with no armour saves.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Remains in play</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 25</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                  </characteristics>
                </profile>
                <profile id="e5f7-52b8-578b-e739" name="Power of Chaos" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="25">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Dark Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">1</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">Caster</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">Roll D6: 1 kills the caster; 2–5 draw three additional magic cards; 6 draw six.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 25</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                  </characteristics>
                </profile>
                <profile id="1ba9-728e-f705-d786" name="Soul Drain" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="25">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Dark Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">3</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">24 inches</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">Place the Soul Drain template in range. Each covered model suffers an S4 hit; only magic armour may save. For every two wounds caused the caster gains one Wound, which may exceed his starting total.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 25</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                  </characteristics>
                </profile>
                <profile id="12ca-4f6e-fbae-71c7" name="The Transformation of Kadon" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="25">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Dark Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">3</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">Caster</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">Transform into a Chimera, Manticore, Hydra or Wyvern. While transformed, cannot cast spells but may use dispels. Carry wounds between forms.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Remains in play</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 25</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                  </characteristics>
                </profile>
                <profile id="b532-116a-faeb-eaa6" name="Witch Flight" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="25">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Dark Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">1</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">Anywhere on the battlefield</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">Transport the caster anywhere on the battlefield, including into melee; he then counts as charging in the first round.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 25</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                  </characteristics>
                </profile>
              </profiles>
