    <selectionEntry id="f2fc-d103-8a2c-f7b7" name="Walach Harkon" type="model" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="79">
      <costs>
        <cost name="pts" typeId="0044-15f1-782b-00ea" value="550" />
      </costs>
      <categoryLinks>
        <categoryLink id="3e8e-e1bf-50b3-456d" name="Characters" targetId="0114-02b1-a20d-82f1" primary="true" hidden="false" />
      </categoryLinks>
      <profiles>
        <profile id="f8d6-5f77-4fa2-1d62" name="Walach Harkon" typeId="e25d-f63f-8d67-4bda" typeName="Unit" hidden="false" publicationId="c115-e636-a63a-a216" page="79">
          <characteristics>
            <characteristic name="M" typeId="df0b-cf43-1955-6845">6</characteristic>
            <characteristic name="WS" typeId="c83c-b081-d246-d5ef">9</characteristic>
            <characteristic name="BS" typeId="960a-0c90-a448-96b4">6</characteristic>
            <characteristic name="S" typeId="639b-d234-7e46-084b">7</characteristic>
            <characteristic name="T" typeId="6a8e-5ca4-9d4e-d596">6</characteristic>
            <characteristic name="W" typeId="8a8d-ce29-476c-e0fa">4</characteristic>
            <characteristic name="I" typeId="946e-86c4-ffce-c3ed">9</characteristic>
            <characteristic name="A" typeId="4cc5-d3f5-26a7-37c2">5</characteristic>
            <characteristic name="Ld" typeId="cedc-6339-9f57-49bd">10</characteristic>
          </characteristics>
        </profile>
        <profile id="8176-1ef1-48a9-67b7" name="Barded Nightmare" typeId="e25d-f63f-8d67-4bda" typeName="Unit" hidden="false" publicationId="c115-e636-a63a-a216" page="79">
          <characteristics>
            <characteristic name="M" typeId="df0b-cf43-1955-6845">8</characteristic>
            <characteristic name="WS" typeId="c83c-b081-d246-d5ef">2</characteristic>
            <characteristic name="BS" typeId="960a-0c90-a448-96b4">0</characteristic>
            <characteristic name="S" typeId="639b-d234-7e46-084b">3</characteristic>
            <characteristic name="T" typeId="6a8e-5ca4-9d4e-d596">3</characteristic>
            <characteristic name="W" typeId="8a8d-ce29-476c-e0fa">1</characteristic>
            <characteristic name="I" typeId="946e-86c4-ffce-c3ed">2</characteristic>
            <characteristic name="A" typeId="4cc5-d3f5-26a7-37c2">1</characteristic>
            <characteristic name="Ld" typeId="cedc-6339-9f57-49bd">5</characteristic>
          </characteristics>
        </profile>
        <profile id="9172-3b03-aef0-2ad8" name="Crimson Blade" typeId="b93a-4f1c-9871-3028" typeName="Magic item" hidden="false" publicationId="c115-e636-a63a-a216" page="79">
          <characteristics>
            <characteristic name="Type" typeId="7ef9-9797-693d-d937">Magic weapon</characteristic>
            <characteristic name="Effect" typeId="d277-fc43-48d0-6dce">For every unsaved wound roll D6: 1–3 also removes one Attack; 4–5 removes one Move; 6 beheads and kills. Penalties accumulate and can reduce to zero. A slowed model separates from its unit if the unit moves faster.</characteristic>
            <characteristic name="Reference" typeId="2fa3-15cf-fc7d-e42b">Vampire Counts, printed p. 79. Card value 75 points, included in the character total.</characteristic>
            <characteristic name="Coverage" typeId="23f7-abf1-238e-1daa">Book-checked summary; fixed loadout</characteristic>
          </characteristics>
        </profile>
        <profile id="8b87-6a26-337f-371d" name="Blood Chalice" typeId="b93a-4f1c-9871-3028" typeName="Magic item" hidden="false" publicationId="c115-e636-a63a-a216" page="79">
          <characteristics>
            <characteristic name="Type" typeId="7ef9-9797-693d-d937">Enchanted item</characteristic>
            <characteristic name="Effect" typeId="d277-fc43-48d0-6dce">At each own turn start choose: heal one wound up to starting Wounds; gain +1 Attack until next own turn; or sword counts as flaming and each wound becomes two until next own turn.</characteristic>
            <characteristic name="Reference" typeId="2fa3-15cf-fc7d-e42b">Vampire Counts, printed p. 79. Card value 25 points, included in the character total.</characteristic>
            <characteristic name="Coverage" typeId="23f7-abf1-238e-1daa">Book-checked summary; fixed loadout</characteristic>
          </characteristics>
        </profile>
        <profile id="969a-bb40-4d94-e1d5" name="Blood Dragon Standard" typeId="b93a-4f1c-9871-3028" typeName="Magic item" hidden="false" publicationId="c115-e636-a63a-a216" page="79">
          <characteristics>
            <characteristic name="Type" typeId="7ef9-9797-693d-d937">Magic standard</characteristic>
            <characteristic name="Effect" typeId="d277-fc43-48d0-6dce">Army battle standard. Undead within 12 inches re-roll To Hit in the first round of their first melee against living opponents. No repeat benefit in later combats; does not work against Undead, Daemons or other nonliving enemies.</characteristic>
            <characteristic name="Reference" typeId="2fa3-15cf-fc7d-e42b">Vampire Counts, printed p. 79. Card value 50 points, included in the character total.</characteristic>
            <characteristic name="Coverage" typeId="23f7-abf1-238e-1daa">Book-checked summary; fixed loadout</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <constraints>
        <constraint id="6dd5-27f2-a913-8718" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
        <constraint id="10bf-749e-f887-a0e7" type="max" value="1" scope="roster" field="selections" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" />
        <constraint id="f714-cd5d-8706-081f" type="max" value="0" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
        <constraint id="0692-73da-1f6b-f2d1" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
        <constraint id="d416-8c4b-5545-2725" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
      </constraints>
      <rules>
        <rule id="2824-1e81-8eaa-2e54" name="Special character" hidden="false">
          <description>Unique named selection. 550 points includes the complete listed fixed equipment, companions, powers and mounts; only separately offered options add points. Printed profiles are before magic-item bonuses unless a rule says they are already included. Special-character use requires the players’ agreement under the books’ convention.</description>
        </rule>
        <rule id="1b61-584b-dbb3-8202" name="Included equipment" hidden="false">
          <description>Heavy armour; shield; Crimson Blade; barded Nightmare.</description>
        </rule>
        <rule id="8f74-8ad1-026c-3da4" name="Fixed power adjustments" hidden="false" publicationId="c115-e636-a63a-a216" page="79">
          <description>Might of Arms and Red Fury are already included in the printed profile. Strength of Steel permits spellcasting in normal armour; Doomrider ignores the Nightmare’s armour/barding movement penalty. Reference: Vampire Counts, printed p. 79.</description>
        </rule>
        <rule id="a6e3-838b-b659-9f59" name="Magic and spell allocation" hidden="false">
          <description>Magic level 3; 2 spells. Printed spell count already includes fixed bloodline effects; do not add those bonuses again. The lore profiles are reference decks, not a grant of all spells. Choose/draw the permitted spells before play and record them in roster notes.</description>
        </rule>
        <rule id="709a-a4a1-ff2b-3ece" name="Fixed bloodline" hidden="false">
          <description>Blood Dragon. Select this family in Core rules and army reference. All listed powers are already included; no extra powers may be purchased.</description>
        </rule>
        <rule id="01c2-3879-303c-2101" name="Bloodline: Doomrider" hidden="false" publicationId="c115-e636-a63a-a216" page="29">
          <description>A ridden Nightmare ignores movement penalties from armour and barding.</description>
        </rule>
        <rule id="e98a-4186-8337-236f" name="Bloodline: Might of Arms" hidden="false" publicationId="c115-e636-a63a-a216" page="29">
          <description>Add one Weapon Skill. Already included in Walach’s printed profile.</description>
        </rule>
        <rule id="9b7b-9264-527c-bf53" name="Bloodline: Strength of Steel" hidden="false" publicationId="c115-e636-a63a-a216" page="29">
          <description>May cast spells while wearing normal armour.</description>
        </rule>
        <rule id="a2bb-0977-5e0a-c450" name="Bloodline: Red Fury" hidden="false" publicationId="c115-e636-a63a-a216" page="29">
          <description>Add one Attack. Already included in Walach’s printed profile.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="b445-97aa-a51e-e543" name="Vampires" targetId="1e6d-5f93-94e7-b409" type="rule" hidden="false" publicationId="c115-e636-a63a-a216" page="50" />
        <infoLink id="9fae-8bd0-e95b-f93f" name="Armour, shield and barding" targetId="1d9b-1051-0031-be6d" type="rule" hidden="false" publicationId="d7c9-7773-4408-58f6" page="15, 30, 37" />
        <infoLink id="d2e0-325f-dc63-b8be" name="General" targetId="d1ba-1b25-c83e-0e46" type="rule" hidden="false" publicationId="d7c9-7773-4408-58f6" page="88" />
        <infoLink id="0c37-2796-b5f1-6c09" name="Battle Standard" targetId="e82b-0d7a-a594-4ca4" type="rule" hidden="false" publicationId="d7c9-7773-4408-58f6" page="88" />
        <infoLink id="4c7f-970f-04e7-1a18" name="Magic phase and Winds of Magic" targetId="51af-8134-e1d0-5c8f" type="rule" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="9–12" />
        <infoLink id="0375-cc1a-280e-d6ce" name="Counter magic and natural dispels" targetId="a2e7-268a-edde-1495" type="rule" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="10–14" />
        <infoLink id="8181-87ae-47aa-59af" name="Winds of Magic special cards" targetId="0d22-3d38-e047-8557" type="rule" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="9–10" />
        <infoLink id="4185-3eb6-8598-c91f" name="Spells remaining in play" targetId="b403-7328-b3ca-4dd7" type="rule" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="11–14" />
        <infoLink id="7629-4eb4-f578-c002" name="Spell targets, sight and templates" targetId="34de-d976-f1cf-5402" type="rule" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="12, 22" />
      </infoLinks>
      <selectionEntryGroups>
        <selectionEntryGroup id="d3e2-95c2-aca3-3187" name="Magic lore" hidden="false" collective="false" import="true" defaultSelectionEntryId="9fa7-687f-1004-d4bc">
          <constraints>
            <constraint id="61a5-0d74-d4b7-6966" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
            <constraint id="d1a2-b01f-bdec-4092" type="min" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <selectionEntries>
            <selectionEntry id="9fa7-687f-1004-d4bc" name="Necromantic Magic" type="upgrade" hidden="false" collective="false" import="true">
              <costs>
                <cost name="pts" typeId="0044-15f1-782b-00ea" value="0" />
              </costs>
              <constraints>
                <constraint id="1979-72f0-b345-e734" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
              </constraints>
              <infoLinks>
                <infoLink id="caec-5f54-be97-11cf" name="Necromancy and recasting" targetId="369a-00ed-fa25-3a9d" type="rule" hidden="false" publicationId="c115-e636-a63a-a216" page="31" />
              </infoLinks>
              <profiles>
                <profile id="df32-f78f-2aa6-5e42" name="Drain Life" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="26">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Necromantic Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">2</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">2D6-inch radius</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">Living models in the rolled radius suffer S3 hits with no armour saves. Use wounds inflicted to restore the caster's lost wounds, up to his starting total. Undead, Daemons and objects are unaffected. Characters cannot use Look Out Sir; hit living crew/components of composite models.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 26</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">Reference deck; not automatically known</characteristic>
                  </characteristics>
                </profile>
                <profile id="fe73-29c6-4496-5f54" name="Gaze of Nagash" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="26">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Necromantic Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">2</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">18 inches</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">The first unit in its path suffers 2D6 S4 hits with no armour saves.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 26</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">Reference deck; not automatically known</characteristic>
                  </characteristics>
                </profile>
                <profile id="99e2-f754-f267-f0f5" name="Hand of Dust" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="26">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Necromantic Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">2</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">Base contact</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">Both caster and one melee opponent roll D6 plus Strength; double the caster's total. Each point by which the caster wins inflicts one wound with no armour save. A slain victim becomes a friendly Wight, or a Wraith if it was a wizard.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 26</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">Reference deck; not automatically known</characteristic>
                  </characteristics>
                </profile>
                <profile id="b747-ba81-630b-7623" name="The Dark Mist" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="26">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Necromantic Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">1</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">Caster</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">Move up to 24 inches in your movement phase, through terrain and buildings but not living models. Cannot make melee attacks; may cast spells. Only magical weapons and spells can harm the caster. Combat-result defeat is still possible and fleeing ends the effect (Vampire Counts p. 31).</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Remains in play</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 26</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">Reference deck; not automatically known</characteristic>
                  </characteristics>
                </profile>
                <profile id="6429-e615-5b53-adfc" name="Raise the Dead" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="26">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Necromantic Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">2</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">24 inches</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">Raise 2D6 Skeletons or Zombies into an existing unit of that type in range, or make a new unit if at least five are raised. Apply the equipment and victory-point rules in Vampire Counts p. 31.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 26</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">Reference deck; not automatically known</characteristic>
                  </characteristics>
                </profile>
                <profile id="b736-40fe-4ae9-2925" name="Summon Skeletons" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="26">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Necromantic Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">1</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">18 inches</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">Raise D6 Skeletons or Zombies into an existing unit of that type in range, or make a new unit if at least five are raised. Apply Vampire Counts p. 31 for equipment and victory points.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 26</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">Reference deck; not automatically known</characteristic>
                  </characteristics>
                </profile>
                <profile id="851f-bcce-d22a-b371" name="Summon Undead Horde" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="26">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Necromantic Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">3</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">36 inches</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">Raise 3D6 Skeletons or Zombies into an existing unit of that type in range, or make a new unit if at least five are raised. Apply Vampire Counts p. 31 for equipment and victory points.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 26</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">Reference deck; not automatically known</characteristic>
                  </characteristics>
                </profile>
                <profile id="6fb9-3536-b888-4668" name="The Curse of Years" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="26">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Necromantic Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">3</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">24 inches</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">Roll per model in the target unit: 5+ kills it outright. At each later Undead magic phase improve the threshold by one (4+, then 3+, etc.). No armour or wound-based saves. Characters test too, without Look Out Sir; roll once for an entire composite model.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Remains in play</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 26</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">Reference deck; not automatically known</characteristic>
                  </characteristics>
                </profile>
                <profile id="1fa4-1ffb-e41b-8572" name="Vanhel’s Danse Macabre" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="26">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Necromantic Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">1</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">36 inches</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">One eligible regiment may charge, move, march, fight one round or shoot during the magic phase. For Vampire Counts use the updated p. 31 eligibility: Skeletons, Zombies, Wights (including mounted Wights and Lords), and Wraiths only.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 26</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">Reference deck; not automatically known</characteristic>
                  </characteristics>
                </profile>
                <profile id="2be2-2e5f-997d-9bef" name="Wind of Death" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="26">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Necromantic Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">3</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">From any table edge</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">Place its template at any table edge. Move 2D10 inches immediately, and the same direction at the start of later magic phases. Each model passed over suffers D6 wounds on 4+, with no armour saves.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Remains in play</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 26</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">Reference deck; not automatically known</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
      </selectionEntryGroups>
