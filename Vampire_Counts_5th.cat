                        <infoLink id="4ed6-a7c8-8b8b-1564" name="Ridden monsters and rider loss" targetId="70ef-ea27-1ae3-36d7" type="rule" hidden="false" publicationId="d7c9-7773-4408-58f6" page="68–70" />
                      </infoLinks>
                      <rules>
                        <rule id="d843-4467-5331-5c2a" name="Included equipment" hidden="false">
                          <description>Natural attacks.</description>
                        </rule>
                      </rules>
                    </selectionEntry>
                  </selectionEntries>
                </selectionEntryGroup>
