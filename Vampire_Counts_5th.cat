                    <selectionEntry id="c688-f8d0-9ad6-f696" name="Dark Magic" type="upgrade" hidden="false" collective="false" import="true">
                      <costs>
                        <cost name="pts" typeId="0044-15f1-782b-00ea" value="0" />
                      </costs>
                      <constraints>
                        <constraint id="c2a6-7811-e492-47c0" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                      </constraints>
                      <profiles>
                        <profile id="f2af-8f8b-4986-20f1" name="Arnizipal’s Black Horror" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="25">
                          <characteristics>
                            <characteristic name="Lore" typeId="d783-9c87-2677-5247">Dark Magic</characteristic>
                            <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">3</characteristic>
                            <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">4D6 inches</characteristic>
                            <characteristic name="Effect" typeId="d107-f119-4175-3647">Move the Black Horror template 4D6 inches immediately and the same direction at the start of later magic phases. Models passed over die unless they roll under Strength on D6; only magical armour may save. Units taking casualties test Panic.</characteristic>
                            <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Remains in play</characteristic>
                            <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 25</characteristic>
                            <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                          </characteristics>
                        </profile>
                        <profile id="b545-1091-16a8-f5f0" name="Blade Wind" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="25">
                          <characteristics>
                            <characteristic name="Lore" typeId="d783-9c87-2677-5247">Dark Magic</characteristic>
                            <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">2</characteristic>
                            <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">24 inches</characteristic>
                            <characteristic name="Effect" typeId="d107-f119-4175-3647">The first unit in its path suffers 3D6 hits minus its Weapon Skill. Each hit wounds on 4+.</characteristic>
                            <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                            <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 25</characteristic>
                            <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                          </characteristics>
                        </profile>
                        <profile id="0fe1-13e1-61bc-cdc3" name="Dark Hand of Destruction" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="25">
                          <characteristics>
                            <characteristic name="Lore" typeId="d783-9c87-2677-5247">Dark Magic</characteristic>
                            <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">1</characteristic>
                            <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">Base contact</characteristic>
                            <characteristic name="Effect" typeId="d107-f119-4175-3647">Make one melee attack on a touching enemy. If it hits it inflicts D3 wounds; only magic armour may save.</characteristic>
                            <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                            <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 25</characteristic>
                            <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                          </characteristics>
                        </profile>
                        <profile id="a4d0-e705-3288-bd7d" name="Death Spasm" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="25">
                          <characteristics>
                            <characteristic name="Lore" typeId="d783-9c87-2677-5247">Dark Magic</characteristic>
                            <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">2</characteristic>
                            <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">18 inches</characteristic>
                            <characteristic name="Effect" typeId="d107-f119-4175-3647">The first model in the bolt's path dies if a D6 exceeds its Toughness. It inflicts one hit at its own Strength on each model touching it. This is an outright kill with no armour or wound-based saves. Line of sight required.</characteristic>
                            <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                            <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 25</characteristic>
                            <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                          </characteristics>
                        </profile>
                        <profile id="a0b1-9b9f-0498-091a" name="Doombolt" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="25">
                          <characteristics>
                            <characteristic name="Lore" typeId="d783-9c87-2677-5247">Dark Magic</characteristic>
                            <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">2</characteristic>
                            <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">18 inches</characteristic>
                            <characteristic name="Effect" typeId="d107-f119-4175-3647">The first model in its path suffers D6 S5 hits. Against a chariot, war machine or building these are D6 S10 hits.</characteristic>
                            <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                            <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 25</characteristic>
                            <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                          </characteristics>
                        </profile>
                        <profile id="7a19-df3f-28d6-c35c" name="Malediction of Nagash" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="25">
                          <characteristics>
                            <characteristic name="Lore" typeId="d783-9c87-2677-5247">Dark Magic</characteristic>
                            <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">3</characteristic>
                            <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">36 inches</characteristic>
                            <characteristic name="Effect" typeId="d107-f119-4175-3647">The target unit cannot move or shoot; it may fight at -2 WS and -2 Initiative. At the start of each subsequent magic phase it suffers D3 wounds with no armour saves.</characteristic>
                            <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Remains in play</characteristic>
                            <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 25</characteristic>
                            <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                          </characteristics>
                        </profile>
                        <profile id="ab7b-c14b-739c-ba62" name="Power of Chaos" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="25">
                          <characteristics>
                            <characteristic name="Lore" typeId="d783-9c87-2677-5247">Dark Magic</characteristic>
                            <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">1</characteristic>
                            <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">Caster</characteristic>
                            <characteristic name="Effect" typeId="d107-f119-4175-3647">Roll D6: 1 kills the caster; 2–5 draw three additional magic cards; 6 draw six.</characteristic>
                            <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                            <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 25</characteristic>
                            <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                          </characteristics>
                        </profile>
                        <profile id="b885-9029-de5d-325f" name="Soul Drain" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="25">
                          <characteristics>
                            <characteristic name="Lore" typeId="d783-9c87-2677-5247">Dark Magic</characteristic>
                            <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">3</characteristic>
                            <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">24 inches</characteristic>
                            <characteristic name="Effect" typeId="d107-f119-4175-3647">Place the Soul Drain template in range. Each covered model suffers an S4 hit; only magic armour may save. For every two wounds caused the caster gains one Wound, which may exceed his starting total.</characteristic>
                            <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                            <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 25</characteristic>
                            <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                          </characteristics>
                        </profile>
                        <profile id="c974-fd28-3fd2-ea2c" name="The Transformation of Kadon" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="25">
                          <characteristics>
                            <characteristic name="Lore" typeId="d783-9c87-2677-5247">Dark Magic</characteristic>
                            <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">3</characteristic>
                            <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">Caster</characteristic>
                            <characteristic name="Effect" typeId="d107-f119-4175-3647">Transform into a Chimera, Manticore, Hydra or Wyvern. While transformed, cannot cast spells but may use dispels. Carry wounds between forms.</characteristic>
                            <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Remains in play</characteristic>
                            <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 25</characteristic>
                            <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                          </characteristics>
                        </profile>
                        <profile id="986c-c4f7-6fe3-fd9d" name="Witch Flight" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="25">
                          <characteristics>
                            <characteristic name="Lore" typeId="d783-9c87-2677-5247">Dark Magic</characteristic>
                            <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">1</characteristic>
                            <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">Anywhere on the battlefield</characteristic>
                            <characteristic name="Effect" typeId="d107-f119-4175-3647">Transport the caster anywhere on the battlefield, including into melee; he then counts as charging in the first round.</characteristic>
                            <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                            <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 25</characteristic>
                            <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                          </characteristics>
                        </profile>
                      </profiles>
