                      </constraints>
                      <infoLinks>
                        <infoLink id="d4da-287d-fe8a-bff9" name="Armour, shield and barding" targetId="1d9b-1051-0031-be6d" type="rule" hidden="false" publicationId="d7c9-7773-4408-58f6" page="15, 30, 37" />
                      </infoLinks>
                    </selectionEntry>
                  </selectionEntries>
                </selectionEntryGroup>
                <selectionEntryGroup id="067a-49fe-7609-6493" name="Bloodline powers" hidden="false" collective="false" import="true">
                  <constraints>
                    <constraint id="917c-d830-5aec-a175" type="max" value="2" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" />
                    <constraint id="da52-1e0e-447d-7989" type="min" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" />
                  </constraints>
                  <selectionEntryGroups>
                    <selectionEntryGroup id="1635-22bb-7cf2-4f2a" name="Von Carstein" hidden="false" collective="false" import="true">
                      <constraints>
                        <constraint id="57e0-5cc2-e3dc-5875" type="max" value="0" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                      </constraints>
                      <modifiers>
                        <modifier type="set" field="57e0-5cc2-e3dc-5875" value="2">
                          <conditions>
                            <condition type="atLeast" field="selections" scope="roster" value="1" childId="20ca-22ed-4fa6-aa36" shared="true" includeChildSelections="true" includeChildForces="false" percentValue="false" />
                          </conditions>
                        </modifier>
                      </modifiers>
                      <selectionEntries>
                        <selectionEntry id="bb72-c2b8-0469-3295" name="Pure Blood" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="27">
                          <costs>
                            <cost name="pts" typeId="0044-15f1-782b-00ea" value="5" />
                          </costs>
                          <constraints>
                            <constraint id="b006-b25d-6f0b-2c4c" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                          </constraints>
                          <rules>
                            <rule id="4e9d-c8ee-e87b-6397" name="Pure Blood" hidden="false">
                              <description>Allows this Vampire to buy the Carstein Ring. Reference: Vampire Counts p. 27.</description>
                            </rule>
                          </rules>
                        </selectionEntry>
                        <selectionEntry id="4dc5-2335-66bd-77a0" name="Wolf Form" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="27">
                          <costs>
                            <cost name="pts" typeId="0044-15f1-782b-00ea" value="5" />
                          </costs>
                          <constraints>
                            <constraint id="5ad0-1b5b-446c-32f2" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                          </constraints>
                          <rules>
                            <rule id="bc29-5171-b234-34d1" name="Wolf Form" hidden="false">
                              <description>On foot, use Move 9 for normal movement, including marches; does not change charge, flee or pursuit distance. Reference: Vampire Counts p. 27.</description>
                            </rule>
                          </rules>
                        </selectionEntry>
                        <selectionEntry id="b386-6299-2f38-551c" name="Honour or Death" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="27">
                          <costs>
                            <cost name="pts" typeId="0044-15f1-782b-00ea" value="10" />
                          </costs>
                          <constraints>
                            <constraint id="c911-e378-1f6a-e3b1" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                          </constraints>
                          <rules>
                            <rule id="9ba3-b095-fa29-7a7d" name="Honour or Death" hidden="false">
                              <description>Must accept enemy challenges. Before the challengers move together, the enemy character tests basic Leadership with no modifiers. A psychology-immune character ignores this. On failure the enemy hides in the rear, no challenge is fought, and the Vampire fights ordinary opponents in contact. Reference: Vampire Counts p. 27.</description>
                            </rule>
                          </rules>
                        </selectionEntry>
                        <selectionEntry id="b9ec-8374-9aad-c906" name="Unbending Willpower" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="27">
                          <costs>
                            <cost name="pts" typeId="0044-15f1-782b-00ea" value="10" />
                          </costs>
                          <constraints>
                            <constraint id="329a-e3db-68df-f0d0" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                          </constraints>
                          <rules>
                            <rule id="77b5-89ae-4f97-b401" name="Unbending Willpower" hidden="false">
                              <description>An Undead unit led by this Vampire suffers one fewer crumbling wound from losing combat. If the General dies, its D6 loss becomes D6−1. Reference: Vampire Counts p. 27.</description>
                            </rule>
                          </rules>
                        </selectionEntry>
                        <selectionEntry id="2684-c434-ffa5-846f" name="Transfix" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="27">
                          <costs>
                            <cost name="pts" typeId="0044-15f1-782b-00ea" value="20" />
                          </costs>
                          <constraints>
                            <constraint id="d4e5-b718-6be9-fe02" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                          </constraints>
                          <rules>
                            <rule id="13de-876d-fa3c-dba2" name="Transfix" hidden="false">
                              <description>At the start of melee choose one enemy in base contact. It tests basic Leadership, without modifiers; on failure it cannot attack and attacks against it hit automatically. Psychology-immune models are unaffected. Reference: Vampire Counts p. 27.</description>
                            </rule>
                          </rules>
                        </selectionEntry>
                        <selectionEntry id="2941-c989-e0dc-5757" name="Summon Wolves" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="27">
                          <costs>
                            <cost name="pts" typeId="0044-15f1-782b-00ea" value="30" />
                          </costs>
                          <constraints>
                            <constraint id="44e9-3e0e-8ce3-656b" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                          </constraints>
                          <rules>
                            <rule id="8153-f874-5fbf-57d6" name="Summon Wolves" hidden="false">
                              <description>Summon D3+1 Dire Wolves. One use at the start of your turn. Random edge: 1 your edge, 2–3 left, 4–5 right, 6 enemy edge. Place centrally on that edge; the arrivals may move but not charge that turn. Reference: Vampire Counts p. 27.</description>
                            </rule>
                          </rules>
                        </selectionEntry>
                        <selectionEntry id="0dea-fc88-4d33-8447" name="Bat Form" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="27">
                          <costs>
                            <cost name="pts" typeId="0044-15f1-782b-00ea" value="40" />
                          </costs>
                          <constraints>
                            <constraint id="7b6e-45c0-b690-037c" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                          </constraints>
                          <rules>
                            <rule id="81ef-304a-c5ed-7d58" name="Bat Form" hidden="false">
                              <description>On foot, move up to 24 inches ignoring intervening terrain during normal movement; this does not change charge, flee or pursuit movement. Reference: Vampire Counts p. 27.</description>
                            </rule>
                          </rules>
                        </selectionEntry>
                      </selectionEntries>
                    </selectionEntryGroup>
                    <selectionEntryGroup id="1f4e-db79-dab0-e16c" name="Necrarch" hidden="false" collective="false" import="true">
                      <constraints>
                        <constraint id="b109-a4da-4fb8-a519" type="max" value="0" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                      </constraints>
                      <modifiers>
                        <modifier type="set" field="b109-a4da-4fb8-a519" value="2">
                          <conditions>
                            <condition type="atLeast" field="selections" scope="roster" value="1" childId="b19a-d86d-7a8a-76f6" shared="true" includeChildSelections="true" includeChildForces="false" percentValue="false" />
                          </conditions>
                        </modifier>
                      </modifiers>
                      <selectionEntries>
                        <selectionEntry id="e934-21e6-1e2f-f848" name="Dark Acolyte" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="28">
                          <costs>
                            <cost name="pts" typeId="0044-15f1-782b-00ea" value="5" />
                          </costs>
                          <constraints>
                            <constraint id="c4ef-1070-459b-2604" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                          </constraints>
                          <rules>
                            <rule id="c4df-28dd-5453-0f83" name="Dark Acolyte" hidden="false">
                              <description>May carry a Dispel Magic Scroll and retain one magic card between phases. This alone does not make a Thrall a wizard. Reference: Vampire Counts p. 28.</description>
                            </rule>
                          </rules>
                        </selectionEntry>
                        <selectionEntry id="daf2-ecb7-33c6-3a51" name="Unbending Willpower" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="28">
                          <costs>
                            <cost name="pts" typeId="0044-15f1-782b-00ea" value="10" />
                          </costs>
                          <constraints>
                            <constraint id="5aa8-4412-c358-ca5e" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                          </constraints>
                          <rules>
                            <rule id="81e0-f916-b405-5bc0" name="Unbending Willpower" hidden="false">
                              <description>Reduce combat-loss crumbling by one for this Vampire or the Undead unit he leads. Its loss on the General's death becomes D6−1. Reference: Vampire Counts p. 28.</description>
                            </rule>
                          </rules>
                        </selectionEntry>
                        <selectionEntry id="e352-4c21-ee76-19e0" name="The Awakening" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="28">
                          <costs>
                            <cost name="pts" typeId="0044-15f1-782b-00ea" value="20" />
                          </costs>
                          <constraints>
                            <constraint id="cfa9-ea1d-7ae9-b9e5" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                          </constraints>
                          <rules>
                            <rule id="899a-988f-3f6a-816a" name="The Awakening" hidden="false">
                              <description>Add D3 raised models when casting Summon Skeletons, Raise the Dead or Summon Undead Horde. Reference: Vampire Counts p. 28.</description>
                            </rule>
                          </rules>
                        </selectionEntry>
                        <selectionEntry id="efd1-c708-1598-5311" name="Master of the Black Arts" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="28">
                          <costs>
                            <cost name="pts" typeId="0044-15f1-782b-00ea" value="25" />
                          </costs>
                          <constraints>
                            <constraint id="6b58-7427-8f68-b3ea" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                          </constraints>
                          <rules>
                            <rule id="2c64-28c7-db14-2135" name="Master of the Black Arts" hidden="false">
                              <description>Add one to rolls to recast Necromantic spells. Reference: Vampire Counts p. 28.</description>
                            </rule>
                          </rules>
                        </selectionEntry>
                        <selectionEntry id="9093-6cda-8f82-5019" name="Supernatural Horror" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="28">
                          <costs>
                            <cost name="pts" typeId="0044-15f1-782b-00ea" value="30" />
                          </costs>
                          <constraints>
                            <constraint id="2591-1fb0-ff42-21b5" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                          </constraints>
                          <rules>
                            <rule id="4577-feef-b9e6-090b" name="Supernatural Horror" hidden="false">
                              <description>Causes terror. Reference: Vampire Counts p. 28.</description>
                            </rule>
                          </rules>
                        </selectionEntry>
                        <selectionEntry id="c547-787d-e1f7-3a7d" name="Forbidden Lore" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="28">
                          <costs>
                            <cost name="pts" typeId="0044-15f1-782b-00ea" value="40" />
                          </costs>
                          <constraints>
                            <constraint id="cdc6-1981-b47d-a5bf" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                          </constraints>
                          <rules>
                            <rule id="f904-2c6a-b661-4c08" name="Forbidden Lore" hidden="false">
                              <description>Receives one additional spell; magic level is unchanged. Reference: Vampire Counts p. 28.</description>
                            </rule>
                          </rules>
                        </selectionEntry>
                        <selectionEntry id="2cfb-ae37-7bed-d6a0" name="Curse of the Revenant" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="28">
                          <costs>
                            <cost name="pts" typeId="0044-15f1-782b-00ea" value="50" />
                          </costs>
                          <constraints>
                            <constraint id="eba8-ff2e-11a4-46a8" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                          </constraints>
                          <rules>
                            <rule id="493a-d9fc-5563-4a01" name="Curse of the Revenant" hidden="false">
                              <description>Add one Wound to the profile. Reference: Vampire Counts p. 28.</description>
                            </rule>
                          </rules>
                        </selectionEntry>
                      </selectionEntries>
                    </selectionEntryGroup>
                    <selectionEntryGroup id="42ee-4068-dea8-9639" name="Blood Dragon" hidden="false" collective="false" import="true">
                      <constraints>
                        <constraint id="1622-c37d-e3b4-b3e1" type="max" value="0" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                      </constraints>
                      <modifiers>
                        <modifier type="set" field="1622-c37d-e3b4-b3e1" value="2">
                          <conditions>
                            <condition type="atLeast" field="selections" scope="roster" value="1" childId="2dce-9d08-bbf3-cd0f" shared="true" includeChildSelections="true" includeChildForces="false" percentValue="false" />
                          </conditions>
                        </modifier>
                      </modifiers>
                      <selectionEntries>
                        <selectionEntry id="b2f5-4264-cb48-7c2d" name="Doomrider" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="29">
                          <costs>
                            <cost name="pts" typeId="0044-15f1-782b-00ea" value="5" />
                          </costs>
                          <constraints>
                            <constraint id="9472-ccad-9da4-0f8a" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                          </constraints>
                          <rules>
                            <rule id="54cc-9249-618d-0555" name="Doomrider" hidden="false">
                              <description>A ridden Nightmare ignores movement penalties from armour and barding. Reference: Vampire Counts p. 29.</description>
                            </rule>
                          </rules>
                        </selectionEntry>
                        <selectionEntry id="c678-55a9-8384-dcf1" name="Honour or Death" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="29">
                          <costs>
                            <cost name="pts" typeId="0044-15f1-782b-00ea" value="10" />
                          </costs>
                          <constraints>
                            <constraint id="4295-fd83-85bb-88fa" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                          </constraints>
                          <rules>
                            <rule id="d978-2f35-a414-3e80" name="Honour or Death" hidden="false">
                              <description>Must accept enemy challenges. Before the challengers move together, the enemy character tests basic Leadership with no modifiers. A psychology-immune character ignores this. On failure the enemy hides in the rear, no challenge is fought, and the Vampire fights ordinary opponents in contact. Reference: Vampire Counts p. 29.</description>
                            </rule>
                          </rules>
                        </selectionEntry>
                        <selectionEntry id="2d69-8810-a719-f8d0" name="Might of Arms" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="29">
                          <costs>
                            <cost name="pts" typeId="0044-15f1-782b-00ea" value="10" />
                          </costs>
                          <constraints>
                            <constraint id="abba-9632-68a0-0615" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                          </constraints>
                          <rules>
                            <rule id="245f-0909-1f15-9912" name="Might of Arms" hidden="false">
                              <description>Add one Weapon Skill. Reference: Vampire Counts p. 29.</description>
                            </rule>
                          </rules>
                        </selectionEntry>
                        <selectionEntry id="ee05-0bda-2cdb-187f" name="Strength of Steel" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="29">
                          <costs>
                            <cost name="pts" typeId="0044-15f1-782b-00ea" value="10" />
                          </costs>
                          <constraints>
                            <constraint id="221c-4df2-1eea-491b" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                          </constraints>
                          <rules>
                            <rule id="6b51-592d-aa58-6731" name="Strength of Steel" hidden="false">
                              <description>May cast spells while wearing normal armour. Reference: Vampire Counts p. 29.</description>
                            </rule>
                          </rules>
                        </selectionEntry>
                        <selectionEntry id="f446-a614-5599-374d" name="Blademaster" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="29">
                          <costs>
                            <cost name="pts" typeId="0044-15f1-782b-00ea" value="20" />
                          </costs>
                          <constraints>
                            <constraint id="dc93-6aa3-4ecf-6d15" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                          </constraints>
                          <rules>
                            <rule id="31d6-1eba-c41e-6a27" name="Blademaster" hidden="false">
                              <description>Choose one enemy in base contact to lose one Attack. For mixed attacks choose which kind is lost, including a mount attack or bite. Reference: Vampire Counts p. 29.</description>
                            </rule>
                          </rules>
                        </selectionEntry>
                        <selectionEntry id="1ecc-29ee-7d87-ee45" name="Warrior Pride" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="29">
                          <costs>
                            <cost name="pts" typeId="0044-15f1-782b-00ea" value="20" />
                          </costs>
                          <constraints>
                            <constraint id="26ae-300b-3d5b-af3b" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                          </constraints>
                          <rules>
                            <rule id="a6d6-c5cd-8aab-c15c" name="Warrior Pride" hidden="false">
                              <description>May cast spells while wearing normal or magical armour. Reference: Vampire Counts p. 29.</description>
                            </rule>
                          </rules>
                        </selectionEntry>
                        <selectionEntry id="f2a3-b10a-e85b-b905" name="Red Fury" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="29">
                          <costs>
                            <cost name="pts" typeId="0044-15f1-782b-00ea" value="25" />
                          </costs>
                          <constraints>
                            <constraint id="df89-1f17-3e84-a983" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                          </constraints>
                          <rules>
                            <rule id="9748-2857-c538-a129" name="Red Fury" hidden="false">
                              <description>Add one Attack. Reference: Vampire Counts p. 29.</description>
                            </rule>
                          </rules>
                        </selectionEntry>
                      </selectionEntries>
                    </selectionEntryGroup>
                    <selectionEntryGroup id="786b-006f-8341-3183" name="Lahmia" hidden="false" collective="false" import="true">
                      <constraints>
                        <constraint id="cc9b-e612-002c-bd7c" type="max" value="0" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                      </constraints>
                      <modifiers>
                        <modifier type="set" field="cc9b-e612-002c-bd7c" value="2">
                          <conditions>
                            <condition type="atLeast" field="selections" scope="roster" value="1" childId="261a-1963-87e7-5228" shared="true" includeChildSelections="true" includeChildForces="false" percentValue="false" />
                          </conditions>
                        </modifier>
                      </modifiers>
                      <selectionEntries>
                        <selectionEntry id="653f-2c56-3145-89e9" name="Lightning Reflexes" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="30">
                          <costs>
                            <cost name="pts" typeId="0044-15f1-782b-00ea" value="5" />
                          </costs>
                          <constraints>
                            <constraint id="40b1-613f-0197-0c36" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                          </constraints>
                          <rules>
                            <rule id="d14a-6dff-5032-b051" name="Lightning Reflexes" hidden="false">
                              <description>Initiative becomes 10. Reference: Vampire Counts p. 30.</description>
                            </rule>
                          </rules>
                        </selectionEntry>
                        <selectionEntry id="cc97-fd78-a410-cdbb" name="The Dead Walk Fast" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="30">
                          <costs>
                            <cost name="pts" typeId="0044-15f1-782b-00ea" value="5" />
                          </costs>
                          <constraints>
                            <constraint id="5dc5-9542-5551-9866" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                          </constraints>
                          <rules>
                            <rule id="2689-1ae0-fb84-0f04" name="The Dead Walk Fast" hidden="false">
                              <description>Add one Move. Reference: Vampire Counts p. 30.</description>
                            </rule>
                          </rules>
                        </selectionEntry>
                        <selectionEntry id="11e2-11f0-c0e8-7f0b" name="Swiftness" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="30">
                          <costs>
                            <cost name="pts" typeId="0044-15f1-782b-00ea" value="10" />
                          </costs>
                          <constraints>
                            <constraint id="335f-6358-06bb-3d6f" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                          </constraints>
                          <rules>
                            <rule id="c9a3-5173-fb96-42c2" name="Swiftness" hidden="false">
                              <description>On foot and alone, may march even with enemies within eight inches. Reference: Vampire Counts p. 30.</description>
                            </rule>
                          </rules>
                        </selectionEntry>
                        <selectionEntry id="a3ad-fb25-f144-11da" name="Transfix" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="30">
                          <costs>
                            <cost name="pts" typeId="0044-15f1-782b-00ea" value="20" />
                          </costs>
                          <constraints>
                            <constraint id="a1ed-bfe0-d676-eacd" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                          </constraints>
                          <rules>
                            <rule id="b91b-6f72-8f6a-7701" name="Transfix" hidden="false">
                              <description>At the start of melee choose one enemy in base contact. It tests basic Leadership, without modifiers; on failure it cannot attack and attacks against it hit automatically. Psychology-immune models are unaffected. Reference: Vampire Counts p. 30.</description>
                            </rule>
                          </rules>
                        </selectionEntry>
                        <selectionEntry id="fcbb-094e-6ff6-1e74" name="Quickblood" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="30">
                          <costs>
                            <cost name="pts" typeId="0044-15f1-782b-00ea" value="25" />
                          </costs>
                          <constraints>
                            <constraint id="cba2-237d-7ed5-8e50" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                          </constraints>
                          <rules>
                            <rule id="0294-beba-bf83-c115" name="Quickblood" hidden="false">
                              <description>Avoid each wound on 5+ before other saves and before multiplying wounds. Reference: Vampire Counts p. 30.</description>
                            </rule>
                          </rules>
                        </selectionEntry>
                        <selectionEntry id="d0f7-f57c-d53b-1d15" name="Innocence Lost" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="30">
                          <costs>
                            <cost name="pts" typeId="0044-15f1-782b-00ea" value="30" />
                          </costs>
                          <constraints>
                            <constraint id="9cc9-de5e-9d16-a2b1" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                          </constraints>
                          <rules>
                            <rule id="15af-310a-e612-8074" name="Innocence Lost" hidden="false">
                              <description>Always strikes first; against another first-strike ability use Initiative, then roll off ties. Reference: Vampire Counts p. 30.</description>
                            </rule>
                          </rules>
                        </selectionEntry>
                        <selectionEntry id="e231-d40c-b560-6395" name="Mist Form" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="30">
                          <costs>
                            <cost name="pts" typeId="0044-15f1-782b-00ea" value="40" />
                          </costs>
                          <constraints>
                            <constraint id="3135-0bbc-9ba5-51bc" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                          </constraints>
                          <rules>
                            <rule id="1fd3-7ef6-664a-b6d0" name="Mist Form" hidden="false">
                              <description>On foot, move up to 24 inches ignoring intervening terrain during normal movement; this does not change charge, flee or pursuit movement. Reference: Vampire Counts p. 30.</description>
                            </rule>
                          </rules>
                        </selectionEntry>
                      </selectionEntries>
                    </selectionEntryGroup>
                  </selectionEntryGroups>
                  <rules>
                    <rule id="3551-8e19-eb7b-e65c" name="Power effects" hidden="false">
                      <description>Apply profile changes, spell counts, armour exceptions and temporary effects manually. Power costs and family/rank eligibility are encoded; effects do not rewrite the printed profile.</description>
                    </rule>
                  </rules>
                </selectionEntryGroup>
                <selectionEntryGroup id="1a5e-7e84-a62c-ec4e" name="Magic lore" hidden="false" collective="false" import="true" defaultSelectionEntryId="128a-5f2a-dd23-1431">
                  <constraints>
                    <constraint id="33e6-e4e8-6010-5e2d" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                    <constraint id="f29d-acf2-72f4-49bc" type="min" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                  </constraints>
                  <selectionEntries>
                    <selectionEntry id="128a-5f2a-dd23-1431" name="Necromantic Magic" type="upgrade" hidden="false" collective="false" import="true">
                      <costs>
                        <cost name="pts" typeId="0044-15f1-782b-00ea" value="0" />
                      </costs>
                      <constraints>
                        <constraint id="b257-41fc-2114-7c81" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                      </constraints>
                      <infoLinks>
                        <infoLink id="ef94-21d3-4a63-e3ad" name="Necromancy and recasting" targetId="369a-00ed-fa25-3a9d" type="rule" hidden="false" publicationId="c115-e636-a63a-a216" page="31" />
                      </infoLinks>
                      <profiles>
                        <profile id="b96b-ec19-919f-397a" name="Drain Life" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="26">
                          <characteristics>
                            <characteristic name="Lore" typeId="d783-9c87-2677-5247">Necromantic Magic</characteristic>
                            <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">2</characteristic>
                            <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">2D6-inch radius</characteristic>
                            <characteristic name="Effect" typeId="d107-f119-4175-3647">Living models in the rolled radius suffer S3 hits with no armour saves. Use wounds inflicted to restore the caster's lost wounds, up to his starting total. Undead, Daemons and objects are unaffected. Characters cannot use Look Out Sir; hit living crew/components of composite models.</characteristic>
                            <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                            <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 26</characteristic>
                            <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                          </characteristics>
                        </profile>
                        <profile id="0aa5-a996-478b-f611" name="Gaze of Nagash" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="26">
                          <characteristics>
                            <characteristic name="Lore" typeId="d783-9c87-2677-5247">Necromantic Magic</characteristic>
                            <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">2</characteristic>
                            <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">18 inches</characteristic>
                            <characteristic name="Effect" typeId="d107-f119-4175-3647">The first unit in its path suffers 2D6 S4 hits with no armour saves.</characteristic>
                            <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                            <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 26</characteristic>
                            <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                          </characteristics>
                        </profile>
                        <profile id="6287-ccc8-f381-244e" name="Hand of Dust" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="26">
                          <characteristics>
                            <characteristic name="Lore" typeId="d783-9c87-2677-5247">Necromantic Magic</characteristic>
                            <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">2</characteristic>
                            <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">Base contact</characteristic>
                            <characteristic name="Effect" typeId="d107-f119-4175-3647">Both caster and one melee opponent roll D6 plus Strength; double the caster's total. Each point by which the caster wins inflicts one wound with no armour save. A slain victim becomes a friendly Wight, or a Wraith if it was a wizard.</characteristic>
                            <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                            <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 26</characteristic>
                            <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                          </characteristics>
                        </profile>
                        <profile id="14af-3b92-cf7b-8705" name="The Dark Mist" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="26">
                          <characteristics>
                            <characteristic name="Lore" typeId="d783-9c87-2677-5247">Necromantic Magic</characteristic>
                            <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">1</characteristic>
                            <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">Caster</characteristic>
                            <characteristic name="Effect" typeId="d107-f119-4175-3647">Move up to 24 inches in your movement phase, through terrain and buildings but not living models. Cannot make melee attacks; may cast spells. Only magical weapons and spells can harm the caster. Combat-result defeat is still possible and fleeing ends the effect (Vampire Counts p. 31).</characteristic>
                            <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Remains in play</characteristic>
                            <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 26</characteristic>
                            <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                          </characteristics>
                        </profile>
                        <profile id="30de-8c52-05f4-7286" name="Raise the Dead" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="26">
                          <characteristics>
                            <characteristic name="Lore" typeId="d783-9c87-2677-5247">Necromantic Magic</characteristic>
                            <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">2</characteristic>
                            <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">24 inches</characteristic>
                            <characteristic name="Effect" typeId="d107-f119-4175-3647">Raise 2D6 Skeletons or Zombies into an existing unit of that type in range, or make a new unit if at least five are raised. Apply the equipment and victory-point rules in Vampire Counts p. 31.</characteristic>
                            <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                            <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 26</characteristic>
                            <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                          </characteristics>
                        </profile>
                        <profile id="179b-8da6-5fd6-2c10" name="Summon Skeletons" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="26">
                          <characteristics>
                            <characteristic name="Lore" typeId="d783-9c87-2677-5247">Necromantic Magic</characteristic>
                            <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">1</characteristic>
                            <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">18 inches</characteristic>
                            <characteristic name="Effect" typeId="d107-f119-4175-3647">Raise D6 Skeletons or Zombies into an existing unit of that type in range, or make a new unit if at least five are raised. Apply Vampire Counts p. 31 for equipment and victory points.</characteristic>
                            <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                            <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 26</characteristic>
                            <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                          </characteristics>
                        </profile>
                        <profile id="cef0-5073-a89c-4097" name="Summon Undead Horde" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="26">
                          <characteristics>
                            <characteristic name="Lore" typeId="d783-9c87-2677-5247">Necromantic Magic</characteristic>
                            <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">3</characteristic>
                            <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">36 inches</characteristic>
                            <characteristic name="Effect" typeId="d107-f119-4175-3647">Raise 3D6 Skeletons or Zombies into an existing unit of that type in range, or make a new unit if at least five are raised. Apply Vampire Counts p. 31 for equipment and victory points.</characteristic>
                            <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                            <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 26</characteristic>
                            <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                          </characteristics>
                        </profile>
                        <profile id="2588-380e-233b-22ac" name="The Curse of Years" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="26">
                          <characteristics>
                            <characteristic name="Lore" typeId="d783-9c87-2677-5247">Necromantic Magic</characteristic>
                            <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">3</characteristic>
                            <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">24 inches</characteristic>
                            <characteristic name="Effect" typeId="d107-f119-4175-3647">Roll per model in the target unit: 5+ kills it outright. At each later Undead magic phase improve the threshold by one (4+, then 3+, etc.). No armour or wound-based saves. Characters test too, without Look Out Sir; roll once for an entire composite model.</characteristic>
                            <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Remains in play</characteristic>
                            <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 26</characteristic>
                            <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                          </characteristics>
                        </profile>
                        <profile id="3ec4-584b-ef49-fe4b" name="Vanhel’s Danse Macabre" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="26">
                          <characteristics>
                            <characteristic name="Lore" typeId="d783-9c87-2677-5247">Necromantic Magic</characteristic>
                            <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">1</characteristic>
                            <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">36 inches</characteristic>
                            <characteristic name="Effect" typeId="d107-f119-4175-3647">One eligible regiment may charge, move, march, fight one round or shoot during the magic phase. For Vampire Counts use the updated p. 31 eligibility: Skeletons, Zombies, Wights (including mounted Wights and Lords), and Wraiths only.</characteristic>
                            <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                            <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 26</characteristic>
                            <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                          </characteristics>
                        </profile>
                        <profile id="f8ac-4869-8057-6959" name="Wind of Death" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="26">
                          <characteristics>
                            <characteristic name="Lore" typeId="d783-9c87-2677-5247">Necromantic Magic</characteristic>
                            <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">3</characteristic>
                            <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">From any table edge</characteristic>
                            <characteristic name="Effect" typeId="d107-f119-4175-3647">Place its template at any table edge. Move 2D10 inches immediately, and the same direction at the start of later magic phases. Each model passed over suffers D6 wounds on 4+, with no armour saves.</characteristic>
                            <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Remains in play</characteristic>
                            <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 26</characteristic>
                            <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                          </characteristics>
                        </profile>
                      </profiles>
                      <rules>
                        <rule id="ea47-a01b-0cf9-7ea9" name="Spell deck reference" hidden="false">
                          <description>Entire reference deck, not spells known. Draw/choose the permitted number before battle; record them in roster notes. Necromancy uses chosen spells and High Magic its special dealing rules.</description>
                        </rule>
                      </rules>
                    </selectionEntry>
                    <selectionEntry id="fa07-48e1-23a7-589b" name="Battle Magic" type="upgrade" hidden="false" collective="false" import="true">
                      <costs>
                        <cost name="pts" typeId="0044-15f1-782b-00ea" value="0" />
                      </costs>
                      <constraints>
                        <constraint id="ae94-a3d8-91da-1ed7" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                      </constraints>
                      <profiles>
                        <profile id="1c9b-d990-483d-5a7f" name="Fireball" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="26">
                          <characteristics>
                            <characteristic name="Lore" typeId="d783-9c87-2677-5247">Battle Magic</characteristic>
                            <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">1</characteristic>
                            <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">24 inches</characteristic>
                            <characteristic name="Effect" typeId="d107-f119-4175-3647">Launch one fireball per magic level. Each strikes the first model in its path for one S4 hit, without armour saves. Line of sight required.</characteristic>
                            <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                            <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 26</characteristic>
                            <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                          </characteristics>
                        </profile>
                        <profile id="7c0c-bdc5-2b5b-2c2b" name="Destruction" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="26">
                          <characteristics>
                            <characteristic name="Lore" typeId="d783-9c87-2677-5247">Battle Magic</characteristic>
                            <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">2+</characteristic>
                            <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">18 inches</characteristic>
                            <characteristic name="Effect" typeId="d107-f119-4175-3647">An enemy unit suffers 2D6 S4 hits, without armour saves. The summary prints Power 2+ but does not explain the additional-power procedure; use the spell card for that detail.</characteristic>
                            <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                            <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 26</characteristic>
                            <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary only card detail required</characteristic>
                          </characteristics>
                        </profile>
                        <profile id="a466-8034-c244-7e82" name="Fear" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="26">
                          <characteristics>
                            <characteristic name="Lore" typeId="d783-9c87-2677-5247">Battle Magic</characteristic>
                            <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">2</characteristic>
                            <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">24 inches</characteristic>
                            <characteristic name="Effect" typeId="d107-f119-4175-3647">The targeted enemy unit immediately takes a Fear test and flees if it fails.</characteristic>
                            <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                            <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 26</characteristic>
                            <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                          </characteristics>
                        </profile>
                        <profile id="c525-feb3-4edf-3eee" name="Blast" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="26">
                          <characteristics>
                            <characteristic name="Lore" typeId="d783-9c87-2677-5247">Battle Magic</characteristic>
                            <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">2</characteristic>
                            <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">24 inches</characteristic>
                            <characteristic name="Effect" typeId="d107-f119-4175-3647">The first enemy model in the path suffers either D6 S5 hits or D3 S10 hits, with no armour saves. The summary does not reproduce a Line of Sight label; check the original card for its targeting instructions.</characteristic>
                            <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                            <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 26</characteristic>
                            <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary only card detail required</characteristic>
                          </characteristics>
                        </profile>
                        <profile id="340a-9c8e-dfb4-ac36" name="Shield" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="27">
                          <characteristics>
                            <characteristic name="Lore" typeId="d783-9c87-2677-5247">Battle Magic</characteristic>
                            <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">2</characteristic>
                            <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">18 inches</characteristic>
                            <characteristic name="Effect" typeId="d107-f119-4175-3647">A friendly unit gains a magical shield: before enemy shots roll to hit, roll for each shot; on 4+ it is stopped.</characteristic>
                            <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Remains in play</characteristic>
                            <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 27</characteristic>
                            <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                          </characteristics>
                        </profile>
                        <profile id="7591-f789-86f6-76a1" name="Heal" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="27">
                          <characteristics>
                            <characteristic name="Lore" typeId="d783-9c87-2677-5247">Battle Magic</characteristic>
                            <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">1</characteristic>
                            <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">12 inches</characteristic>
                            <characteristic name="Effect" typeId="d107-f119-4175-3647">The wizard or one friendly model within range recovers one lost wound.</characteristic>
                            <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                            <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 27</characteristic>
                            <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                          </characteristics>
                        </profile>
                        <profile id="09ea-9ac0-bbee-08b7" name="Hold Fast" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="27">
                          <characteristics>
                            <characteristic name="Lore" typeId="d783-9c87-2677-5247">Battle Magic</characteristic>
                            <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">3</characteristic>
                            <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">24 inches</characteristic>
                            <characteristic name="Effect" typeId="d107-f119-4175-3647">An enemy unit can do nothing while the spell lasts.</characteristic>
                            <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Remains in play</characteristic>
                            <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 27</characteristic>
                            <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                          </characteristics>
                        </profile>
                        <profile id="7bdb-dfc1-5b43-e66d" name="Teleport Self" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="27">
                          <characteristics>
                            <characteristic name="Lore" typeId="d783-9c87-2677-5247">Battle Magic</characteristic>
                            <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">1</characteristic>
                            <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">Self</characteristic>
                            <characteristic name="Effect" typeId="d107-f119-4175-3647">Transport the wizard anywhere on the battlefield. Arrival in combat counts as charging.</characteristic>
                            <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                            <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 27</characteristic>
                            <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                          </characteristics>
                        </profile>
                        <profile id="8060-f37b-dc16-a41c" name="Curse" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="27">
                          <characteristics>
                            <characteristic name="Lore" typeId="d783-9c87-2677-5247">Battle Magic</characteristic>
                            <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">2</characteristic>
                            <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">24 inches</characteristic>
                            <characteristic name="Effect" typeId="d107-f119-4175-3647">An enemy unit suffers -1 to shooting and close-combat hit rolls.</characteristic>
                            <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Remains in play</characteristic>
                            <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 27</characteristic>
                            <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                          </characteristics>
                        </profile>
                        <profile id="936c-269f-0b46-2b87" name="Net" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="27">
                          <characteristics>
                            <characteristic name="Lore" typeId="d783-9c87-2677-5247">Battle Magic</characteristic>
                            <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">2</characteristic>
                            <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">12 inches</characteristic>
                            <characteristic name="Effect" typeId="d107-f119-4175-3647">An enemy unit can do nothing while entangled.</characteristic>
                            <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Remains in play</characteristic>
                            <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 27</characteristic>
                            <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                          </characteristics>
                        </profile>
                        <profile id="8807-8458-8971-6802" name="Move Unit" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="27">
                          <characteristics>
                            <characteristic name="Lore" typeId="d783-9c87-2677-5247">Battle Magic</characteristic>
                            <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">2</characteristic>
                            <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">18 inches</characteristic>
                            <characteristic name="Effect" typeId="d107-f119-4175-3647">Transport the wizard and a friendly unit up to 18 inches across the battlefield. Moving into combat counts as charging in its first round.</characteristic>
                            <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                            <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 27</characteristic>
                            <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                          </characteristics>
                        </profile>
                        <profile id="54e3-40e2-6f7e-4078" name="Bless" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="27">
                          <characteristics>
                            <characteristic name="Lore" typeId="d783-9c87-2677-5247">Battle Magic</characteristic>
                            <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">2</characteristic>
                            <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">24 inches</characteristic>
                            <characteristic name="Effect" typeId="d107-f119-4175-3647">A friendly unit gains +1 to shooting and close-combat hit rolls.</characteristic>
                            <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Remains in play</characteristic>
                            <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 27</characteristic>
                            <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                          </characteristics>
                        </profile>
                        <profile id="b45e-5a24-9bd7-40fd" name="Protect" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="27">
                          <characteristics>
                            <characteristic name="Lore" typeId="d783-9c87-2677-5247">Battle Magic</characteristic>
                            <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">3</characteristic>
                            <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">24 inches</characteristic>
                            <characteristic name="Effect" typeId="d107-f119-4175-3647">A friendly unit gains a 4+ special save against each wound.</characteristic>
                            <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Remains in play</characteristic>
                            <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 27</characteristic>
                            <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                          </characteristics>
                        </profile>
                      </profiles>
                      <rules>
                        <rule id="4c8f-806d-3d3a-bd8c" name="Spell deck reference" hidden="false">
                          <description>Entire reference deck, not spells known. Draw/choose the permitted number before battle; record them in roster notes. Necromancy uses chosen spells and High Magic its special dealing rules.</description>
                        </rule>
                      </rules>
                    </selectionEntry>
                    <selectionEntry id="5ffa-2a39-2ab3-4ecf" name="Dark Magic" type="upgrade" hidden="false" collective="false" import="true">
                      <costs>
                        <cost name="pts" typeId="0044-15f1-782b-00ea" value="0" />
                      </costs>
                      <constraints>
                        <constraint id="7824-73ca-d499-cc11" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                      </constraints>
                      <profiles>
                        <profile id="e665-a07f-e9a8-81a6" name="Arnizipal’s Black Horror" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="25">
                          <characteristics>
                            <characteristic name="Lore" typeId="d783-9c87-2677-5247">Dark Magic</characteristic>
                            <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">3</characteristic>
                            <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">4D6 inches</characteristic>
                            <characteristic name="Effect" typeId="d107-f119-4175-3647">Move the Black Horror template 4D6 inches immediately and the same direction at the start of later magic phases. Models passed over die unless they roll under Strength on D6; only magical armour may save. Units taking casualties test Panic.</characteristic>
                            <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Remains in play</characteristic>
                            <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 25</characteristic>
                            <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                          </characteristics>
                        </profile>
                        <profile id="5552-88ce-ac78-c239" name="Blade Wind" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="25">
                          <characteristics>
                            <characteristic name="Lore" typeId="d783-9c87-2677-5247">Dark Magic</characteristic>
                            <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">2</characteristic>
                            <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">24 inches</characteristic>
                            <characteristic name="Effect" typeId="d107-f119-4175-3647">The first unit in its path suffers 3D6 hits minus its Weapon Skill. Each hit wounds on 4+.</characteristic>
                            <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                            <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 25</characteristic>
                            <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                          </characteristics>
                        </profile>
                        <profile id="6db1-6326-8951-13eb" name="Dark Hand of Destruction" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="25">
                          <characteristics>
                            <characteristic name="Lore" typeId="d783-9c87-2677-5247">Dark Magic</characteristic>
                            <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">1</characteristic>
                            <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">Base contact</characteristic>
                            <characteristic name="Effect" typeId="d107-f119-4175-3647">Make one melee attack on a touching enemy. If it hits it inflicts D3 wounds; only magic armour may save.</characteristic>
                            <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                            <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 25</characteristic>
                            <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                          </characteristics>
                        </profile>
                        <profile id="07e8-e51b-5c7f-a459" name="Death Spasm" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="25">
                          <characteristics>
                            <characteristic name="Lore" typeId="d783-9c87-2677-5247">Dark Magic</characteristic>
                            <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">2</characteristic>
                            <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">18 inches</characteristic>
                            <characteristic name="Effect" typeId="d107-f119-4175-3647">The first model in the bolt's path dies if a D6 exceeds its Toughness. It inflicts one hit at its own Strength on each model touching it. This is an outright kill with no armour or wound-based saves. Line of sight required.</characteristic>
                            <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                            <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 25</characteristic>
                            <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                          </characteristics>
                        </profile>
                        <profile id="d43f-f0fa-a3d3-954a" name="Doombolt" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="25">
                          <characteristics>
                            <characteristic name="Lore" typeId="d783-9c87-2677-5247">Dark Magic</characteristic>
                            <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">2</characteristic>
                            <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">18 inches</characteristic>
                            <characteristic name="Effect" typeId="d107-f119-4175-3647">The first model in its path suffers D6 S5 hits. Against a chariot, war machine or building these are D6 S10 hits.</characteristic>
                            <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                            <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 25</characteristic>
                            <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                          </characteristics>
                        </profile>
                        <profile id="99b5-097e-b98a-ee12" name="Malediction of Nagash" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="25">
                          <characteristics>
                            <characteristic name="Lore" typeId="d783-9c87-2677-5247">Dark Magic</characteristic>
                            <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">3</characteristic>
                            <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">36 inches</characteristic>
                            <characteristic name="Effect" typeId="d107-f119-4175-3647">The target unit cannot move or shoot; it may fight at -2 WS and -2 Initiative. At the start of each subsequent magic phase it suffers D3 wounds with no armour saves.</characteristic>
                            <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Remains in play</characteristic>
                            <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 25</characteristic>
                            <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                          </characteristics>
                        </profile>
                        <profile id="c0e9-89cb-5fb9-ccde" name="Power of Chaos" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="25">
                          <characteristics>
                            <characteristic name="Lore" typeId="d783-9c87-2677-5247">Dark Magic</characteristic>
                            <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">1</characteristic>
                            <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">Caster</characteristic>
                            <characteristic name="Effect" typeId="d107-f119-4175-3647">Roll D6: 1 kills the caster; 2–5 draw three additional magic cards; 6 draw six.</characteristic>
                            <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                            <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 25</characteristic>
                            <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                          </characteristics>
                        </profile>
                        <profile id="556f-54ee-c81b-ad98" name="Soul Drain" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="25">
                          <characteristics>
                            <characteristic name="Lore" typeId="d783-9c87-2677-5247">Dark Magic</characteristic>
                            <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">3</characteristic>
                            <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">24 inches</characteristic>
                            <characteristic name="Effect" typeId="d107-f119-4175-3647">Place the Soul Drain template in range. Each covered model suffers an S4 hit; only magic armour may save. For every two wounds caused the caster gains one Wound, which may exceed his starting total.</characteristic>
                            <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                            <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 25</characteristic>
                            <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                          </characteristics>
                        </profile>
                        <profile id="2ea8-d5fc-d030-ca3b" name="The Transformation of Kadon" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="25">
                          <characteristics>
                            <characteristic name="Lore" typeId="d783-9c87-2677-5247">Dark Magic</characteristic>
                            <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">3</characteristic>
                            <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">Caster</characteristic>
                            <characteristic name="Effect" typeId="d107-f119-4175-3647">Transform into a Chimera, Manticore, Hydra or Wyvern. While transformed, cannot cast spells but may use dispels. Carry wounds between forms.</characteristic>
                            <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Remains in play</characteristic>
                            <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 25</characteristic>
                            <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                          </characteristics>
                        </profile>
                        <profile id="4aae-5ac7-885c-c0ed" name="Witch Flight" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="25">
                          <characteristics>
                            <characteristic name="Lore" typeId="d783-9c87-2677-5247">Dark Magic</characteristic>
                            <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">1</characteristic>
                            <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">Anywhere on the battlefield</characteristic>
                            <characteristic name="Effect" typeId="d107-f119-4175-3647">Transport the caster anywhere on the battlefield, including into melee; he then counts as charging in the first round.</characteristic>
                            <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                            <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 25</characteristic>
                            <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">summary verified</characteristic>
                          </characteristics>
                        </profile>
                      </profiles>
                      <rules>
                        <rule id="8254-96fd-aef1-5370" name="Spell deck reference" hidden="false">
                          <description>Entire reference deck, not spells known. Draw/choose the permitted number before battle; record them in roster notes. Necromancy uses chosen spells and High Magic its special dealing rules.</description>
                        </rule>
                      </rules>
