          <constraints>
            <constraint id="8f84-7da1-2d19-a7a9" type="max" value="4" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <selectionEntryGroups>
            <selectionEntryGroup id="2eb1-1eee-b94b-5e2f" name="Magic weapon" hidden="false" collective="false" import="true">
              <constraints>
                <constraint id="3fc7-dfbb-9c59-e5d1" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
              </constraints>
              <entryLinks>
