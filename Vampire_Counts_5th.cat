                          </conditions>
                        </modifier>
                      </modifiers>
                    </selectionEntry>
                  </selectionEntries>
                </selectionEntryGroup>
                <selectionEntryGroup id="ed96-bca7-1113-e22d" name="Body armour" hidden="false" collective="false" import="true">
                  <constraints>
                    <constraint id="aa2e-8c0f-12ca-322e" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                  </constraints>
                  <selectionEntries>
                    <selectionEntry id="66f1-6c85-a717-820b" name="Light armour" type="upgrade" hidden="false" collective="false" import="true">
                      <costs>
                        <cost name="pts" typeId="0044-15f1-782b-00ea" value="2" />
                      </costs>
                      <constraints>
                        <constraint id="6a1e-b6a2-267f-cc00" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                      </constraints>
                      <infoLinks>
                        <infoLink id="87ad-1874-8d02-67a5" name="Armour, shield and barding" targetId="1d9b-1051-0031-be6d" type="rule" hidden="false" publicationId="d7c9-7773-4408-58f6" page="15, 30, 37" />
                      </infoLinks>
                    </selectionEntry>
                    <selectionEntry id="7536-b8af-5135-034d" name="Heavy armour" type="upgrade" hidden="false" collective="false" import="true">
                      <costs>
                        <cost name="pts" typeId="0044-15f1-782b-00ea" value="3" />
                      </costs>
                      <constraints>
                        <constraint id="4adc-1b58-416d-8d6d" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                      </constraints>
                      <infoLinks>
                        <infoLink id="71a1-3eb1-f28f-33f5" name="Armour, shield and barding" targetId="1d9b-1051-0031-be6d" type="rule" hidden="false" publicationId="d7c9-7773-4408-58f6" page="15, 30, 37" />
                      </infoLinks>
                    </selectionEntry>
                  </selectionEntries>
                </selectionEntryGroup>
                <selectionEntryGroup id="d362-3be3-a286-b66b" name="Bloodline powers" hidden="false" collective="false" import="true">
                  <constraints>
                    <constraint id="3f36-2e6f-a8ec-cddd" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" />
                    <constraint id="6a3e-d312-d548-4d92" type="min" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" />
                  </constraints>
                  <selectionEntryGroups>
                    <selectionEntryGroup id="fc1d-6dc6-30ec-649e" name="Von Carstein" hidden="false" collective="false" import="true">
                      <constraints>
                        <constraint id="8b21-a800-f439-c1e6" type="max" value="0" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                      </constraints>
                      <modifiers>
                        <modifier type="set" field="8b21-a800-f439-c1e6" value="1">
                          <conditions>
                            <condition type="atLeast" field="selections" scope="roster" value="1" childId="20ca-22ed-4fa6-aa36" shared="true" includeChildSelections="true" includeChildForces="false" percentValue="false" />
                          </conditions>
                        </modifier>
                      </modifiers>
                      <selectionEntries>
                        <selectionEntry id="0985-b5c5-f4a0-6efa" name="Pure Blood" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="27">
                          <costs>
                            <cost name="pts" typeId="0044-15f1-782b-00ea" value="5" />
                          </costs>
                          <constraints>
                            <constraint id="b229-4358-2d4d-67f1" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                          </constraints>
                          <rules>
                            <rule id="f964-20ef-f7cd-43b7" name="Pure Blood" hidden="false">
                              <description>Allows this Vampire to buy the Carstein Ring. Reference: Vampire Counts p. 27.</description>
                            </rule>
                          </rules>
                        </selectionEntry>
                        <selectionEntry id="df37-ae7b-dabe-9445" name="Wolf Form" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="27">
                          <costs>
                            <cost name="pts" typeId="0044-15f1-782b-00ea" value="5" />
                          </costs>
                          <constraints>
                            <constraint id="5a25-f6a4-143e-1ae1" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                          </constraints>
                          <rules>
                            <rule id="b27f-ec38-8d08-83e4" name="Wolf Form" hidden="false">
                              <description>On foot, use Move 9 for normal movement, including marches; does not change charge, flee or pursuit distance. Reference: Vampire Counts p. 27.</description>
                            </rule>
                          </rules>
                        </selectionEntry>
                        <selectionEntry id="3108-2f21-b68a-56c0" name="Honour or Death" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="27">
                          <costs>
                            <cost name="pts" typeId="0044-15f1-782b-00ea" value="10" />
                          </costs>
                          <constraints>
                            <constraint id="43d7-ffe2-d26e-d446" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                          </constraints>
                          <rules>
                            <rule id="1ee9-a0df-7d41-609a" name="Honour or Death" hidden="false">
                              <description>Must accept enemy challenges. Before the challengers move together, the enemy character tests basic Leadership with no modifiers. A psychology-immune character ignores this. On failure the enemy hides in the rear, no challenge is fought, and the Vampire fights ordinary opponents in contact. Reference: Vampire Counts p. 27.</description>
                            </rule>
                          </rules>
                        </selectionEntry>
                        <selectionEntry id="7b8c-6480-47ca-71f9" name="Unbending Willpower" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="27">
                          <costs>
                            <cost name="pts" typeId="0044-15f1-782b-00ea" value="10" />
                          </costs>
                          <constraints>
                            <constraint id="d91f-b502-5aea-b5cc" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                          </constraints>
                          <rules>
                            <rule id="83a2-5997-a93b-03bc" name="Unbending Willpower" hidden="false">
                              <description>An Undead unit led by this Vampire suffers one fewer crumbling wound from losing combat. If the General dies, its D6 loss becomes D6−1. Reference: Vampire Counts p. 27.</description>
                            </rule>
                          </rules>
                        </selectionEntry>
                        <selectionEntry id="f985-4128-0818-abb9" name="Transfix" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="27">
                          <costs>
                            <cost name="pts" typeId="0044-15f1-782b-00ea" value="20" />
                          </costs>
                          <constraints>
                            <constraint id="41e9-b3be-107d-3783" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                          </constraints>
                          <rules>
                            <rule id="3f26-09cc-8b6a-37d9" name="Transfix" hidden="false">
                              <description>At the start of melee choose one enemy in base contact. It tests basic Leadership, without modifiers; on failure it cannot attack and attacks against it hit automatically. Psychology-immune models are unaffected. Reference: Vampire Counts p. 27.</description>
                            </rule>
                          </rules>
                        </selectionEntry>
                        <selectionEntry id="1c9d-8345-d862-1999" name="Summon Wolves" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="27">
                          <costs>
                            <cost name="pts" typeId="0044-15f1-782b-00ea" value="30" />
                          </costs>
                          <constraints>
                            <constraint id="4ca4-d68e-c481-8d66" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                          </constraints>
                          <rules>
                            <rule id="52cc-4f16-2af5-029d" name="Summon Wolves" hidden="false">
                              <description>Summon D3+1 Dire Wolves. One use at the start of your turn. Random edge: 1 your edge, 2–3 left, 4–5 right, 6 enemy edge. Place centrally on that edge; the arrivals may move but not charge that turn. Reference: Vampire Counts p. 27.</description>
                            </rule>
                          </rules>
                        </selectionEntry>
                        <selectionEntry id="b87d-6c7e-5dda-1273" name="Bat Form" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="27">
                          <costs>
                            <cost name="pts" typeId="0044-15f1-782b-00ea" value="40" />
                          </costs>
                          <constraints>
                            <constraint id="e225-6f16-ad13-4752" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                          </constraints>
                          <rules>
                            <rule id="4f15-d0ea-692a-867a" name="Bat Form" hidden="false">
                              <description>On foot, move up to 24 inches ignoring intervening terrain during normal movement; this does not change charge, flee or pursuit movement. Reference: Vampire Counts p. 27.</description>
                            </rule>
                          </rules>
                        </selectionEntry>
                      </selectionEntries>
                    </selectionEntryGroup>
                    <selectionEntryGroup id="284d-97f2-b13b-fb25" name="Necrarch" hidden="false" collective="false" import="true">
                      <constraints>
                        <constraint id="147e-c237-6e4e-506c" type="max" value="0" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                      </constraints>
                      <modifiers>
                        <modifier type="set" field="147e-c237-6e4e-506c" value="1">
                          <conditions>
                            <condition type="atLeast" field="selections" scope="roster" value="1" childId="b19a-d86d-7a8a-76f6" shared="true" includeChildSelections="true" includeChildForces="false" percentValue="false" />
                          </conditions>
                        </modifier>
                      </modifiers>
                      <selectionEntries>
                        <selectionEntry id="c799-6e87-3792-85e0" name="Dark Acolyte" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="28">
                          <costs>
                            <cost name="pts" typeId="0044-15f1-782b-00ea" value="5" />
                          </costs>
                          <constraints>
                            <constraint id="ac5e-5fb5-de2b-ae5f" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                          </constraints>
                          <rules>
                            <rule id="376b-4c04-b1ef-75b5" name="Dark Acolyte" hidden="false">
                              <description>May carry a Dispel Magic Scroll and retain one magic card between phases. This alone does not make a Thrall a wizard. Reference: Vampire Counts p. 28.</description>
                            </rule>
                          </rules>
                        </selectionEntry>
                        <selectionEntry id="d163-3a3f-d35e-420e" name="Unbending Willpower" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="28">
                          <costs>
                            <cost name="pts" typeId="0044-15f1-782b-00ea" value="10" />
                          </costs>
                          <constraints>
                            <constraint id="ff27-c54e-a96f-df07" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                          </constraints>
                          <rules>
                            <rule id="c507-5815-45ba-998e" name="Unbending Willpower" hidden="false">
                              <description>Reduce combat-loss crumbling by one for this Vampire or the Undead unit he leads. Its loss on the General's death becomes D6−1. Reference: Vampire Counts p. 28.</description>
                            </rule>
                          </rules>
                        </selectionEntry>
                        <selectionEntry id="df69-aa4b-b1da-135e" name="The Awakening" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="28">
                          <costs>
                            <cost name="pts" typeId="0044-15f1-782b-00ea" value="20" />
                          </costs>
                          <constraints>
                            <constraint id="811a-3d68-5582-c3dd" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                          </constraints>
                          <rules>
                            <rule id="39f7-abd8-16d6-b55d" name="The Awakening" hidden="false">
                              <description>Add D3 raised models when casting Summon Skeletons, Raise the Dead or Summon Undead Horde. Reference: Vampire Counts p. 28.</description>
                            </rule>
                          </rules>
                        </selectionEntry>
                        <selectionEntry id="cf23-3ccb-f594-d331" name="Master of the Black Arts" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="28">
                          <costs>
                            <cost name="pts" typeId="0044-15f1-782b-00ea" value="25" />
                          </costs>
                          <constraints>
                            <constraint id="b0a3-0380-730e-0608" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                          </constraints>
                          <rules>
                            <rule id="4029-c21f-0011-6ae1" name="Master of the Black Arts" hidden="false">
                              <description>Add one to rolls to recast Necromantic spells. Reference: Vampire Counts p. 28.</description>
                            </rule>
                          </rules>
                        </selectionEntry>
                        <selectionEntry id="7e64-080d-0243-5cb5" name="Supernatural Horror" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="28">
                          <costs>
                            <cost name="pts" typeId="0044-15f1-782b-00ea" value="30" />
                          </costs>
                          <constraints>
                            <constraint id="501e-57c0-d6ba-0294" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                          </constraints>
                          <rules>
                            <rule id="ed73-c326-84c4-e094" name="Supernatural Horror" hidden="false">
                              <description>Causes terror. Reference: Vampire Counts p. 28.</description>
                            </rule>
                          </rules>
                        </selectionEntry>
                        <selectionEntry id="dc48-e619-09fa-c436" name="Forbidden Lore" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="28">
                          <costs>
                            <cost name="pts" typeId="0044-15f1-782b-00ea" value="40" />
                          </costs>
                          <constraints>
                            <constraint id="cb64-7a73-1a96-07b4" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                          </constraints>
                          <rules>
                            <rule id="881c-9d42-6820-e5e3" name="Forbidden Lore" hidden="false">
                              <description>Receives one additional spell; magic level is unchanged. Reference: Vampire Counts p. 28.</description>
                            </rule>
                          </rules>
                        </selectionEntry>
                        <selectionEntry id="3e38-470e-8af6-9727" name="Curse of the Revenant" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="28">
                          <costs>
                            <cost name="pts" typeId="0044-15f1-782b-00ea" value="50" />
                          </costs>
                          <constraints>
                            <constraint id="72be-a925-8cfd-f68e" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                          </constraints>
                          <rules>
                            <rule id="bdac-68b5-fe4b-22e8" name="Curse of the Revenant" hidden="false">
                              <description>Add one Wound to the profile. Reference: Vampire Counts p. 28.</description>
                            </rule>
                          </rules>
                        </selectionEntry>
                      </selectionEntries>
                    </selectionEntryGroup>
                    <selectionEntryGroup id="f945-643c-9380-885a" name="Blood Dragon" hidden="false" collective="false" import="true">
                      <constraints>
                        <constraint id="ff2e-4042-7931-fa59" type="max" value="0" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                      </constraints>
                      <modifiers>
                        <modifier type="set" field="ff2e-4042-7931-fa59" value="1">
                          <conditions>
                            <condition type="atLeast" field="selections" scope="roster" value="1" childId="2dce-9d08-bbf3-cd0f" shared="true" includeChildSelections="true" includeChildForces="false" percentValue="false" />
                          </conditions>
                        </modifier>
                      </modifiers>
                      <selectionEntries>
                        <selectionEntry id="babc-3b52-c113-d459" name="Doomrider" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="29">
                          <costs>
                            <cost name="pts" typeId="0044-15f1-782b-00ea" value="5" />
                          </costs>
                          <constraints>
                            <constraint id="d7b1-578e-7102-128d" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                          </constraints>
                          <rules>
                            <rule id="76eb-f072-bf4f-5127" name="Doomrider" hidden="false">
                              <description>A ridden Nightmare ignores movement penalties from armour and barding. Reference: Vampire Counts p. 29.</description>
                            </rule>
                          </rules>
                        </selectionEntry>
                        <selectionEntry id="b8bd-2092-02da-22c7" name="Honour or Death" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="29">
                          <costs>
                            <cost name="pts" typeId="0044-15f1-782b-00ea" value="10" />
                          </costs>
                          <constraints>
                            <constraint id="8206-91e4-3c17-1b91" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                          </constraints>
                          <rules>
                            <rule id="cf8f-7578-7007-7451" name="Honour or Death" hidden="false">
                              <description>Must accept enemy challenges. Before the challengers move together, the enemy character tests basic Leadership with no modifiers. A psychology-immune character ignores this. On failure the enemy hides in the rear, no challenge is fought, and the Vampire fights ordinary opponents in contact. Reference: Vampire Counts p. 29.</description>
                            </rule>
                          </rules>
                        </selectionEntry>
                        <selectionEntry id="109c-9b58-9488-7f5a" name="Might of Arms" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="29">
                          <costs>
                            <cost name="pts" typeId="0044-15f1-782b-00ea" value="10" />
                          </costs>
                          <constraints>
                            <constraint id="828b-0cd2-6979-1cba" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                          </constraints>
                          <rules>
                            <rule id="991b-f6e6-8977-2c76" name="Might of Arms" hidden="false">
                              <description>Add one Weapon Skill. Reference: Vampire Counts p. 29.</description>
                            </rule>
                          </rules>
                        </selectionEntry>
                        <selectionEntry id="4209-a87e-5fa6-a246" name="Strength of Steel" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="29">
                          <costs>
                            <cost name="pts" typeId="0044-15f1-782b-00ea" value="10" />
                          </costs>
                          <constraints>
                            <constraint id="6810-7e21-d997-a6e1" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                          </constraints>
                          <rules>
                            <rule id="9d2f-2c28-e65d-cb42" name="Strength of Steel" hidden="false">
                              <description>May cast spells while wearing normal armour. Reference: Vampire Counts p. 29.</description>
                            </rule>
                          </rules>
                        </selectionEntry>
                        <selectionEntry id="1f19-5d4c-f3f1-f8e0" name="Blademaster" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="29">
                          <costs>
                            <cost name="pts" typeId="0044-15f1-782b-00ea" value="20" />
                          </costs>
                          <constraints>
                            <constraint id="6c5e-55bf-61fc-4011" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                          </constraints>
                          <rules>
                            <rule id="ea67-9716-14ab-bc8f" name="Blademaster" hidden="false">
                              <description>Choose one enemy in base contact to lose one Attack. For mixed attacks choose which kind is lost, including a mount attack or bite. Reference: Vampire Counts p. 29.</description>
                            </rule>
                          </rules>
                        </selectionEntry>
                        <selectionEntry id="c816-834a-d875-d29b" name="Warrior Pride" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="29">
                          <costs>
                            <cost name="pts" typeId="0044-15f1-782b-00ea" value="20" />
                          </costs>
                          <constraints>
                            <constraint id="7058-e97e-c976-8d46" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
                          </constraints>
                          <rules>
                            <rule id="f9c8-80fc-2806-2b24" name="Warrior Pride" hidden="false">
                              <description>May cast spells while wearing normal or magical armour. Reference: Vampire Counts p. 29.</description>
                            </rule>
                          </rules>
                        </selectionEntry>
                        <selectionEntry id="7c62-c51e-bac7-7a32" name="Red Fury" type="upgrade" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="29">
