        <rule id="52d7-ccf8-01d5-7c0e" name="Included equipment" hidden="false">
          <description>Hand weapon.</description>
        </rule>
        <rule id="2d81-f0f6-0bae-c8fd" name="Army-list note" hidden="false">
          <description>Profile source conflict: army list p. 62 prints A3, while the bestiary p. 51 prints A4. This catalogue preserves the army-list A3; agree any correction before play.</description>
        </rule>
        <rule id="8c99-f26f-068d-e625" name="Wizard level and spells" hidden="false">
          <description>Magic level 4; 4 spell cards before bloodline/item changes. Those changes, including Forbidden Lore and Nehekhara’s Noble Blood, are applied manually. Normal armour casting restrictions apply unless a specific power overrides them.</description>
        </rule>
      </rules>
