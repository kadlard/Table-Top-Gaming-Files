    <selectionEntry id="36a5-00e5-0486-3c9d" name="Neferata, Queen of Mysteries" type="model" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="76–77">
      <costs>
        <cost name="pts" typeId="0044-15f1-782b-00ea" value="700" />
      </costs>
      <categoryLinks>
        <categoryLink id="34a5-31cb-7405-9565" name="Characters" targetId="0114-02b1-a20d-82f1" primary="true" hidden="false" />
      </categoryLinks>
      <profiles>
        <profile id="235f-fc7a-f858-a67b" name="Neferata, Queen of Mysteries" typeId="e25d-f63f-8d67-4bda" typeName="Unit" hidden="false" publicationId="c115-e636-a63a-a216" page="76–77">
          <characteristics>
            <characteristic name="M" typeId="df0b-cf43-1955-6845">6</characteristic>
            <characteristic name="WS" typeId="c83c-b081-d246-d5ef">8</characteristic>
            <characteristic name="BS" typeId="960a-0c90-a448-96b4">6</characteristic>
            <characteristic name="S" typeId="639b-d234-7e46-084b">7</characteristic>
            <characteristic name="T" typeId="6a8e-5ca4-9d4e-d596">6</characteristic>
            <characteristic name="W" typeId="8a8d-ce29-476c-e0fa">4</characteristic>
            <characteristic name="I" typeId="946e-86c4-ffce-c3ed">9</characteristic>
            <characteristic name="A" typeId="4cc5-d3f5-26a7-37c2">4</characteristic>
            <characteristic name="Ld" typeId="cedc-6339-9f57-49bd">10</characteristic>
          </characteristics>
        </profile>
        <profile id="a946-b6e4-c4a8-c302" name="Dagger of Jet" typeId="b93a-4f1c-9871-3028" typeName="Magic item" hidden="false" publicationId="c115-e636-a63a-a216" page="76–77">
          <characteristics>
            <characteristic name="Type" typeId="7ef9-9797-693d-d937">Magic weapon</characteristic>
            <characteristic name="Effect" typeId="d277-fc43-48d0-6dce">Each unsaved wound also removes one point of Strength, Toughness or Attacks, chosen by Neferata; minimum 1.</characteristic>
            <characteristic name="Reference" typeId="2fa3-15cf-fc7d-e42b">Vampire Counts, printed p. 76–77. Card value 30 points, included in the character total.</characteristic>
            <characteristic name="Coverage" typeId="23f7-abf1-238e-1daa">Book-checked summary; fixed loadout</characteristic>
          </characteristics>
        </profile>
        <profile id="8229-9c3c-f6e5-d5d8" name="Ruby of Lahmia" typeId="b93a-4f1c-9871-3028" typeName="Magic item" hidden="false" publicationId="c115-e636-a63a-a216" page="76–77">
          <characteristics>
            <characteristic name="Type" typeId="7ef9-9797-693d-d937">Ward</characteristic>
            <characteristic name="Effect" typeId="d277-fc43-48d0-6dce">Automatically restores the first wound she suffers each phase, including Shadowblood wounds. After each restoration roll D6 plus wounds restored so far; on 7+ it exhausts for the battle. Cannot save her from one attack inflicting enough wounds to kill her outright.</characteristic>
            <characteristic name="Reference" typeId="2fa3-15cf-fc7d-e42b">Vampire Counts, printed p. 76–77. Card value 75 points, included in the character total.</characteristic>
            <characteristic name="Coverage" typeId="23f7-abf1-238e-1daa">Book-checked summary; fixed loadout</characteristic>
          </characteristics>
        </profile>
        <profile id="587b-56df-6f36-dab4" name="Bastet" typeId="b93a-4f1c-9871-3028" typeName="Magic item" hidden="false" publicationId="c115-e636-a63a-a216" page="76–77">
          <characteristics>
            <characteristic name="Type" typeId="7ef9-9797-693d-d937">Wizard arcana</characteristic>
            <characteristic name="Effect" typeId="d277-fc43-48d0-6dce">At each own turn start choose any enemy unit, not the same one twice running. The unit loses 1 Leadership and re-rolls successful armour saves while affected. Bastet cannot be harmed, obstruct movement or stop marching.</characteristic>
            <characteristic name="Reference" typeId="2fa3-15cf-fc7d-e42b">Vampire Counts, printed p. 76–77. Card value 50 points, included in the character total.</characteristic>
            <characteristic name="Coverage" typeId="23f7-abf1-238e-1daa">Book-checked summary; fixed loadout</characteristic>
          </characteristics>
        </profile>
        <profile id="3c04-95c8-c951-2bd4" name="Shadowblood" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="c115-e636-a63a-a216" page="77">
          <characteristics>
            <characteristic name="Lore" typeId="d783-9c87-2677-5247">Neferata, Queen of Mysteries — unique spell</characteristic>
            <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">1–3 of Neferata’s Wounds</characteristic>
            <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">24 inches</characteristic>
            <characteristic name="Effect" typeId="d107-f119-4175-3647">First unit in path takes D6+2 Strength 5 hits per wound spent; double wounds against flammable targets. Victims become friendly Zombies in combat with survivors. May reinforce with Power. Once per magic phase; other spells remain available. Ruby of Lahmia can restore spent wounds.</characteristic>
            <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
            <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Vampire Counts, printed p. 77</characteristic>
            <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">Included unique spell</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <constraints>
        <constraint id="535d-1936-c001-9131" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
        <constraint id="1988-62cb-29c4-8990" type="max" value="1" scope="roster" field="selections" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" />
        <constraint id="45d0-bc97-4ecf-8d95" type="max" value="0" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
        <constraint id="3b9c-b5dc-7a23-2b18" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
      </constraints>
      <rules>
        <rule id="0e91-5103-b9e9-5fc5" name="Special character" hidden="false">
          <description>Unique named selection. 700 points includes the complete listed fixed equipment, companions, powers and mounts; only separately offered options add points. Printed profiles are before magic-item bonuses unless a rule says they are already included. Special-character use requires the players’ agreement under the books’ convention.</description>
        </rule>
        <rule id="6383-3e22-6898-45a9" name="Included equipment" hidden="false">
          <description>Dagger of Jet; serpent staff; on foot.</description>
        </rule>
        <rule id="8be2-73cc-db52-a3c9" name="Blood Kiss" hidden="false" publicationId="c115-e636-a63a-a216" page="76–77">
          <description>Once per battle, a living character she kills in melee may become a friendly Vampire Thrall, keeping magic items. Its steed becomes a Nightmare; separate a monster mount and take a Monster Reaction test. Place the Thrall with Neferata/her unit as for Seduction, permanently. Cannot affect Undead, Daemons or other nonliving characters. Reference: Vampire Counts, printed p. 76–77.</description>
        </rule>
        <rule id="c474-dfdf-c7df-b567" name="Magic and spell allocation" hidden="false">
          <description>Magic level 3; 2 spells. Printed spell count already includes fixed bloodline effects; do not add those bonuses again. The lore profiles are reference decks, not a grant of all spells. Choose/draw the permitted spells before play and record them in roster notes.</description>
        </rule>
        <rule id="663a-0ca3-3178-14c1" name="Fixed bloodline" hidden="false">
          <description>Lahmia. Select this family in Core rules and army reference. All listed powers are already included; no extra powers may be purchased.</description>
        </rule>
        <rule id="745c-f06f-a620-0e52" name="Bloodline: Innocence Lost" hidden="false" publicationId="c115-e636-a63a-a216" page="30">
          <description>Always strikes first; against another first-strike ability use Initiative, then roll off ties.</description>
        </rule>
        <rule id="67dd-c79f-1a90-a3f4" name="Bloodline: Seduction" hidden="false" publicationId="c115-e636-a63a-a216" page="30">
          <description>Lord only. At the start of melee choose an enemy in contact to test basic Leadership; psychology-immune models ignore it. Failure gives control of the model, which moves alongside the Vampire. Retest at the start of its original side's turn. A model still controlled at the end counts as slain. Attacking the victim releases it. One attempt per turn, but multiple victims may remain controlled; controlled victims cannot attack each other.</description>
        </rule>
        <rule id="54d0-8d71-b278-da2c" name="Bloodline: Night Creature" hidden="false" publicationId="c115-e636-a63a-a216" page="30">
          <description>Enemies must roll 5+ to spot this Vampire before charging, shooting or targeting it with a spell. Failure allows another target/action. Does not apply while the Vampire is in a unit or already fighting.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="a2f9-f708-6671-2c93" name="Vampires" targetId="1e6d-5f93-94e7-b409" type="rule" hidden="false" publicationId="c115-e636-a63a-a216" page="50" />
        <infoLink id="8d0f-01a3-a785-0ff0" name="General" targetId="d1ba-1b25-c83e-0e46" type="rule" hidden="false" publicationId="d7c9-7773-4408-58f6" page="88" />
        <infoLink id="6bd8-a359-bc00-47e8" name="Magic phase and Winds of Magic" targetId="51af-8134-e1d0-5c8f" type="rule" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="9–12" />
        <infoLink id="4557-1d27-ddef-5977" name="Counter magic and natural dispels" targetId="a2e7-268a-edde-1495" type="rule" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="10–14" />
        <infoLink id="6f30-1e7f-6dc9-cbce" name="Winds of Magic special cards" targetId="0d22-3d38-e047-8557" type="rule" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="9–10" />
        <infoLink id="9251-0284-ce94-6174" name="Spells remaining in play" targetId="b403-7328-b3ca-4dd7" type="rule" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="11–14" />
        <infoLink id="f36f-afff-f057-8753" name="Spell targets, sight and templates" targetId="34de-d976-f1cf-5402" type="rule" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="12, 22" />
      </infoLinks>
      <selectionEntryGroups>
        <selectionEntryGroup id="0262-5bfd-1f6a-ad43" name="Magic lore" hidden="false" collective="false" import="true" defaultSelectionEntryId="5cba-b2bb-a90d-f81a">
          <constraints>
            <constraint id="e536-41a3-c970-b892" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
            <constraint id="f57a-6ca6-3774-e765" type="min" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <selectionEntries>
            <selectionEntry id="5cba-b2bb-a90d-f81a" name="Necromantic Magic" type="upgrade" hidden="false" collective="false" import="true">
              <costs>
                <cost name="pts" typeId="0044-15f1-782b-00ea" value="0" />
              </costs>
              <constraints>
                <constraint id="89f5-1fbd-0698-03cb" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
              </constraints>
              <infoLinks>
                <infoLink id="7835-fd5c-c00f-479c" name="Necromancy and recasting" targetId="369a-00ed-fa25-3a9d" type="rule" hidden="false" publicationId="c115-e636-a63a-a216" page="31" />
              </infoLinks>
              <profiles>
                <profile id="b1de-7005-4d45-8ff7" name="Drain Life" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="26">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Necromantic Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">2</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">2D6-inch radius</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">Living models in the rolled radius suffer S3 hits with no armour saves. Use wounds inflicted to restore the caster's lost wounds, up to his starting total. Undead, Daemons and objects are unaffected. Characters cannot use Look Out Sir; hit living crew/components of composite models.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 26</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">Reference deck; not automatically known</characteristic>
                  </characteristics>
                </profile>
                <profile id="e5c2-7c36-1eb1-7948" name="Gaze of Nagash" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="26">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Necromantic Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">2</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">18 inches</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">The first unit in its path suffers 2D6 S4 hits with no armour saves.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 26</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">Reference deck; not automatically known</characteristic>
                  </characteristics>
                </profile>
                <profile id="dc26-1fef-289d-a119" name="Hand of Dust" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="26">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Necromantic Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">2</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">Base contact</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">Both caster and one melee opponent roll D6 plus Strength; double the caster's total. Each point by which the caster wins inflicts one wound with no armour save. A slain victim becomes a friendly Wight, or a Wraith if it was a wizard.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 26</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">Reference deck; not automatically known</characteristic>
                  </characteristics>
                </profile>
                <profile id="1c27-d3a4-d765-1262" name="The Dark Mist" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="26">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Necromantic Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">1</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">Caster</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">Move up to 24 inches in your movement phase, through terrain and buildings but not living models. Cannot make melee attacks; may cast spells. Only magical weapons and spells can harm the caster. Combat-result defeat is still possible and fleeing ends the effect (Vampire Counts p. 31).</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Remains in play</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 26</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">Reference deck; not automatically known</characteristic>
                  </characteristics>
                </profile>
                <profile id="97cd-0efa-d34d-ad40" name="Raise the Dead" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="26">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Necromantic Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">2</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">24 inches</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">Raise 2D6 Skeletons or Zombies into an existing unit of that type in range, or make a new unit if at least five are raised. Apply the equipment and victory-point rules in Vampire Counts p. 31.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 26</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">Reference deck; not automatically known</characteristic>
                  </characteristics>
                </profile>
                <profile id="71bc-d8d8-12ea-c0d0" name="Summon Skeletons" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="26">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Necromantic Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">1</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">18 inches</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">Raise D6 Skeletons or Zombies into an existing unit of that type in range, or make a new unit if at least five are raised. Apply Vampire Counts p. 31 for equipment and victory points.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 26</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">Reference deck; not automatically known</characteristic>
                  </characteristics>
                </profile>
                <profile id="652d-cd8b-e70f-3871" name="Summon Undead Horde" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="26">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Necromantic Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">3</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">36 inches</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">Raise 3D6 Skeletons or Zombies into an existing unit of that type in range, or make a new unit if at least five are raised. Apply Vampire Counts p. 31 for equipment and victory points.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 26</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">Reference deck; not automatically known</characteristic>
                  </characteristics>
                </profile>
                <profile id="e2cc-8d5f-dc88-923a" name="The Curse of Years" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="26">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Necromantic Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">3</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">24 inches</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">Roll per model in the target unit: 5+ kills it outright. At each later Undead magic phase improve the threshold by one (4+, then 3+, etc.). No armour or wound-based saves. Characters test too, without Look Out Sir; roll once for an entire composite model.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Remains in play</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 26</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">Reference deck; not automatically known</characteristic>
                  </characteristics>
                </profile>
                <profile id="2602-5ca4-27ab-d40f" name="Vanhel’s Danse Macabre" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="26">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Necromantic Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">1</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">36 inches</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">One eligible regiment may charge, move, march, fight one round or shoot during the magic phase. For Vampire Counts use the updated p. 31 eligibility: Skeletons, Zombies, Wights (including mounted Wights and Lords), and Wraiths only.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 26</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">Reference deck; not automatically known</characteristic>
                  </characteristics>
                </profile>
                <profile id="574b-69a4-025f-060c" name="Wind of Death" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="26">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Necromantic Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">3</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">From any table edge</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">Place its template at any table edge. Move 2D10 inches immediately, and the same direction at the start of later magic phases. Each model passed over suffers D6 wounds on 4+, with no armour saves.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Remains in play</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 26</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">Reference deck; not automatically known</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
      </selectionEntryGroups>
