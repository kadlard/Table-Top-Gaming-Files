    <selectionEntry id="b0c6-3856-0614-a72d" name="Melkhior the Ancient" type="model" hidden="false" collective="false" import="true" publicationId="c115-e636-a63a-a216" page="74–75">
      <costs>
        <cost name="pts" typeId="0044-15f1-782b-00ea" value="660" />
      </costs>
      <categoryLinks>
        <categoryLink id="6ee9-bb2a-f2ed-ac50" name="Characters" targetId="0114-02b1-a20d-82f1" primary="true" hidden="false" />
      </categoryLinks>
      <profiles>
        <profile id="ffa7-47d9-2d74-5a0f" name="Melkhior the Ancient" typeId="e25d-f63f-8d67-4bda" typeName="Unit" hidden="false" publicationId="c115-e636-a63a-a216" page="74–75">
          <characteristics>
            <characteristic name="M" typeId="df0b-cf43-1955-6845">6</characteristic>
            <characteristic name="WS" typeId="c83c-b081-d246-d5ef">6</characteristic>
            <characteristic name="BS" typeId="960a-0c90-a448-96b4">4</characteristic>
            <characteristic name="S" typeId="639b-d234-7e46-084b">6</characteristic>
            <characteristic name="T" typeId="6a8e-5ca4-9d4e-d596">6</characteristic>
            <characteristic name="W" typeId="8a8d-ce29-476c-e0fa">4</characteristic>
            <characteristic name="I" typeId="946e-86c4-ffce-c3ed">7</characteristic>
            <characteristic name="A" typeId="4cc5-d3f5-26a7-37c2">4</characteristic>
            <characteristic name="Ld" typeId="cedc-6339-9f57-49bd">10</characteristic>
          </characteristics>
        </profile>
        <profile id="73cc-3c51-ce34-e769" name="Winged Nightmare" typeId="e25d-f63f-8d67-4bda" typeName="Unit" hidden="false" publicationId="c115-e636-a63a-a216" page="74–75">
          <characteristics>
            <characteristic name="M" typeId="df0b-cf43-1955-6845">8</characteristic>
            <characteristic name="WS" typeId="c83c-b081-d246-d5ef">3</characteristic>
            <characteristic name="BS" typeId="960a-0c90-a448-96b4">0</characteristic>
            <characteristic name="S" typeId="639b-d234-7e46-084b">5</characteristic>
            <characteristic name="T" typeId="6a8e-5ca4-9d4e-d596">5</characteristic>
            <characteristic name="W" typeId="8a8d-ce29-476c-e0fa">3</characteristic>
            <characteristic name="I" typeId="946e-86c4-ffce-c3ed">2</characteristic>
            <characteristic name="A" typeId="4cc5-d3f5-26a7-37c2">3</characteristic>
            <characteristic name="Ld" typeId="cedc-6339-9f57-49bd">5</characteristic>
          </characteristics>
        </profile>
        <profile id="a3ca-e46d-15b7-89a7" name="Painbringer" typeId="b93a-4f1c-9871-3028" typeName="Magic item" hidden="false" publicationId="c115-e636-a63a-a216" page="74–75">
          <characteristics>
            <characteristic name="Type" typeId="7ef9-9797-693d-d937">Magic weapon</characteristic>
            <characteristic name="Effect" typeId="d277-fc43-48d0-6dce">An enemy hit suffers -1 To Hit for the rest of the battle. Multiple hits do not stack this penalty.</characteristic>
            <characteristic name="Reference" typeId="2fa3-15cf-fc7d-e42b">Vampire Counts, printed p. 74–75. Card value 40 points, included in the character total.</characteristic>
            <characteristic name="Coverage" typeId="23f7-abf1-238e-1daa">Book-checked summary; fixed loadout</characteristic>
          </characteristics>
        </profile>
        <profile id="60c7-9b68-b294-f343" name="Grimoire Necronium" typeId="b93a-4f1c-9871-3028" typeName="Magic item" hidden="false" publicationId="c115-e636-a63a-a216" page="74–75">
          <characteristics>
            <characteristic name="Type" typeId="7ef9-9797-693d-d937">Wizard arcana</characteristic>
            <characteristic name="Effect" typeId="d277-fc43-48d0-6dce">Choose one of his four spells before battle. Cast it free once per magic phase; additional recasts use Power normally. After each book use roll D6; on 1–2 it exhausts for the rest of the battle.</characteristic>
            <characteristic name="Reference" typeId="2fa3-15cf-fc7d-e42b">Vampire Counts, printed p. 74–75. Card value 50 points, included in the character total.</characteristic>
            <characteristic name="Coverage" typeId="23f7-abf1-238e-1daa">Book-checked summary; fixed loadout</characteristic>
          </characteristics>
        </profile>
        <profile id="7147-0cba-88aa-c467" name="Black Cloak of Lahmia" typeId="b93a-4f1c-9871-3028" typeName="Magic item" hidden="false" publicationId="c115-e636-a63a-a216" page="74–75">
          <characteristics>
            <characteristic name="Type" typeId="7ef9-9797-693d-d937">Enchanted item</characteristic>
            <characteristic name="Effect" typeId="d277-fc43-48d0-6dce">Cannot be harmed by normal missile fire or war machines. Magical missiles and spells affect him normally.</characteristic>
            <characteristic name="Reference" typeId="2fa3-15cf-fc7d-e42b">Vampire Counts, printed p. 74–75. Card value 50 points, included in the character total.</characteristic>
            <characteristic name="Coverage" typeId="23f7-abf1-238e-1daa">Book-checked summary; fixed loadout</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <constraints>
        <constraint id="091c-b98b-1c1e-5191" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
        <constraint id="364e-8d01-035d-26d7" type="max" value="1" scope="roster" field="selections" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" />
        <constraint id="26ae-0dbc-7ae1-e940" type="max" value="0" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
        <constraint id="2485-99ef-1ccd-b156" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
      </constraints>
      <rules>
        <rule id="f37e-cd1e-7145-18d7" name="Special character" hidden="false">
          <description>Unique named selection. 660 points includes the complete listed fixed equipment, companions, powers and mounts; only separately offered options add points. Printed profiles are before magic-item bonuses unless a rule says they are already included. Special-character use requires the players’ agreement under the books’ convention.</description>
        </rule>
        <rule id="aaf8-e805-df46-7db7" name="Included equipment" hidden="false">
          <description>Staff; sword; Winged Nightmare.</description>
        </rule>
        <rule id="08e3-518a-3e99-f7d0" name="Ancient Necrarch" hidden="false" publicationId="c115-e636-a63a-a216" page="74–75">
          <description>Immune to psychology except Stupidity. Four spells, magic level 4, Necromantic recast on 3+. These values already include his stronger Master of the Black Arts and other powers; do not increase them again. Reference: Vampire Counts, printed p. 74–75.</description>
        </rule>
        <rule id="e771-fd77-c5ff-e2b6" name="Magic and spell allocation" hidden="false">
          <description>Magic level 4; 4 spells. Printed spell count already includes fixed bloodline effects; do not add those bonuses again. The lore profiles are reference decks, not a grant of all spells. Choose/draw the permitted spells before play and record them in roster notes.</description>
        </rule>
        <rule id="3394-1ccb-9c76-eb77" name="Fixed bloodline" hidden="false">
          <description>Necrarch. Select this family in Core rules and army reference. All listed powers are already included; no extra powers may be purchased.</description>
        </rule>
        <rule id="d584-2442-ff03-1b97" name="Bloodline: Master of the Black Arts" hidden="false" publicationId="c115-e636-a63a-a216" page="28">
          <description>Add one to rolls to recast Necromantic spells. Melkhior’s exception: level 4, FOUR spells total, recast on 3+; already included.</description>
        </rule>
        <rule id="44a8-7411-92e3-7e78" name="Bloodline: Supernatural Horror" hidden="false" publicationId="c115-e636-a63a-a216" page="28">
          <description>Causes terror.</description>
        </rule>
        <rule id="2be0-825b-e8e6-0f15" name="Bloodline: Forbidden Lore" hidden="false" publicationId="c115-e636-a63a-a216" page="28">
          <description>Receives one additional spell; magic level is unchanged. Melkhior’s exception: level 4, FOUR spells total, recast on 3+; already included.</description>
        </rule>
        <rule id="5fa9-7bc5-f68a-bf74" name="Bloodline: Death Incarnate" hidden="false" publicationId="c115-e636-a63a-a216" page="28">
          <description>Living models within six inches suffer -1 Leadership. Does not affect Daemons or Undead.</description>
        </rule>
        <rule id="d0f6-be01-f4f3-0da9" name="Bloodline: Nehekhara’s Noble Blood" hidden="false" publicationId="c115-e636-a63a-a216" page="28">
          <description>Becomes magic level 4 with three spell cards. Its Necromancy recast roll remains 5+. Melkhior’s exception: level 4, FOUR spells total, recast on 3+; already included.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="4578-22d9-12de-2078" name="Vampires" targetId="1e6d-5f93-94e7-b409" type="rule" hidden="false" publicationId="c115-e636-a63a-a216" page="50" />
        <infoLink id="2f5a-8a00-fac8-6fde" name="Stupidity" targetId="9f48-6ff5-649d-1612" type="rule" hidden="false" publicationId="d7c9-7773-4408-58f6" page="50" />
        <infoLink id="64bf-544c-1e8f-bec2" name="Terror" targetId="baed-6e1f-98ad-7e00" type="rule" hidden="false" publicationId="d7c9-7773-4408-58f6" page="49" />
        <infoLink id="2913-92ca-d17d-db98" name="Flying and being driven off" targetId="f8d8-8222-78f2-a11c" type="rule" hidden="false" publicationId="d7c9-7773-4408-58f6" page="71–74" />
        <infoLink id="c6d6-0c09-ad18-16a3" name="Flying high" targetId="99d7-0426-702a-003b" type="rule" hidden="false" publicationId="d7c9-7773-4408-58f6" page="73–74" />
        <infoLink id="2cf2-7734-53af-474f" name="Ridden monsters and rider loss" targetId="70ef-ea27-1ae3-36d7" type="rule" hidden="false" publicationId="d7c9-7773-4408-58f6" page="68–70" />
        <infoLink id="72f6-4643-e5f0-913d" name="General" targetId="d1ba-1b25-c83e-0e46" type="rule" hidden="false" publicationId="d7c9-7773-4408-58f6" page="88" />
        <infoLink id="5ad0-6132-da44-7fe7" name="Magic phase and Winds of Magic" targetId="51af-8134-e1d0-5c8f" type="rule" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="9–12" />
        <infoLink id="df3c-5fa3-e0ee-2450" name="Counter magic and natural dispels" targetId="a2e7-268a-edde-1495" type="rule" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="10–14" />
        <infoLink id="f4bc-5f0a-f329-20fc" name="Winds of Magic special cards" targetId="0d22-3d38-e047-8557" type="rule" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="9–10" />
        <infoLink id="91d8-6e80-592a-c40f" name="Spells remaining in play" targetId="b403-7328-b3ca-4dd7" type="rule" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="11–14" />
        <infoLink id="122a-a4a3-d951-1dfb" name="Spell targets, sight and templates" targetId="34de-d976-f1cf-5402" type="rule" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="12, 22" />
      </infoLinks>
      <selectionEntryGroups>
        <selectionEntryGroup id="dbe3-c8fc-e3be-7c4d" name="Magic lore" hidden="false" collective="false" import="true" defaultSelectionEntryId="6ab8-4c3d-b498-31ff">
          <constraints>
            <constraint id="0083-afc2-a7f5-1dc1" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
            <constraint id="fddc-4da0-fc46-9676" type="min" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <selectionEntries>
            <selectionEntry id="6ab8-4c3d-b498-31ff" name="Necromantic Magic" type="upgrade" hidden="false" collective="false" import="true">
              <costs>
                <cost name="pts" typeId="0044-15f1-782b-00ea" value="0" />
              </costs>
              <constraints>
                <constraint id="1ea7-d37f-4214-1004" type="max" value="1" scope="parent" field="selections" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" />
              </constraints>
              <infoLinks>
                <infoLink id="4369-98fc-2423-7e63" name="Necromancy and recasting" targetId="369a-00ed-fa25-3a9d" type="rule" hidden="false" publicationId="c115-e636-a63a-a216" page="31" />
              </infoLinks>
              <profiles>
                <profile id="8002-3a50-8b40-6172" name="Drain Life" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="26">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Necromantic Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">2</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">2D6-inch radius</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">Living models in the rolled radius suffer S3 hits with no armour saves. Use wounds inflicted to restore the caster's lost wounds, up to his starting total. Undead, Daemons and objects are unaffected. Characters cannot use Look Out Sir; hit living crew/components of composite models.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 26</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">Reference deck; not automatically known</characteristic>
                  </characteristics>
                </profile>
                <profile id="15c4-ad7f-1464-70d4" name="Gaze of Nagash" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="26">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Necromantic Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">2</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">18 inches</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">The first unit in its path suffers 2D6 S4 hits with no armour saves.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 26</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">Reference deck; not automatically known</characteristic>
                  </characteristics>
                </profile>
                <profile id="63dc-eed2-0a3a-1b3a" name="Hand of Dust" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="26">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Necromantic Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">2</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">Base contact</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">Both caster and one melee opponent roll D6 plus Strength; double the caster's total. Each point by which the caster wins inflicts one wound with no armour save. A slain victim becomes a friendly Wight, or a Wraith if it was a wizard.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 26</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">Reference deck; not automatically known</characteristic>
                  </characteristics>
                </profile>
                <profile id="8738-050a-9bb3-59e8" name="The Dark Mist" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="26">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Necromantic Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">1</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">Caster</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">Move up to 24 inches in your movement phase, through terrain and buildings but not living models. Cannot make melee attacks; may cast spells. Only magical weapons and spells can harm the caster. Combat-result defeat is still possible and fleeing ends the effect (Vampire Counts p. 31).</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Remains in play</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 26</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">Reference deck; not automatically known</characteristic>
                  </characteristics>
                </profile>
                <profile id="8dc3-cd84-7a7a-7414" name="Raise the Dead" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="26">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Necromantic Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">2</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">24 inches</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">Raise 2D6 Skeletons or Zombies into an existing unit of that type in range, or make a new unit if at least five are raised. Apply the equipment and victory-point rules in Vampire Counts p. 31.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 26</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">Reference deck; not automatically known</characteristic>
                  </characteristics>
                </profile>
                <profile id="acb2-59a8-93ed-9794" name="Summon Skeletons" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="26">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Necromantic Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">1</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">18 inches</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">Raise D6 Skeletons or Zombies into an existing unit of that type in range, or make a new unit if at least five are raised. Apply Vampire Counts p. 31 for equipment and victory points.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 26</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">Reference deck; not automatically known</characteristic>
                  </characteristics>
                </profile>
                <profile id="a112-cddb-b56c-fc14" name="Summon Undead Horde" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="26">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Necromantic Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">3</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">36 inches</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">Raise 3D6 Skeletons or Zombies into an existing unit of that type in range, or make a new unit if at least five are raised. Apply Vampire Counts p. 31 for equipment and victory points.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 26</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">Reference deck; not automatically known</characteristic>
                  </characteristics>
                </profile>
                <profile id="c658-629f-a808-a347" name="The Curse of Years" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="26">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Necromantic Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">3</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">24 inches</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">Roll per model in the target unit: 5+ kills it outright. At each later Undead magic phase improve the threshold by one (4+, then 3+, etc.). No armour or wound-based saves. Characters test too, without Look Out Sir; roll once for an entire composite model.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Remains in play</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 26</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">Reference deck; not automatically known</characteristic>
                  </characteristics>
                </profile>
                <profile id="8598-33d8-9c3b-6e42" name="Vanhel’s Danse Macabre" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="26">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Necromantic Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">1</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">36 inches</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">One eligible regiment may charge, move, march, fight one round or shoot during the magic phase. For Vampire Counts use the updated p. 31 eligibility: Skeletons, Zombies, Wights (including mounted Wights and Lords), and Wraiths only.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Resolve as described</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 26</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">Reference deck; not automatically known</characteristic>
                  </characteristics>
                </profile>
                <profile id="3072-44ee-1094-978e" name="Wind of Death" typeId="9449-4f21-0583-ddfa" typeName="Spell" hidden="false" publicationId="7f78-0cdc-b6a0-484e" page="26">
                  <characteristics>
                    <characteristic name="Lore" typeId="d783-9c87-2677-5247">Necromantic Magic</characteristic>
                    <characteristic name="Power" typeId="4906-4226-3bc0-8c0f">3</characteristic>
                    <characteristic name="Range" typeId="6f86-de4c-df8c-d65e">From any table edge</characteristic>
                    <characteristic name="Effect" typeId="d107-f119-4175-3647">Place its template at any table edge. Move 2D10 inches immediately, and the same direction at the start of later magic phases. Each model passed over suffers D6 wounds on 4+, with no armour saves.</characteristic>
                    <characteristic name="Duration" typeId="bcd5-9122-20dc-efc3">Remains in play</characteristic>
                    <characteristic name="Reference" typeId="3d00-247e-9cd5-be21">Warhammer Magic, printed p. 26</characteristic>
                    <characteristic name="Coverage" typeId="a8d4-be7a-bb66-130e">Reference deck; not automatically known</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
      </selectionEntryGroups>
